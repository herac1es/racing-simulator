                                "JSExt": 4,
                                "Interpreter": 1,
                                "Expression": "const csp300_WheelsRotaryEffect = $prop('ConspitLEDs.WheelCustomMenuEffectRotary3');\r\nconst csp300_RotaryDisplayStyle = $prop('ConspitLEDs.WheelRotaryDisplayStyle3') ?? 0; // 0 = Single LED, 1 = Fill to current value\r\n\r\nconst themes = {\r\n\t// Custom\r\n\t'0': { ActiveColourRotary: [$prop('ConspitLEDs.WheelCustomMenuActiveColourRotary3') ?? '#FFFF0000']},\r\n\t// CSP\r\n\t'1': { ActiveColourRotary: ['#FFFF0000']},\r\n\t// Racing\r\n\t'2': { ActiveColourRotary: ['#FFFF0000']},\r\n\t// White\r\n\t'10': { ActiveColourRotary: ['#FFFF0000']},\r\n\t// Arctic\r\n\t'11': { ActiveColourRotary: ['#FF0000FF']},\r\n\t// Sunset\r\n\t'12': { ActiveColourRotary: ['#FFFF0000']},\r\n\t// Rainbow\r\n\t'13': { ActiveColourRotary: ['#FFFF1493']},\r\n\t// Citrus\r\n\t'14': { ActiveColourRotary: ['#FF00FF00']},\r\n\t// Tokyo\r\n\t'15': { ActiveColourRotary: ['#FFFF1493']},\r\n\t// Gulf Oil\r\n\t'16': { ActiveColourRotary: ['#FFFF4500']},\r\n\t// Default\r\n\t'default': {ActiveColourRotary: ['#FFFFFFFF']}\r\n};\r\n\r\n// Apply Theme\r\nlet themeSettings;\r\nlet currentThemeId;\r\n\r\nif ($prop('ConspitLEDs.UniversalTheme') == true) {\r\n\tcurrentThemeId = $prop('ConspitLEDs.UniversalThemeMenuColour');\r\n\tthemeSettings = themes[currentThemeId] || themes['default'];\r\n} else {\r\n\tcurrentThemeId = $prop('ConspitLEDs.WheelMenuColour');\r\n\tthemeSettings = themes[currentThemeId] || themes['default'];\r\n};\r\n\r\nlet RotaryArray = Array(csp300_ledLength).fill(null);\r\nlet currentPosition = root.lastRotaryPosition;\r\n\r\nfor (const [button, leds] of Object.entries(buttonMap)) {\r\n\tif (getcontrollerbuttonstate(CONTROLLER_ID , Number(button))) {\r\n\t\tcurrentPosition = leds[0];\r\n\t\tbreak;\r\n\t}\r\n}\r\nroot.lastRotaryPosition = currentPosition;\r\n\r\nif (csp300_RotaryDisplayStyle == 0) {\r\n\tRotaryArray[currentPosition] = themeSettings.ActiveColourRotary[0];\r\n}\r\nif (csp300_RotaryDisplayStyle == 1) {\r\n\tfor (let i = 0; i <= currentPosition; i++) {\r\n\t\tRotaryArray[i] = themeSettings.ActiveColourRotary[0];\r\n\t}\r\n}\r\nreturn RotaryArray;",
                                "PreExpression": "const csp300_ledLength = 12;\r\nconst CONTROLLER_ID = '0x3514,0x000E';\r\nconst buttonMap = {\r\n\t60: [0], 61: [1], 62: [2], 63: [3], \r\n\t64: [4], 65: [5], 66: [6], 67: [7], \r\n\t68: [8], 69: [9], 70: [10], 71: [11]\r\n};"
                              },
                              "LedCount": 12,
                              "StartPosition": 33,
                              "ContainerType": "ScriptedContent",
                              "Description": "Rotary 3 Multi Positional Indicator"
                            }
