                                          "Description": ""
                                        }
                                      ],
                                      "ContainerType": "Groups.CustomConditionalGroup",
                                      "Description": "Pit Lane Animation"
                                    },
                                    {
                                      "ContentFormula": {
                                        "JSExt": 4,
                                        "Interpreter": 1,
                                        "Expression": "return cp300v3PitTop();",
                                        "PreExpression": "const csp300_ledLength = 12;"
                                      },
                                      "LedCount": 12,
                                      "ContainerType": "ScriptedContent",
                                      "Description": "Speed Limiter"
                                    },
                                    {
                                      "TriggerFormula": {
                                        "JSExt": 0,
                                        "Interpreter": 1,
                                        "Expression": "return ($prop('ConspitLEDs.TelemetryFunction') == 1 ||\r\n\t\t$prop('ConspitLEDs.TelemetryFunction') == 3 ||\r\n\t\t$prop('ConspitLEDs.TelemetryFunction') == null)\r\n\t\t&& $prop('IsInPit') == 0;"
                                      },
                                      "LedContainers": [
                                        {
                                          "BrightnessFormula": {
                                            "JSExt": 4,
                                            "Interpreter": 1,
                                            "Expression": "return csp300_brake_propertySelect();"
                                          },
                                          "LedContainers": [
                                            {
                                              "ContentFormula": {
                                                "JSExt": 4,
                                                "Interpreter": 1,
                                                "Expression": "const currentBrakeType = $prop('ConspitLEDs.BrakeType');\r\n\r\nif (currentBrakeType >= 2 && currentBrakeType <= 5) {\r\n\r\n\tUpdateGlobalColours.update();\r\n\tconst { csp300_Brake_Hex } = UpdateGlobalColours;\r\n\r\n\tconst currentBrakePressure = csp300_brake_propertySelect();\r\n\tconst ledsLit = Math.min(\r\n\t\tcsp300_brakeLedLength,\r\n\t\tMath.ceil((currentBrakePressure / 100) * csp300_brakeLedLength));\r\n\r\n\tconst halfLedsLit = ledsLit / 2;\r\n\tconst halfLength = csp300_brakeLedLength / 2;\r\n\r\n\tlet needsBlinking = false;\r\n\tlet blinkOutput = null;\r\n\tlet blinkThresholdLedCount = 0;\r\n\tlet blinkThresholdLedCountHalf = 0;\r\n\r\n\tconst csp300_BrakeForceBlink = $prop('ConspitLEDs.BrakeForceBlink') ?? 80;\r\n\tconst csp300_BrakeForceBlink2 = $prop('ConspitLEDs.BrakeForceBlink2') ?? 100;\r\n\tconst blinkThresholdPercent = csp300_BrakeForceBlink / 100;\r\n\r\n\tif (currentBrakePressure >= csp300_BrakeForceBlink && ledsLit > 0) {\r\n\t\tblinkThresholdLedCount = Math.floor(blinkThresholdPercent * csp300_brakeLedLength);\r\n\t\tblinkThresholdLedCountHalf = Math.floor(blinkThresholdPercent * halfLength);\r\n\t\t\r\n\t\t// Fix 100% blink threshold\r\n\t\tif (csp300_BrakeForceBlink == 100 && csp300_brakeLedLength > 0) {\r\n\t\t\tblinkThresholdLedCount = csp300_brakeLedLength - 1;\r\n\t\t\tblinkThresholdLedCountHalf = Math.ceil(halfLength) - 1;\r\n\t\t}\r\n\r\n\t\tneedsBlinking = currentBrakePressure >= csp300_BrakeForceBlink;\r\n\t\tif (needsBlinking) {\r\n\t\t\tconst blinkFreqSelect = currentBrakePressure >= csp300_BrakeForceBlink2\r\n\t\t\t\t? 75\r\n\t\t\t\t: 150;\r\n\t\t\tblinkOutput = Math.floor(Date.now() / blinkFreqSelect) % 2 == 0\r\n\t\t\t\t? csp300_Brake_Hex\r\n\t\t\t\t: null;\r\n\t\t}\r\n\t}\r\n\tconst BrakeArray = new Array(csp300_brakeLedLength).fill(null);\r\n\tconst applyBlink = (index) => {\r\n\t\tif (BrakeArray[index] !== null) BrakeArray[index] = blinkOutput;\r\n\t};\r\n\r\n\tswitch (currentBrakeType) {\r\n\t\tcase 2: // Left to Right\r\n\t\t\tfor (let i = 0; i < ledsLit; i++) {\r\n\t\t\t\tBrakeArray[i] = csp300_Brake_Hex;\r\n\t\t\t\tif (needsBlinking && i >= blinkThresholdLedCount) applyBlink(i);\r\n\t\t\t}\r\n\t\t\tbreak;\r\n\r\n\t\tcase 3: // Right to Left \r\n\t\t\tfor (let i = 0; i < ledsLit; i++) {\r\n\t\t\t\tconst pos = csp300_brakeLedLength - 1 - i;\r\n\t\t\t\tBrakeArray[pos] = csp300_Brake_Hex;\r\n\t\t\t\tif (needsBlinking && i >= blinkThresholdLedCount) applyBlink(pos);\r\n\t\t\t}\r\n\t\t\tbreak;\r\n\r\n\t\tcase 4: // Meet in Middle \r\n\t\t\tconst ledsPerSide = Math.ceil(halfLedsLit);\r\n\r\n\t\t\tfor (let i = 0; i < ledsPerSide; i++) {\r\n\t\t\t\tif (i >= halfLength) break;\r\n\r\n\t\t\t\t// Left side\r\n\t\t\t\tBrakeArray[i] = csp300_Brake_Hex;\r\n\t\t\t\tif (needsBlinking && i >= blinkThresholdLedCountHalf) applyBlink(i);\r\n\r\n\t\t\t\t// Right side\r\n\t\t\t\tconst rightPos = csp300_brakeLedLength - 1 - i;\r\n\r\n\t\t\t\tBrakeArray[rightPos] = csp300_Brake_Hex;\r\n\t\t\t\tif (needsBlinking && i >= blinkThresholdLedCountHalf) applyBlink(rightPos);\r\n\t\t\t}\r\n\t\t\tbreak;\r\n\r\n\t\tcase 5: // In to Out\r\n\t\t\tconst centerPos = (csp300_brakeLedLength - 1) / 2;\r\n\t\t\tconst isEven = csp300_brakeLedLength % 2 == 0;\r\n\r\n\t\t\tfor (let i = 0; i < csp300_brakeLedLength; i++) {\r\n\t\t\t\tconst distance = isEven \r\n\t\t\t\t\t? Math.abs(i - (halfLength - 0.5))\r\n\t\t\t\t\t: Math.abs(i - centerPos);\r\n\r\n\t\t\t\tif (distance < halfLedsLit) {\r\n\t\t\t\t\tBrakeArray[i] = csp300_Brake_Hex;\r\n\t\t\t\t\tif (needsBlinking && distance >= blinkThresholdLedCountHalf) applyBlink(i);\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t\tbreak;\r\n\t\t}\r\n\treturn BrakeArray;\r\n}\r\nreturn [null];",
                                                "PreExpression": "const csp300_brakeLedLength = 12;"
                                              },
                                              "LedCount": 12,
                                              "ContainerType": "ScriptedContent",
                                              "Description": "Brake Function Leds"
                                            }
