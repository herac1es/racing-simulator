                                        "Expression": "return $prop('CONSPITLEDS.TelemetryFuelType') == 2;"
                                      },
                                      "LedContainers": [
                                        {
                                          "UsePercent": true,
                                          "PercentMin": 0,
                                          "PercentMax": 100,
                                          "FuelMin": 0,
                                          "FuelMax": 60,
                                          "BlinkDelay": 250,
                                          "StartColor": "Red",
                                          "EndColor": "Lime",
                                          "LedCount": 12,
                                          "UseLedDimming": false,
                                          "FuelAlertLevelPercent": 5,
                                          "FuelAlertLevelLiters": 12,
                                          "ContainerType": "Fuel",
                                          "Description": ""
