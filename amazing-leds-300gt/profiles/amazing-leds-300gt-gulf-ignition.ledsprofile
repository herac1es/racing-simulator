                                      "Description": "Fuel Gradient"
                                    }
                                  ],
                                  "ContainerType": "Groups.CustomConditionalGroup",
                                  "Description": "Fuel Gauge Function"
                                },
                                {
                                  "LedContainers": [
                                    {
                                      "ContentFormula": {
                                        "JSExt": 4,
                                        "Interpreter": 1,
                                        "Expression": "if ($prop('ConspitLEDs.Clutch') ?? false) {\r\n\tUpdateGlobalColours.update();\r\n\tconst { csp300_Clutch_Hex } = UpdateGlobalColours;\r\n\tconst csp300_ClutchValue = Math.round(($prop('Clutch') / 100) * csp300_ledLength);\r\n\r\n\treturn Array(csp300_ledLength).fill(csp300_Clutch_Hex, 0, csp300_ClutchValue);\r\n}\r\nreturn [null];",
                                        "PreExpression": "const csp300_ledLength = 12;"
                                      },
                                      "LedCount": 12,
                                      "ContainerType": "ScriptedContent",
                                      "Description": "Clutch"
                                    },
                                    {
                                      "TriggerFormula": {
                                        "JSExt": 0,
                                        "Interpreter": 1,
                                        "Expression": "return ($prop('ConspitLEDs.PitLaneIndicator') ?? true) && $prop('IsInPitLane') == 1;"
                                      },
                                      "LedContainers": [
                                        {
                                          "Animation": {
                                            "Columns": 12,
                                            "Rows": 1,
                                            "Frames": [
                                              {
                                                "Colors": "0,0,#FFFF00;0,1,#000000;0,10,#000000;0,11,#FFFF00;0,2,Black;0,3,Black;0,4,Black;0,5,Black;0,6,Black;0,7,Black;0,8,Black;0,9,Black",
                                                "FrameDuration": 300
                                              },
                                              {
                                                "Colors": "0,0,Black;0,1,#FFFF00;0,10,#FFFF00;0,11,Black;0,2,Black;0,3,Black;0,4,Black;0,5,Black;0,6,Black;0,7,Black;0,8,Black;0,9,Black",
                                                "FrameDuration": 300
