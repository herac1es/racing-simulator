    {
      "ContainerType": "Groups.CustomConditionalGroup",
      "Description": "amazing-leds-300gt - Alerts, startup and wheel lighting",
      "TriggerFormula": {
        "JSExt": 4,
        "Interpreter": 1,
        "Expression": "return amazingGameAllowed();"
      },
      "LedContainers": [
        {
          "LedContainers": [
            {
              "LedContainers": [
                {
                  "TriggerFormula": {
                    "JSExt": 0,
                    "Interpreter": 1,
                    "Expression": "if ($prop('Spectating') == true) {\r\n\treturn ($prop('ConspitLEDs.SpectateShowTelemetry') == 1 ||\r\n\t\t\t$prop('ConspitLEDs.SpectateShowTelemetry') == null)\r\n}\r\nreturn true;"
                  },
                  "LedContainers": [
                    {
                      "BrightnessFormula": {
                        "JSExt": 4,
                        "Interpreter": 1,
                        "Expression": "let csp300_DeviceType = $prop('ConspitLEDs.NMTelemetry') ?? true;\r\n\r\nlet csp300_DeviceTypeBrightness = isnull($prop('ConspitLEDs.TelemetryBrightness'), 100) * isnull($prop('ConspitLEDs.GlobalBrightness'), 100) / 100;\r\n\r\nlet csp300_BrightnessOutput = Math.ceil(csp300_DeviceTypeBrightness);\r\nlet csp300_NightModeBrightnessOutput = Math.ceil(csp300_DeviceTypeBrightness * isnull($prop('ConspitLEDs.NightModeBrightness'), 25) / 100);\r\n\r\n\r\n;\r\n\r\n// Linked LD Behaviour\r\nif ($prop('ConspitLEDs.TDMDisplayDashboardBehaviour') ?? true) {\r\n\t\tif ($prop('DisplayPlugin.ld_NightMode') == true) NM_LD_Behaviour = true;\r\n\t\tif ($prop('DisplayPlugin.ld_NightMode') == false) return csp300_BrightnessOutput;\r\n}\r\nif ($prop('ConspitLEDs.TDMDisplayDashboardBehaviour') == false) NM_LD_Behaviour = false;\r\n\r\n// Fallback to own behavior when there is no LD connection\r\nNM_CSP_Behaviour = csp300_DeviceType;\r\n\r\nif (NM_LD_Behaviour || NM_CSP_Behaviour) {\r\n\r\nTDMState = NM_LD_Behaviour\r\n\t? $prop('DisplayPlugin.ld_TrueDarkModeState') ?? false\r\n\t: $prop('ConspitLEDs.TDMState') ?? false;\r\n\r\n\t\r\n\r\n\t\r\n\t\r\n\treturn TDMState == false\r\n\t\t? csp300_BrightnessOutput\r\n\t\t: csp300_NightModeBrightnessOutput; //All other games\r\n}\r\nreturn csp300_BrightnessOutput;"
                      },
                      "LedContainers": [
                        {
                          "TriggerFormula": {
                            "JSExt": 0,
                            "Interpreter": 1,
                            "Expression": "return $prop('EngineIgnitionOn') == 1 ||\r\n\ttrue && $prop('GameRawData.Telemetry.IsReplayPlaying') == true;"
                          },
                          "LedContainers": [
                            {
                              "TriggerFormula": {
                                "JSExt": 4,
                                "Interpreter": 1,
                                "Expression": "return true;"
                              },
                              "LedContainers": [
                                {
                                  "ContentFormula": {
                                    "JSExt": 4,
                                    "Interpreter": 1,
                                    "Expression": "if ($prop('CONSPITLEDS.TelemetryFunction') == 4) {\r\n\t// Brake\r\n\tconst csp300_BrakeValue = Math.round((csp300_brake_propertySelect() / 100) * (csp300_ledLength / 2));\r\n\tconst csp300_brakeArray = Array(Math.floor(csp300_ledLength / 2)).fill($prop('ConspitLEDs.BrakeColour') ?? '#FFFF0000', 0, csp300_BrakeValue).reverse();\r\n\r\n\t// Throttle\r\n\tconst csp300_ThrottleValue = Math.round(($prop('Throttle') / 100) * (csp300_ledLength / 2));\r\n\tconst csp300_throttleArray = Array(Math.floor(csp300_ledLength / 2)).fill($prop('ConspitLEDs.ThrottleColour') ?? '#FF00FF00', 0, csp300_ThrottleValue);\r\n\r\n\treturn csp300_ledLength % 2 != 0\r\n    \t? csp300_brakeArray.concat(['#FFFFFFFF'], csp300_throttleArray)\r\n    \t: csp300_brakeArray.concat(csp300_throttleArray);\r\n}\r\nreturn [null];",
                                    "PreExpression": "const csp300_ledLength = 12;"
                                  },
                                  "LedCount": 12,
                                  "ContainerType": "ScriptedContent",
                                  "Description": "Throttle/Brake Function"
                                },
                                {
                                  "TriggerFormula": {
                                    "JSExt": 0,
                                    "Interpreter": 1,
                                    "Expression": "return $prop('CONSPITLEDS.TelemetryFunction') == 5;"
                                  },
                                  "LedContainers": [
                                    {
                                      "TriggerFormula": {
                                        "JSExt": 0,
                                        "Interpreter": 1,
                                        "Expression": "return $prop('CONSPITLEDS.TelemetryFuelType') == 1 || $prop('CONSPITLEDS.TelemetryFuelType') == null;"
                                      },
                                      "LedContainers": [
