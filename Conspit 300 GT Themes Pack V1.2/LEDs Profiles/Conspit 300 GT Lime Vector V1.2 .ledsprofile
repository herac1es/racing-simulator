                                          ],
                                          "ContainerType": "Base.Group",
                                          "Description": "Le Mans Ultimate Car Specific RPMs"
                                        }
                                      ],
                                      "ContainerType": "Groups.CurrentGameGroup",
                                      "Description": "Le Mans Ultimate"
                                    }
                                  ],
                                  "ContainerType": "Groups.CustomConditionalGroup",
                                  "Description": "Specific Rpms"
                                },
                                {
                                  "TriggerFormula": {
                                    "JSExt": 4,
                                    "Interpreter": 1,
                                    "Expression": "return enableGenericRpms();"
                                  },
                                  "LedContainers": [
                                    {
                                      "ContentFormula": {
                                        "JSExt": 4,
                                        "Interpreter": 1,
                                        "Expression": "// Generates LED colour gradient with custom distribution of extra LEDs\r\nfunction applyGradient(colours, ledLength, colourCount, type, ratioPower = 1) {\r\n\t// 0 Colour return empty array\r\n\tif (ledLength <= 0 || colourCount <= 0) return [];\r\n\t// 1 colour fill entire array\r\n\tif (colourCount == 1) return Array(ledLength).fill(colours[0]);\r\n\r\n\t// No gradient\r\n\tif (type == 'noGradient') {\r\n\t\tconst baseLength = Math.floor(ledLength / colourCount);\r\n\t\tconst remainder = ledLength % colourCount;\r\n\t\tconst solidSegments = [];\r\n\r\n\t\tfor (let i = 0; i < colourCount; i++) {\r\n\t\t\tconst segmentLength = baseLength + (i < remainder ? 1 : 0);\r\n\t\t\tsolidSegments.push(...Array(segmentLength).fill(colours[i]));\r\n\t\t}\r\n\t\treturn solidSegments;\r\n\t}\r\n\r\n\t// Gradient\r\n\tconst gradientColours = [];\r\n\tconst segments = colourCount - 1;\r\n\tconst maxProgress = ledLength - 1;\r\n\r\n\tfor (let i = 0; i < ledLength; i++) {\r\n\t\tconst progress = (i / maxProgress) * segments;\r\n\t\tconst segment = Math.floor(progress);\r\n\r\n\t\t// Force linear interpolation for 3-colour gradients\r\n\t\tif (colourCount >= 3) ratioPower = 1;\r\n\r\n\t\t// Hyperbolic interpolation (linear when ratioPower = 1)\r\n\t\tconst ratio = Math.pow(progress % 1, ratioPower);\r\n\r\n\t\tconst startColour = colours[segment];\r\n\t\tconst endColour = colours[Math.min(segment + 1, segments)];\r\n\t\tgradientColours[i] = interpolateColour(startColour, endColour, ratio);\r\n\t}\r\n\treturn gradientColours;\r\n};\r\n\r\nconst themes = {\r\n\t// Custom\r\n\t'0': {\r\n\t\trpmsColours: \t[$prop('ConspitLEDs.RpmsCustomColour1'),\r\n\t\t\t\t\t\t$prop('ConspitLEDs.RpmsCustomColour2'),\r\n\t\t\t\t\t\t$prop('ConspitLEDs.RpmsCustomColour3')],\r\n\t\tredlineColours: [$prop('ConspitLEDs.RpmsCustomRedlineColour1'),\r\n\t\t\t\t\t\t$prop('ConspitLEDs.RpmsCustomRedlineColour2'),\r\n\t\t\t\t\t\t$prop('ConspitLEDs.RpmsCustomRedlineColour3')],\r\n\t\trpmsColourCount: $prop('ConspitLEDs.RpmsCustomNumColours'),\r\n\t\tredlineColourCount: $prop('ConspitLEDs.RpmsCustomNumRedlineColours'),\r\n\t\trpmsGradientType: $prop('ConspitLEDs.RpmsCustomGradient'),\r\n\t\tredlineGradientType: $prop('ConspitLEDs.RpmsCustomRedlineGradient')\r\n\t\t//gradientRatio: 1 // Only has effect for 2 colours active\r\n    },\r\n\t// CSP\r\n\t'1': {\r\n\t\trpmsColours: ['#FF0000FF', '#FF555555', '#FFFF0000'],\r\n\t\tredlineColours: ['#FF0000FF', '#FF555555', '#FFFF0000'],\r\n\t\trpmsColourCount: 3,\r\n\t\tredlineColourCount: 3,\r\n\t\trpmsGradientType: '', // Types: 'noGradient', default is gradient with ratio 1\r\n\t\tredlineGradientType: 'noGradient'\r\n    },\r\n\t// LD\r\n\t'2': {\r\n\t\trpmsColours: ['#FF00FF00', '#FFFFFF00', '#FFFF0000'],\r\n\t\tredlineColours: ['#FF0000FF'],\r\n\t\trpmsColourCount: 3,\r\n\t\tredlineColourCount: 1\r\n\t},\r\n\t// Red\r\n\t'3': {\r\n\t\trpmsColours: ['#FFFF0000', '#44FFFFFF'],\r\n\t\tredlineColours: ['#FFFF0000'],\r\n\t\trpmsColourCount: 2,\r\n\t\tredlineColourCount: 1,\r\n\t\tgradientRatio: 6\r\n\t},\r\n\t// Blue\r\n\t'4': {\r\n\t\trpmsColours: ['#FF0000FF', '#44FFFFFF'],\r\n\t\tredlineColours: ['#FF0000FF'],\r\n\t\trpmsColourCount: 2,\r\n\t\tredlineColourCount: 1,\r\n\t\tgradientRatio: 6\r\n\t},\r\n\t// Green\r\n\t'5': {\r\n\t\trpmsColours: ['#FF00FF00', '#44FFFFFF'],\r\n\t\tredlineColours: ['#FF00FF00'],\r\n\t\trpmsColourCount: 2,\r\n\t\tredlineColourCount: 1,\r\n\t\tgradientRatio: 6\r\n\t},\r\n\t// Yellow\r\n\t'6': {\r\n\t\trpmsColours: ['#FFFFFF00', '#44FFFFFF'],\r\n\t\tredlineColours: ['#FFFFFF00'],\r\n\t\trpmsColourCount: 2,\r\n\t\tredlineColourCount: 1,\r\n\t\tgradientRatio: 6\r\n\t},\r\n\t// Orange\r\n\t'7': {\r\n\t\trpmsColours: ['#FFFF8C00', '#44FFFFFF'],\r\n\t\tredlineColours: ['#FFFF8C00'],\r\n\t\trpmsColourCount: 2,\r\n\t\tredlineColourCount: 1,\r\n\t\tgradientRatio: 6\r\n\t},\r\n\t// Purple\r\n\t'8': {\r\n\t\trpmsColours: ['#FF4B0082', '#44FFFFFF'],\r\n\t\tredlineColours: ['#FF4B0082'],\r\n\t\trpmsColourCount: 2,\r\n\t\tredlineColourCount: 1,\r\n\t\tgradientRatio: 6\r\n\t},\r\n\t// Pink\r\n\t'9': {\r\n\t\trpmsColours: ['#FFFF1493', '#44FFFFFF'],\r\n\t\tredlineColours: ['#FFFF1493'],\r\n\t\trpmsColourCount: 2,\r\n\t\tredlineColourCount: 1,\r\n\t\tgradientRatio: 6\r\n\t},\r\n\t// White\r\n\t'10': {\r\n\t\trpmsColours: ['#FFFFFFFF'],\r\n\t\tredlineColours: ['#FFFFFFFF'],\r\n\t\trpmsColourCount: 1,\r\n\t\tredlineColourCount: 1\r\n\t},\r\n\t// Arctic\r\n\t'11': {\r\n\t\trpmsColours: ['#FF0000FF', '#FF555555'],\r\n\t\tredlineColours: ['#FF555555', '#FF0000FF'],\r\n\t\trpmsColourCount: 2,\r\n\t\tredlineColourCount: 2\r\n\t},\r\n\t// Sunset\r\n\t'12': {\r\n\t\trpmsColours: ['#FFFFFF00', '#FFFF0000'],\r\n\t\tredlineColours: ['#FFFF0000', '#FFFFFF00'],\r\n\t\trpmsColourCount: 2,\r\n\t\tredlineColourCount: 2\r\n\t},\r\n\t// Rainbow\r\n\t'13': {\r\n\t\trpmsColours: ['#FFFF0000', '#FF00FF00', '#FF0000FF'],\r\n\t\tredlineColours: ['#FFFF0000', '#FF00FF00', '#FF0000FF'],\r\n\t\trpmsColourCount: 3,\r\n\t\tredlineColourCount: 3,\r\n\t\tredlineGradientType: 'noGradient'\r\n\t},\r\n\t// Citrus\r\n\t'14': {\r\n\t\trpmsColours: ['#FF008000', '#FFFFFF00'],\r\n\t\tredlineColours: ['#FFFFFF00', '#FF008000'],\r\n\t\trpmsColourCount: 2,\r\n\t\tredlineColourCount: 2\r\n\t},\r\n\t// Tokyo\r\n\t'15': {\r\n\t\trpmsColours: ['#FF00FFFF', '#FF0000FF', '#FFFF1493'],\r\n\t\tredlineColours: ['#FF00FFFF', '#FF0000FF', '#FFFF1493'],\r\n\t\trpmsColourCount: 3,\r\n\t\tredlineColourCount: 3,\r\n\t\tredlineGradientType: 'noGradient'\r\n\t},\r\n\t// Gulf Oil\r\n\t'16': {\r\n\t\trpmsColours: ['#FF00BFFF', '#FFFF4500'],\r\n\t\tredlineColours: ['#FFFF4500', '#FF00BFFF'],\r\n\t\trpmsColourCount: 2,\r\n\t\tredlineColourCount: 2,\r\n\t\tredlineGradientType: 'noGradient'\r\n\t},\r\n\t'default': {\r\n\t\trpmsColours: ['#FF00FF00', '#FFFFFF00', '#FFFF0000'],\r\n\t\tredlineColours: ['#FF0000FF'],\r\n\t\trpmsColourCount: 3,\r\n\t\tredlineColourCount: 1\r\n\t}\r\n};\r\n\r\n// Apply Theme\r\nlet themeSettings;\r\n\r\nif ($prop('ConspitLEDs.UniversalTheme') == true) {\r\n\tthemeSettings = themes[$prop('ConspitLEDs.UniversalThemeGameColour')];\r\n} else {\r\n\tthemeSettings = themes[$prop('ConspitLEDs.GenericRpmsColour')] || themes['default'];\r\n}\r\n\r\nconst actualRpmsColourCount = Math.min(\tthemeSettings.rpmsColourCount,\r\n\t\t\t\t\t\t\t\t\t\tthemeSettings.rpmsColours.length);\r\nconst actualRedlineColourCount = Math.min(\tthemeSettings.redlineColourCount,\r\n\t\t\t\t\t\t\t\t\t\t\tthemeSettings.redlineColours.length);\r\n\r\nconst halfLength = Math.ceil(csp300_ledLength / 2);\r\n\r\nconst rpmsLedColours = applyGradient(\tthemeSettings.rpmsColours,\r\n\t\t\t\t\t\t\t\t\t\t$prop('ConspitLEDs.GenericRpmsStyle') == 2\r\n\t\t\t\t\t\t\t\t\t\t\t? halfLength\r\n\t\t\t\t\t\t\t\t\t\t\t: csp300_ledLength,\r\n\t\t\t\t\t\t\t\t\t\tactualRpmsColourCount,\r\n\t\t\t\t\t\t\t\t\t\tthemeSettings.rpmsGradientType,\r\n\t\t\t\t\t\t\t\t\t\tthemeSettings.gradientRatio);\r\n\r\nconst redlineLedColours = applyGradient(themeSettings.redlineColours,\r\n\t\t\t\t\t\t\t\t\t\t$prop('ConspitLEDs.GenericRpmsStyle') == 2\r\n\t\t\t\t\t\t\t\t\t\t\t? halfLength\r\n  \t\t\t\t\t\t\t\t\t\t\t: csp300_ledLength,\r\n  \t\t\t\t\t\t\t\t\t\tactualRedlineColourCount,\r\n  \t\t\t\t\t\t\t\t\t\tthemeSettings.redlineGradientType,\r\n  \t\t\t\t\t\t\t\t\t\tthemeSettings.gradientRatio);\r\n\r\n// Initialize LED Grid\r\nconst csp300_RpmsGrid = Array(csp300_ledLength).fill(null);\r\n\r\nconst currentRPM = $prop('Rpms');\r\nconst redlineRPM = csp300_RedlineValue();\r\nconst startRPM = csp300_RpmStartValue();\r\n\r\n//Treshold Values (%)\r\nconst startThreshold = startRPM != null  // Applies to Left to Right & Meet in the Middle\r\n\t? startRPM / redlineRPM\r\n\t: ($prop('ConspitLEDs.RpmsStartThreshold') ?? 85) / 100;\r\nconst F1_SECOND_SEGMENT_START = 0.9;\r\nconst F1_SECOND_SEGMENT_END = 0.96;\r\nconst F1_THIRD_SEGMENT_START = 1;\r\n\r\nconst isLastGear = $prop('Gear') == $prop('CarSettings_MaxGears');\r\nconst lastGearRedline = !((($prop('ConspitLEDs.LastGearRedline') ?? true) == false) && isLastGear);\r\nconst RedlineReached = lastGearRedline && currentRPM >= redlineRPM;\r\n\r\nif (currentRPM <= 0) return [null]; // Skip if no RPM\r\n\r\n// Left to Right\r\nif ($prop('ConspitLEDs.GenericRpmsStyle') == 1 || $prop('ConspitLEDs.GenericRpmsStyle') == null) {\r\n\r\n\tconst rpmStepSize = (1 - startThreshold) / csp300_ledLength;\r\n\r\n\tfor (let i = 0; i < csp300_ledLength; i++) {\r\n\t\tconst rpmThreshold = redlineRPM * (startThreshold + i * rpmStepSize);\r\n\r\n\t\tcsp300_RpmsGrid[i] = (currentRPM >= rpmThreshold)\r\n\t\t\t? RedlineReached\r\n\t\t\t\t? redlineLedColours[i]\r\n\t\t\t\t: rpmsLedColours[i]\r\n\t\t\t: null;\r\n    }\r\n}\r\n\r\n// Meet in the Middle\r\nelse if ($prop('ConspitLEDs.GenericRpmsStyle') == 2) {\r\n\r\n\tconst rpmStepSize = (1 - startThreshold) / halfLength;\r\n\r\n\tfor (let i = 0; i < halfLength; i++) {\r\n\t\tconst rpmThreshold = redlineRPM * (startThreshold + i * rpmStepSize);\r\n\t\tconst oppositeIndex = csp300_ledLength - 1 - i;\r\n\r\n\t\t// If RPM is below the threshold, break early\r\n\t\tif (currentRPM < rpmThreshold) break;\r\n\r\n    \tcsp300_RpmsGrid[i] = csp300_RpmsGrid[oppositeIndex] = (RedlineReached\r\n    \t\t\t\t\t\t\t\t\t\t\t\t\t\t? redlineLedColours[i]\r\n    \t\t\t\t\t\t\t\t\t\t\t\t\t\t: rpmsLedColours[i]);\r\n\t}\r\n\r\n\t// Handle the middle LED if the length is odd\r\n\tif (csp300_ledLength % 2 !== 0) {\r\n\t\tconst middleIndex = Math.floor(csp300_ledLength / 2);\r\n\t\tconst middleThreshold = redlineRPM * (startThreshold + (halfLength - 1) * rpmStepSize);\r\n\t\t\r\n\t\tcsp300_RpmsGrid[middleIndex] = currentRPM >= middleThreshold\r\n\t\t\t? RedlineReached\r\n\t\t\t\t? redlineLedColours[halfLength - 1]\r\n\t\t\t\t: rpmsLedColours[halfLength - 1]\r\n\t\t\t: null;\r\n\t}\r\n}\r\n\r\n// F1 style\r\nelse if ($prop('ConspitLEDs.GenericRpmsStyle') == 3) {\r\n\r\n\t//First Segment\r\n\tconst unusedLeds = Math.floor(csp300_ledLength / 3)\r\n\r\n\t//Second Segment\r\n\tconst secondSegmentSize = Math.ceil((csp300_ledLength - unusedLeds) / 2);\r\n\tconst secondSegmentStart = redlineRPM * F1_SECOND_SEGMENT_START;\r\n\tconst secondSegmentEnd = redlineRPM * F1_SECOND_SEGMENT_END;\r\n\tconst rpmStepSize = (secondSegmentEnd - secondSegmentStart) / (secondSegmentSize - 1);\r\n\r\n\t// Third Segment\r\n\tconst thirdSegmentStart = redlineRPM * F1_THIRD_SEGMENT_START;\r\n\r\n\t// LD theme activation\r\n\tconst LDColourActivation = themeSettings == themes['2'];\r\n\r\n\tconst secondSegmentColour = LDColourActivation\r\n\t\t? '#FFFF0000'\r\n\t\t: rpmsLedColours[0];\r\n\tconst thirdSegmentColour = LDColourActivation\r\n\t\t? '#FF0000FF'\r\n\t\t: rpmsLedColours[rpmsLedColours.length - 1];\r\n\r\n\tfor (let i = 0; i < csp300_ledLength; i++) {\r\n\t\t// First segment LEDs\r\n\t\tif (i < unusedLeds) {\r\n\t\t\tcsp300_RpmsGrid[i] = null;\r\n\t\t}\r\n\r\n\t\t// Second segment LEDs\r\n\t\telse if (i < unusedLeds + secondSegmentSize) {\r\n\t\t\tconst secondSegmentIndex  = i - unusedLeds;\r\n\t\t\tconst rpmThreshold = secondSegmentStart + secondSegmentIndex * rpmStepSize;\r\n\t\t\t\r\n\t\t\tcsp300_RpmsGrid[i] = currentRPM >= rpmThreshold\r\n\t\t\t\t? secondSegmentColour\r\n\t\t\t\t: null;\r\n\t\t}\r\n\r\n\t\t// Third segment LEDs\r\n\t\telse {\r\n\t\t\tcsp300_RpmsGrid[i] = currentRPM >= thirdSegmentStart\r\n\t\t\t\t? thirdSegmentColour\r\n\t\t\t\t: null;\r\n    \t}\r\n\t}\r\n};\r\n\r\nreturn RedlineReached && $prop('ConspitLEDs.GenericRpmsStyle') != 3\r\n\t? ($prop('ConspitLEDs.GenericRpmsRedlineBehaviour') == 2 ||\r\n\t   $prop('ConspitLEDs.GenericRpmsRedlineBehaviour') == null)\r\n\t\t\t? Math.floor(Date.now() / 125) % 2\r\n\t\t\t\t? csp300_RpmsGrid\r\n\t\t\t\t: Array(csp300_ledLength).fill(null)\r\n\t\t\t: csp300_RpmsGrid\r\n\t: csp300_RpmsGrid;",
                                        "PreExpression": "const csp300_ledLength = 12;"
                                      },
