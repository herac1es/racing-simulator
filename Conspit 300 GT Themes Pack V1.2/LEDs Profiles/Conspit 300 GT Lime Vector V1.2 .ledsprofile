= csp300_car.redline[$prop('Gear')] ?? csp300_car.redline['ALL'];\n\n\t// If no specific gear redline or 'ALL' redline exists, don't show redline\n\tif (redlineValue == undefined) return false;\n\n\t// Return redline state from dataset\n\treturn csp300_lastGearRedline && $prop('Rpms') >= redlineValue;\n};\n\n\nfunction csp300_RedlineValue() {\n\tconst csp300_car = csp300_SelectCarRedline();\n\n\t// Fall back to SimHub redline when the car is not listed or redline object is empty (no redline) or CSP redlines data option is disabled\n\tif (!csp300_car || Object.keys(csp300_car.redline).length == 0 || ($prop('ConspitLEDs.UseCSPRedlineValue') ?? 1) == 0) {\n\t\t return $prop('DataCorePlugin.CurrentGame') == 'ProjectMotorRacing'\n\t\t\t? $prop('CarSettings_CurrentGearRedLineRPM') //CarSettings_RedLineRPM doen't give absolute value for PMR\n\t\t\t: $prop('CarSettings_RedLineRPM');\n\t}\n\n\t// Apply CSP redline value\n\tconst redlineValue = csp300_car.redline[$prop('Gear')] ?? csp300_car.redline['ALL'];\n\n\t// Return the redline value or null if undefined\n\treturn redlineValue ?? $prop('CarSettings_RedLineRPM');\n};\n\n\nfunction csp300_RpmStartValue() {\n\tif ($prop('DataCorePlugin.CurrentGame') == 'EAWRC23') {\n\t\treturn Math.min(\n\t\t\t$prop('GameRawData.SessionUpdate.shiftlights_rpm_start'),\n\t\t\tcsp300_RedlineValue() * 0.9);\n\t}\n\t//iRacing excluded because doesn't work for cars with gear dependent redline/rpmstart values\n\t//if ($prop('DataCorePlugin.CurrentGame') == 'IRacing') {\n\t//\treturn $prop('GameRawData.Telemetry.PlayerCarSLFirstRPM');\n\t//}\n};\n\n\nclass EffectExecutor {\n\t\tconstructor(isTDM, csp300_ledLength, csp300_buttonState, csp300_Press_Hex, csp300_Press_Delay, csp300_Toggle_Hex, csp300_Toggle_Blink, csp300_Toggle_BlinkFrequency) {\n\n\t\tthis.isTDM = isTDM;\n\t\tthis.csp300_ledLength = csp300_ledLength;\n\t\tthis.csp300_buttonState = csp300_buttonState;\n\t\tthis.csp300_Press_Hex = csp300_Press_Hex;\n\t\tthis.csp300_Press_Delay = csp300