                                            },
                                            {
                                              "IdleColor": "Transparent",
                                              "IdleBlinkingColor": "Transparent",
                                              "EnableIdleBlinking": false,
                                              "LedCount": 1,
                                              "Color": "Green",
                                              "BlinkingColor": "Transparent",
                                              "BlinkEnabled": false,
                                              "BlinkDelay": 150,
                                              "ContainerType": "Status.DrsAvailable"
                                            },
                                            {
                                              "IdleColor": "Transparent",
                                              "IdleBlinkingColor": "Transparent",
                                              "EnableIdleBlinking": false,
                                              "LedCount": 2,
                                              "Color": "Green",
                                              "BlinkingColor": "Transparent",
                                              "BlinkEnabled": false,
                                              "ContainerType": "Status.DrsOn"
                                            }
                                          ],
                                          "ContainerType": "Groups.CustomConditionalGroup",
                                          "Description": "DRS Formula 1 Style"
                                        }
                                      ],
                                      "ContainerType": "Base.Group",
                                      "Description": "DRS Group"
                                    }
                                  ],
                                  "ContainerType": "Groups.CustomConditionalGroup",
                                  "Description": "Generic Rpms"
                                }
                              ],
                              "ContainerType": "Groups.CustomConditionalGroup",
                              "Description": "Rpms Function"
                            },
                            {
                              "ContentFormula": {
                                "JSExt": 4,
                                "Interpreter": 1,
                                "Expression": "if ($prop('CONSPITLEDS.TelemetryFunction') == 4) {\r\n\t// Brake\r\n\tconst csp300_BrakeValue = Math.round((csp300_brake_propertySelect() / 100) * (csp300_ledLength / 2));\r\n\tconst csp300_brakeArray = Array(Math.floor(csp300_ledLength / 2)).fill(csp300_TDM_Colour_Hex('alt'), 0, csp300_BrakeValue).reverse();\r\n\r\n\t// Throttle\r\n\tconst csp300_ThrottleValue = Math.round(($prop('Throttle') / 100) * (csp300_ledLength / 2));\r\n\tconst csp300_throttleArray = Array(Math.floor(csp300_ledLength / 2)).fill(csp300_TDM_Colour_Hex('main'), 0, csp300_ThrottleValue);\r\n\r\n\treturn csp300_ledLength % 2 != 0\r\n    \t? csp300_brakeArray.concat(['#FFFFFFFF'], csp300_throttleArray)\r\n    \t: csp300_brakeArray.concat(csp300_throttleArray);\r\n}\r\nreturn [null];",
                                "PreExpression": "const csp300_ledLength = 12;"
                              },
                              "LedCount": 12,
                              "ContainerType": "ScriptedContent",
                              "Description": "Throttle/Brake Function"
                            },
                            {
                              "ContentFormula": {
                                "JSExt": 4,
                                "Interpreter": 1,
                                "Expression": "if ($prop('CONSPITLEDS.TelemetryFunction') == 5) {\r\n\tconst csp300_FuelValue = Math.ceil(($prop('FuelPercent') / 100) * csp300_ledLength);\r\n\tconst csp300_FuelArray = Array(csp300_ledLength).fill(csp300_TDM_Colour_Hex('main'), 0, csp300_FuelValue);\r\n\r\n\treturn $prop('FuelPercent') > 5\r\n\t\t? csp300_FuelArray\r\n\t\t: Math.floor((Date.now() / 250) % 2)\r\n\t\t\t? csp300_FuelArray\r\n\t\t\t: Array(csp300_ledLength).fill(null);\r\n}\r\nreturn [null];",
                                "PreExpression": "const csp300_ledLength = 12;\r\n"
                              },
                              "LedCount": 12,
                              "ContainerType": "ScriptedContent",
                              "Description": "Fuel Gauge Function"
                            },
                            {
                              "LedContainers": [
                                {
                                  "ContentFormula": {
                                    "JSExt": 4,
                                    "Interpreter": 1,
                                    "Expression": "if ($prop('ConspitLEDs.Clutch') ?? false) {\r\n\tconst TDM_colour = csp300_TDM_Colour_Hex('alt');\r\n\tconst csp300_ClutchValue = Math.round(($prop('Clutch') / 100) * csp300_ledLength);\r\n\r\n\treturn Array(csp300_ledLength).fill(TDM_colour, 0, csp300_ClutchValue);\r\n}\r\nreturn [null];",
                                    "PreExpression": "const csp300_ledLength = 12;"
                                  },
                                  "LedCount": 12,
                                  "ContainerType": "ScriptedContent",
                                  "Description": "Clutch"
                                },
                                {
                                  "TriggerFormula": {
                                    "JSExt": 0,
                                    "Interpreter": 1,
                                    "Expression": "return ($prop('ConspitLEDs.PitLaneIndicator') ?? true) && $prop('IsInPitLane') == 1;"
                                  },
                                  "LedContainers": [
                                    {
                                      "Animation": {
                                        "Columns": 12,
                                        "Rows": 1,
                                        "Frames": [
                                          {
                                            "Colors": "0,0,#FFFF00;0,1,#000000;0,10,#000000;0,11,#FFFF00;0,2,Black;0,3,Black;0,4,Black;0,5,Black;0,6,Black;0,7,Black;0,8,Black;0,9,Black",
                                            "FrameDuration": 300
                                          },
                                          {
                                            "Colors": "0,0,Black;0,1,#FFFF00;0,10,#FFFF00;0,11,Black;0,2,Black;0,3,Black;0,4,Black;0,5,Black;0,6,Black;0,7,Black;0,8,Black;0,9,Black",
                                            "FrameDuration": 300
                                          }
                                        ],
                                        "PenColor": "Black"
                                      },
                                      "ContainerType": "Animation"
                                    }
                                  ],
                                  "ContainerType": "Groups.CustomConditionalGroup",
                                  "Description": "Pit Lane Animation"
                                },
                                {
                                  "ContentFormula": {
                                    "JSExt": 4,
                                    "Interpreter": 1,
                                    "Expression": "return cp300v3PitTop();",
                                    "PreExpression": "const csp300_ledLength = 12;"
                                  },
                                  "LedCount": 12,
                                  "ContainerType": "ScriptedContent",
                                  "Description": "Speed Limiter"
                                },
                                {
                                  "TriggerFormula": {
                                    "JSExt": 0,
                                    "Interpreter": 1,
                                    "Expression": "return ($prop('ConspitLEDs.TelemetryFunction') == 1 ||\r\n\t\t$prop('ConspitLEDs.TelemetryFunction') == 3 ||\r\n\t\t$prop('ConspitLEDs.TelemetryFunction') == null)\r\n\t\t&& $prop('IsInPit') == 0;"
                                  },
                                  "LedContainers": [
                                    {
                                      "BrightnessFormula": {
                                        "JSExt": 4,
                                        "Interpreter": 1,
                                        "Expression": "return csp300_brake_propertySelect();"
                                      },
                                      "LedContainers": [
                                        {
                                          "ContentFormula": {
                                            "JSExt": 4,
                                            "Interpreter": 1,
                                            "Expression": "const currentBrakeType = $prop('ConspitLEDs.BrakeType');\r\n\r\nif (currentBrakeType >= 2 && currentBrakeType <= 5) {\r\n\r\n\tconst TDM_colour = csp300_TDM_Colour_Hex('alt');\r\n\r\n\tconst currentBrakePressure = csp300_brake_propertySelect();\r\n\tconst ledsLit = Math.min(\r\n\t\tcsp300_brakeLedLength,\r\n\t\tMath.ceil((currentBrakePressure / 100) * csp300_brakeLedLength));\r\n\r\n\tconst halfLedsLit = ledsLit / 2;\r\n\tconst halfLength = csp300_brakeLedLength / 2;\r\n\r\n\tlet needsBlinking = false;\r\n\tlet blinkOutput = null;\r\n\tlet blinkThresholdLedCount = 0;\r\n\tlet blinkThresholdLedCountHalf = 0;\r\n\r\n\tconst csp300_BrakeForceBlink = $prop('ConspitLEDs.BrakeForceBlink') ?? 80;\r\n\tconst csp300_BrakeForceBlink2 = $prop('ConspitLEDs.BrakeForceBlink2') ?? 100;\r\n\tconst blinkThresholdPercent = csp300_BrakeForceBlink / 100;\r\n\r\n\tif (currentBrakePressure >= csp300_BrakeForceBlink && ledsLit > 0) {\r\n\t\tblinkThresholdLedCount = Math.floor(blinkThresholdPercent * csp300_brakeLedLength);\r\n\t\tblinkThresholdLedCountHalf = Math.floor(blinkThresholdPercent * halfLength);\r\n\t\t\r\n\t\t// Fix 100% blink threshold\r\n\t\tif (csp300_BrakeForceBlink == 100 && csp300_brakeLedLength > 0) {\r\n\t\t\tblinkThresholdLedCount = csp300_brakeLedLength - 1;\r\n\t\t\tblinkThresholdLedCountHalf = Math.ceil(halfLength) - 1;\r\n\t\t}\r\n\r\n\t\tneedsBlinking = currentBrakePressure >= csp300_BrakeForceBlink;\r\n\t\tif (needsBlinking) {\r\n\t\t\tconst blinkFreqSelect = currentBrakePressure >= csp300_BrakeForceBlink2\r\n\t\t\t\t? 75\r\n\t\t\t\t: 150;\r\n\t\t\tblinkOutput = Math.floor(Date.now() / blinkFreqSelect) % 2 == 0\r\n\t\t\t\t? TDM_colour\r\n\t\t\t\t: null;\r\n\t\t}\r\n\t}\r\n\tconst BrakeArray = new Array(csp300_brakeLedLength).fill(null);\r\n\tconst applyBlink = (index) => {\r\n\t\tif (BrakeArray[index] !== null) BrakeArray[index] = blinkOutput;\r\n\t};\r\n\r\n\tswitch (currentBrakeType) {\r\n\t\tcase 2: // Left to Right\r\n\t\t\tfor (let i = 0; i < ledsLit; i++) {\r\n\t\t\t\tBrakeArray[i] = TDM_colour;\r\n\t\t\t\tif (needsBlinking && i >= blinkThresholdLedCount) applyBlink(i);\r\n\t\t\t}\r\n\t\t\tbreak;\r\n\r\n\t\tcase 3: // Right to Left \r\n\t\t\tfor (let i = 0; i < ledsLit; i++) {\r\n\t\t\t\tconst pos = csp300_brakeLedLength - 1 - i;\r\n\t\t\t\tBrakeArray[pos] = TDM_colour;\r\n\t\t\t\tif (needsBlinking && i >= blinkThresholdLedCount) applyBlink(pos);\r\n\t\t\t}\r\n\t\t\tbreak;\r\n\r\n\t\tcase 4: // Meet in Middle \r\n\t\t\tconst ledsPerSide = Math.ceil(halfLedsLit);\r\n\r\n\t\t\tfor (let i = 0; i < ledsPerSide; i++) {\r\n\t\t\t\tif (i >= halfLength) break;\r\n\r\n\t\t\t\t// Left side\r\n\t\t\t\tBrakeArray[i] = TDM_colour;\r\n\t\t\t\tif (needsBlinking && i >= blinkThresholdLedCountHalf) applyBlink(i);\r\n\r\n\t\t\t\t// Right side\r\n\t\t\t\tconst rightPos = csp300_brakeLedLength - 1 - i;\r\n\r\n\t\t\t\tBrakeArray[rightPos] = TDM_colour;\r\n\t\t\t\tif (needsBlinking && i >= blinkThresholdLedCountHalf) applyBlink(rightPos);\r\n\t\t\t}\r\n\t\t\tbreak;\r\n\r\n\t\tcase 5: // In to Out\r\n\t\t\tconst centerPos = (csp300_brakeLedLength - 1) / 2;\r\n\t\t\tconst isEven = csp300_brakeLedLength % 2 == 0;\r\n\r\n\t\t\tfor (let i = 0; i < csp300_brakeLedLength; i++) {\r\n\t\t\t\tconst distance = isEven \r\n\t\t\t\t\t? Math.abs(i - (halfLength - 0.5))\r\n\t\t\t\t\t: Math.abs(i - centerPos);\r\n\r\n\t\t\t\tif (distance < halfLedsLit) {\r\n\t\t\t\t\tBrakeArray[i] = TDM_colour;\r\n\t\t\t\t\tif (needsBlinking && distance >= blinkThresholdLedCountHalf) applyBlink(i);\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t\tbreak;\r\n\t\t}\r\n\treturn BrakeArray;\r\n}\r\nreturn [null];",
                                            "PreExpression": "const csp300_brakeLedLength = 12;"
                                          },
                                          "LedCount": 12,
                                          "ContainerType": "ScriptedContent",
                                          "Description": "Brake Function Leds"
                                        }
                                      ],
                                      "ContainerType": "Groups.BrightnessFormulaGroup"
                                    }
                                  ],
                                  "ContainerType": "Groups.CustomConditionalGroup",
                                  "Description": "Brake TDM"
                                }
                              ],
                              "ContainerType": "Base.Group",
                              "Description": "Generic Effects (Spotter, Pit Limiters etc) TDM"
                            }
