p300v290TopRedlineLayer() {\n    var leds = cp300v290SafeArray(12, cp300v290DeepBlack());\n    if (!cp300v290CanShowLiveRedline() || !cp300v290RedlineActive()) return cp300v290SafeArray(12, null);\n    var on = cp300v290RedlinePulse();\n    var col = cp300v290RedlineColour();\n    for (var i = 0; i < 12; i++) leds[i] = on ? col : cp300v290DeepBlack();\n    return leds;\n}\nfunction cp300v290TopRpmLayer() {\n    // Force black for inactive RPM slots so old physical RPM sections cannot bleed weird final LEDs through.\n    var src = null;\n    try { if (typeof cp300v22RpmTop === 'function') src = cp300v22RpmTop(); } catch(e0) {}\n    if (!src || !src.length) return cp300v290SafeArray(12, null);\n    var out = cp300v290SafeArray(12, cp300v290DeepBlack());\n    for (var i = 0; i < 12; i++) out[i] = (src[i] && src[i] !== 'null') ? src[i] : cp300v290DeepBlack();\n    return out;\n}\nfunction cp300v290ButtonRedlineLayer() {\n    var leds = cp300v290SafeArray(44, null);\n    if (!cp300v290CanShowLiveRedline() || !cp300v290RedlineActive()) return leds;\n    var on = cp300v290RedlinePulse();\n    var col = cp300v290RedlineColour();\n    for (var b = 0; b < 8; b++) leds[b] = on ? col : cp300v290DeepBlack();\n    return leds;\n}\n// Main top-bar override. Keeps startup, ignition, pit and idle behaviour, but makes redline match 290 GP.\nfunction cp300v22TopOverlay() {\n    try { if (typeof cp300v15ShouldForceIdle === 'function' && cp300v15ShouldForceIdle()) return cp300v15IdleTop(); } catch(e) {}\n    if (cp300v290CanShowLiveRedline() && cp300v290RedlineActive()) return cp300v290TopRedlineLayer();\n    try { var start = cp300v6StartupTop(); if (cp300v4AnyLit(start)) return start; } catch(e1) {}\n    try { var ign = cp300v6IgnitionTop(); if (cp300v4AnyLit(ign)) return ign; } catch(e2) {}\n    try { if (cp300v6PitActive()) return cp300v8PitTop(); } catch(e3) {}\n    try { if (cp300v6IdleActive()) return cp300v4IdleTop(12); } catch(e4) {}\n    try { if (cp300v6IgnitionOnlyActive()) return cp300v4StaticTop(0.58); } catch(e5) {}\n    return cp300v290TopRpmLayer();\n}\n// Compatibility overrides for older redline layers still present in the profile tree.\nfunction cp300v8RedlineColour() { return cp300v290RedlineColour(); }\nfunction cp300v8TopRedline() { return cp300v290TopRedlineLayer(); }\nfunction cp300v8WheelRedline() { return cp300v290ButtonRedlineLayer(); }\nfunction cp300v3RedlineState() { return cp300v290RedlineActive(); }\nfunction cp300v3RedlineWheel() { return cp300v290ButtonRedlineLayer(); }\nfunction csp300_RedlineState() { return cp300v290RedlineActive(); }\nfunction csp300_RedlineValue() { return cp300v290RedlineRpm(); }\n\n\n// ============================================================================\n// Targeted overlay patch only. Original 300 GT flags, spotter, TC/ABS, brake,\n// rotary-ring telemetry, launch, clutch and wheel-specific functions are retained.\n// ============================================================================\n\n// Crimson Frost: preserve the established 300 GT four-row layout, using pure\n// white and pure red. Other themes will be generated only after this core passes.\nCP300V3_THEME_NAME = 'Lime Vector';\nCP300V3_BTN1 = '#FF00D7C8';\nCP300V3_BTN2 = '#FF66FF00';\nCP300V3_BTN3 = '#FF00D7C8';\nCP300V3_BTN4 = '#FF66FF00';\nCP300V3_RING1 = '#FF66FF00';\nCP300V3_RING2 = '#FF00D7C8';\nCP300V3_RING3 = '#FF66FF00';\nCP300V3_ACCENT = '#FF00D7C8';\n\nvar C300V25 = C300V25 || {\n    pitKnown:false, pitLast:false, pitExitAt:0,\n    ignitionMode:'', ignitionAt:0,\n    buttons:{}, encoderPrev:{}, encoderLast:{}, encoderWaves:[],\n    lmuSignature:'', lmuKey:''\n};\n\nfunction c300v25Prop(name,fallback){\n    try{\n        var v=$prop(name);\n        if(v===undefined||v===null)return fallback;\n        if(typeof v==='string'){\n            var s=v.trim().toLowerCase();\n            if(s===''||s==='--'||s==='nan'||s==='null'||s==='undefined')return fallback;\n        }\n        return v;\n    }catch(e){return fallback;}\n}\nfunction c300v25Num(name,fallback){var n=Number(c300v25Prop(name,fallback));return isFinite(n)&&!isNaN(n)?n:fallback;}\nfunction c300v25Bool(name){var v=c300v25Prop(name,false);return v===true||v===1||String(v).toLowerCase()==='true'||String(v)==='1';}\nfunction c300v25Clamp(v,a,b){return Math.max(a,Math.min(b,Number(v)||0));}\nfunction c300v25Smooth(t){t=c300v25Clamp(t,0,1);return 0.5-0.5*Math.cos(Math.PI*t);}\nfunction c300v25Empty(n,fill){var a=[];for(var i=0;i<n;i++)a.push(fill===undefined?null:fill);return a;}\nfunction c300v25Blend(a,b,t){try{return cp300v4Blend(a,b,t);}catch(e){return b||a;}}\nfunction c300v25Dim(c,t){try{return cp300v4Dim(c,t);}catch(e){return c;}}\nfunction c300v25AnyLit(a){if(!a)return false;for(var i=0;i<a.length;i++)if(a[i]!==null&&a[i]!==undefined&&a[i]!=='#00000000')return true;return false;}\nfunction c300v25Game(){\n    try{if(typeof cp300v4GameRunning==='function')return cp300v4GameRunning();}catch(e){}\n    return c300v25Num('DataCorePlugin.GameRunning',c300v25Num('GameRunning',0))===1;\n}\nfunction c300v25ForceIdle(){\n    try{if(typeof cp300v15ShouldForceIdle==='function')return cp300v15ShouldForceIdle();}catch(e){}\n    return !c300v25Game();\n}\nfunction c300v25Ignition(){\n    try{if(typeof cp300v6IgnitionOn==='function')return cp300v6IgnitionOn();}catch(e){}\n    return c300v25Bool('EngineIgnitionOn')||c300v25Bool('EngineIgnition');\n}\nfunction c300v25Rpm(){return c300v25Num('Rpms',c300v25Num('RPMS',0));}\nfunction c300v25Engine(){\n    try{if(typeof cp300v6EngineStarted==='function'&&cp300v6EngineStarted())return true;}catch(e){}\n    return c300v25Bool('EngineStarted')||c300v25Bool('EngineRunning')||c300v25Bool('CarStarted')||c300v25Rpm()>450;\n}\nfunction c300v25Limiter(){return c300v25Bool('PitLimiterOn');}\nfunction c300v25InPit(){return c300v25Bool('IsInPitLane')||c300v25Bool('IsInPit')||c300v25Bool('DataCorePlugin.GameData.IsInPitLane');}\nfunction c300v25Speed(){return Math.abs(c300v25Num('SpeedKmh',c300v25Num('Speed',0)));}\nfunction c300v25PitLimit(){\n    var names=['PitSpeedLimit','PitLimiterSpeed','GameRawData.PitSpeedLimit','DataCorePlugin.GameData.NewData.PitSpeedLimit'];\n    for(var i=0;i<names.length;i++){var n=c300v25Num(names[i],0);if(n>1)return n;}\n    return 60;\n}\n\n// Pit ownership follows the finished 290 GP: limiter ON owns the pit animation.\n// Being in pit lane with limiter OFF leaves normal RPM and theme buttons alive.\ncp300v6PitActive=function(){return c300v25Limiter();};\n\nfunction c300v25UpdatePit(){\n    var pit=c300v25InPit(),now=Date.now();\n    if(!C300V25.pitKnown){C300V25.pitKnown=true;C300V25.pitLast=pit;}\n    else if(!pit&&C300V25.pitLast)C300V25.pitExitAt=now;\n    C300V25.pitLast=pit;\n}\n\n// ----- MAX 01 / 290 GP ignition language, adapted to 0/12/0 + 4/4 buttons -----\nfunction c300v25IgnitionProgress(){\n    var mode=c300v25Ignition()?'on':'off',now=Date.now();\n    if(C300V25.ignitionMode!==mode||!C300V25.ignitionAt){C300V25.ignitionMode=mode;C300V25.ignitionAt=now;}\n    var u=((now-C300V25.ignitionAt)%5600)/5600;\n    var ping=u<0.5?u*2:(1-u)*2;\n    return c300v25Smooth(ping);\n}\nfunction c300v25PaintPath(arr,path,cursor,baseColour){\n    for(var i=0;i<path.length;i++){\n        var dist=Math.abs(i-cursor),mix=0;\n        if(dist<=0.34)mix=1;\n        else if(dist<1.42)mix=((1.42-dist)/1.08)*0.68;\n        else if(dist<2.18)mix=((2.18-dist)/0.76)*0.18;\n        if(mix>0)arr[path[i]]=c300v25Blend(baseColour,'#FFFFFFFF',c300v25Clamp(mix,0,1));\n    }\n}\nfunction c300v25IgnitionTop(baseColour){\n    var out=c300v25Empty(12,baseColour),p=c300v25IgnitionProgress(),cursor=p*5;\n    c300v25PaintPath(out,[5,4,3,2,1,0],cursor,baseColour);\n    c300v25PaintPath(out,[6,7,8,9,10,11],cursor,baseColour);\n    return out;\n}\nfunction c300v25ThemeRings(out,strength){\n    var rings=cp300v4Rings();\n    for(var r=0;r<rings.length;r++)for(var j=0;j<12;j++)out[rings[r].start+j]=c300v25Dim(rings[r].colour,strength);\n    return out;\n}\nfunction c300v25IgnitionWheel(baseColour){\n    var out=c300v25Empty(44,null);\n    for(var b=0;b<8;b++)out[b]=baseColour;\n    c300v25ThemeRings(out,0.24);\n    var p=c300v25IgnitionProgress(),cursor=p*3;\n    c300v25PaintPath(out,[0,1,2,3],cursor,baseColour);\n    c300v25PaintPath(out,[4,5,6,7],cursor,baseColour);\n    return out;\n}\n\n// ----- Smooth synchronized pit limiter -----\nfunction c300v25PitSync(){\n    var u=(Date.now()%2640)/2640,ping=u<0.5?u*2:(1-u)*2;\n    return {u:u,progress:c300v25Smooth(ping),direction:u<0.5?1:-1};\n}\nfunction c300v25PitColour(distance){\n    var blue='#FF006CFF',cyan='#FF00FFE0',orange='#FFFF5A00',white='#FFFFFFFF';\n    var head=Math.max(0,1-distance/1.18),trail=Math.max(0,1-distance/2.85);\n    var col=c300v25Blend(blue,cyan,0.28+0.34*trail);\n    col=c300v25Blend(col,orange,Math.pow(head,0.78));\n    if(distance<0.34)col=c300v25Blend(col,white,(0.34-distance)/0.34*0.22);\n    var strength=Math.max(0.28,Math.min(1,0.28+0.38*trail+0.44*head));\n    return c300v25Dim(col,strength);\n}\nfunction c300v25PitTop(){\n    var out=c300v25Empty(12,c300v25Dim('#FF006CFF',0.30));\n    var cursor=c300v25PitSync().progress*5;\n    var left=[5,4,3,2,1,0],right=[6,7,8,9,10,11];\n    for(var i=0;i<6;i++){var c=c300v25PitColour(Math.abs(i-cursor));out[left[i]]=c;out[right[i]]=c;}\n    return out;\n}\nfunction c300v25PitWheel(){\n    var out=cp300v4StaticWheel(0.34),cursor=c300v25PitSync().progress*3;\n    var left=[0,1,2,3],right=[4,5,6,7];\n    for(var i=0;i<4;i++){var c=c300v25PitColour(Math.abs(i-cursor)*1.35);out[left[i]]=c;out[right[i]]=c;}\n    var rings=cp300v4Rings();\n    for(var r=0;r<rings.length;r++)for(var j=0;j<12;j++)out[rings[r].start+j]=c300v25Dim('#FF006CFF',0.20);\n    return out;\n}\nfunction c300v25PitExitSweep(base,age){\n    var duration=980,pos=(c300v25Clamp(age,0,duration)/duration)*15;\n    for(var i=0;i<12;i++){\n        var dist=Math.abs(i-pos);\n        if(dist<2.6){var s=c300v25Clamp(1-dist/2.6,0,1);base[i]=c300v25Blend(base[i]||'#FF000000',c300v25Dim('#FFFFFFFF',0.22+0.78*s),0.82);}\n    }\n    return base;\n}\nfunction c300v25PitWarningRings(base){\n    if(!c300v25InPit()||c300v25Limiter())return base;\n    var over=c300v25Speed()>c300v25PitLimit()+0.35,col=over?'#FFFF0000':'#FF00FF40';\n    var phase=Math.floor(Date.now()/110)%12,left=8,right=32;\n    for(var i=0;i<12;i++){\n        var d=Math.min(Math.abs(i-phase),12-Math.abs(i-phase));\n        var strength=d===0?1:(d===1?0.52:(d===2?0.18:0.06));\n        base[left+i]=c300v25Dim(col,strength);\n        base[right+i]=c300v25Dim(col,strength);\n    }\n    return base;\n}\n\n// ----- 290 GP button response: short press = three white breaths; hold = white breathing -----\nfunction c300v25ButtonRaw(id){try{return !!getcontrollerbuttonstate('0x3514,0x000E',id);}catch(e){return false;}}\nfunction c300v25Triple(age){if(age<0||age>=800)return null;var period=800/3,local=(age%period)/period,p=Math.sin(Math.PI*local);if(p<0.12)return '#FF000000';return c300v25Dim('#FFFFFFFF',0.34+0.66*p);}\nfunction c300v25Hold(held){var ph=((Math.max(0,held-260))%720)/720,b=0.5-0.5*Math.cos(2*Math.PI*ph);if(b<0.06)return '#FF000000';return c300v25Dim('#FFFFFFFF',0.20+0.80*b);}\nfunction c300v25ApplyButtons(base){\n    var now=Date.now();\n    for(var i=0;i<8;i++){\n        var down=c300v25ButtonRaw(i),s=C300V25.buttons[i];\n        if(!s){s={down:down,pressedAt:down?now:0,releasedAt:0,quick:false};C300V25.buttons[i]=s;}\n        if(down&&!s.down){s.pressedAt=now;s.releasedAt=0;s.quick=false;}\n        if(!down&&s.down){var held=Math.max(0,now-s.pressedAt);s.releasedAt=now;s.quick=held<430;}\n        s.down=down;\n        if(s.down){var heldNow=now-s.pressedAt;base[i]=heldNow<260?'#FFFFFFFF':c300v25Hold(heldNow);}\n        else if(s.quick&&s.releasedAt>0&&now-s.releasedAt<800){var f=c300v25Triple(now-s.releasedAt);if(f!==null)base[i]=f;}\n    }\n    return base;\n}\n\n// ----- Top and middle thumb encoders, same white smooth language as 290 GP -----\nfunction c300v25Pulse(id,key){\n    var now=Date.now(),live=c300v25ButtonRaw(id),old=!!C300V25.encoderPrev[key],native=false;\n    try{if(isincreasing(850,getcontrollerbuttonstate('0x3514,0x000E',id)))native=true;}catch(e){}\n    C300V25.encoderPrev[key]=live;\n    var last=Number(C300V25.encoderLast[key]||0),rise=(live&&!old)||native;\n    if(rise&&now-last>110){C300V25.encoderLast[key]=now;return true;}\n    return false;\n}\nfunction c300v25AnyPulse(ids,key){for(var i=0;i<ids.length;i++)if(c300v25Pulse(ids[i],key+'_'+ids[i]))return true;return false;}\nfunction c300v25EncoderStart(side,kind,direction){\n    var keep=[];for(var i=0;i<C300V25.encoderWaves.length;i++){var w=C300V25.encoderWaves[i];if(!(w.side===side&&w.kind===kind))keep.push(w);}\n    keep.push({side:side,kind:kind,direction:direction,at:Date.now()});C300V25.encoderWaves=keep;\n}\nfunction c300v25CaptureEncoders(){\n    // Existing stable 300 GT mappings, plus official remap families.\n    if(c300v25AnyPulse([13,9,72,76,80,84,88,92,96,100,104,108,112],'tl_a'))c300v25EncoderStart('left','top','down');\n    if(c300v25AnyPulse([12,15,8,73,77,81,85,89,93,97,101,105,109,113],'tl_b'))c300v25EncoderStart('left','top','up');\n    if(c300v25AnyPulse([10,74,78,82,86,90,94,98,102,106,110,114],'tr_a'))c300v25EncoderStart('right','top','down');\n    if(c300v25AnyPulse([11,14,75,79,83,87,91,95,99,103,107,111,115],'tr_b'))c300v25EncoderStart('right','top','up');\n    if(c300v25AnyPulse([16],'ml_d'))c300v25EncoderStart('left','middle','down');\n    if(c300v25AnyPulse([17],'ml_u'))c300v25EncoderStart('left','middle','up');\n    if(c300v25AnyPulse([18],'mr_d'))c300v25EncoderStart('right','middle','down');\n    if(c300v25AnyPulse([19],'mr_u'))c300v25EncoderStart('right','middle','up');\n}\nfunction c300v25Bell(distance,width){return Math.exp(-0.5*(distance*distance)/(width*width));}\nfunction c300v25Fade(age,duration){var a=c300v25Clamp(age/115,0,1),b=c300v25Clamp((duration-age)/150,0,1);return c300v25Smooth(Math.min(a,b));}\nfunction c300v25EncoderOrder(w){\n    if(w.kind==='top'){\n        if(w.side==='left')return w.direction==='up'?[1,0]:[0,1];\n        return w.direction==='up'?[5,4]:[4,5];\n    }\n    if(w.side==='left')return w.direction==='up'?[3,2,1,0]:[0,1,2,3];\n    return w.direction==='up'?[7,6,5,4]:[4,5,6,7];\n}\nfunction c300v25ApplyEncoders(base){\n    c300v25CaptureEncoders();var now=Date.now(),keep=[];\n    for(var w=0;w<C300V25.encoderWaves.length;w++){\n        var wave=C300V25.encoderWaves[w],age=now-wave.at,duration=wave.kind==='middle'?1040:680;\n        if(age>duration)continue;keep.push(wave);\n        var order=c300v25EncoderOrder(wave),x=c300v25Smooth(age/duration)*(order.length-1),env=c300v25Fade(age,duration);\n        for(var i=0;i<order.length;i++){\n            var dist=Math.abs(i-x),head=c300v25Bell(dist,0.64),trail=c300v25Bell(dist,1.18)*0.22,strength=c300v25Clamp((head+trail)*env,0,1);\n            if(strength>0.02)base[order[i]]=c300v25Blend(base[order[i]]||cp300v4ButtonThemeAt(order[i]),'#FFFFFFFF',strength);\n        }\n    }\n    C300V25.encoderWaves=keep;return base;\n}\n\n// ----- LMU model-first bridge: all years/liveries reuse the proven native matrix -----\nfunction c300v25Norm(v){return String(v===null||v===undefined?'':v).toLowerCase().replace(/&/g,' and ').replace(/[^a-z0-9]+/g,' ').replace(/\\s+/g,' ').trim();}\nfunction c300v25Has(t,a){for(var i=0;i<a.length;i++)if(t.indexOf(a[i])>=0)return true;return false;}\nfunction c300v25GameKey(){try{if(typeof cp300v22GameKey==='function')return cp300v22GameKey();}catch(e){}var g=String(c300v25Prop('DataCorePlugin.CurrentGame',''));return g.indexOf('LeMans')>=0?'LMU':g;}\nfunction c300v25LmuBundle(){\n    var keys=['CarModel','CarId','CarName','CarClass','CarCategory','DataCorePlugin.GameData.NewData.CarModel','DataCorePlugin.GameData.NewData.CarId','DataCorePlugin.GameData.NewData.CarName','DataCorePlugin.GameData.NewData.CarClass','GameRawData.VehicleName','GameRawData.CarName','GameRawData.CurrentPlayerVehicleName','GameRawData.CurrentPlayerCarName','GameRawData.Telemetry.PlayerCarName','GameRawData.Telemetry.PlayerCarModel','GameRawData.SessionUpdate.vehicleName','GameRawData.SessionUpdate.mVehicleName','GameRawData.CurrentPlayer.mVehicleName','GameRawData.CurrentPlayer.mVehicleClass','GameRawData.Scoring.mVehicleName','GameRawData.Scoring.mVehicleClass'];\n    var p=[];for(var i=0;i<keys.length;i++){var v=c300v25Prop(keys[i],'');if(v!==''&&v!==null&&v!==undefined)p.push(String(v));}\n    return c300v25Norm(p.join(' | '));\n}\nfunction c300v25LmuCanonical(){\n    if(c300v25GameKey()!=='LMU')return '';\n    var t=c300v25LmuBundle();if(C300V25.lmuSignature===t)return C300V25.lmuKey;var k='';\n    if(c300v25Has(t,['genesis gmr001','genesis gmr 001','gmr001']))k='genesis';\n    else if(c300v25Has(t,['alpine a424','a424']))k='alpine';\n    else if(c300v25Has(t,['aston martin valkyrie','valkyrie lmh']))k='valkyrie';\n    else if(c300v25Has(t,['bmw m hybrid v8','bmw m hybrid']))k='bmw_hyper';\n    else if(c300v25Has(t,['cadillac v series r','cadillac v series','vlmdh']))k='cadillac';\n    else if(c300v25Has(t,['ferrari 499p','499p']))k='ferrari499';\n    else if(c300v25Has(t,['peugeot 9x8','9x8']))k='peugeot';\n    else if(c300v25Has(t,['porsche 963','963 lmdh']))k='porsche963';\n    else if(c300v25Has(t,['toyota gr010','toyota tr010','gr010','tr010']))k='toyota';\n    else if(c300v25Has(t,['porsche 911 gt3 r','911 gt3 r','911gt3r','manthey dk engineering','the bend manthey']))k='porsche911';\n    else if(c300v25Has(t,['mercedes amg lmgt3','mercedes amg gt3','amg lmgt3','garage 59 by iron dames']))k='mercedes_gt3';\n    else if(c300v25Has(t,['mclaren 720s lmgt3 evo','mclaren 720s gt3 evo','720s lmgt3','garage 59']))k='mclaren';\n    else if(c300v25Has(t,['ford mustang lmgt3','ford mustang gt3','mustang lmgt3','proton competition']))k='ford';\n    else if(c300v25Has(t,['ferrari 296 lmgt3 evo','ferrari 296 gt3','296 lmgt3','vista af corse']))k='ferrari296';\n    else if(c300v25Has(t,['bmw m4 lmgt3','bmw m4 gt3','m4 lmgt3','team wrt']))k='bmw_m4';\n    else if(c300v25Has(t,['corvette z06 lmgt3 r','z06gt3r','tf sport','racing team turkey']))k='corvette';\n    else if(c300v25Has(t,['aston martin vantage amr lmgt3','vantage amr gt3','heart of racing']))k='aston_gt3';\n    else if(c300v25Has(t,['lexus rcf lmgt3','lexus rc f gt3','lexus rcf gt3','akkodis asp']))k='lexus';\n    else if(c300v25Has(t,['lamborghini huracan gt3 evo2','huracan gt3 evo2','huracan evo2']))k='huracan';\n    C300V25.lmuSignature=t;C300V25.lmuKey=k;return k;\n}\nvar C300V25_REP={\n    genesis:'Genesis Magma Racing 2026',alpine:'Alpine Endurance Team 2025',valkyrie:'Aston Martin THOR Team 2025',bmw_hyper:'BMW M Team WRT 2025',cadillac:'Cadillac WTR 2025',ferrari499:'Ferrari AF Corse 2025',peugeot:'Peugeot TotalEnergies 2025',porsche963:'Porsche Penske Motorsport 2025',toyota:'Toyota Gazoo Racing 2025',\n    porsche911:'Manthey Ema 2024',mercedes_gt3:'Mercedes AMG Custom Team 2025',mclaren:'United Autosports 2025',ford:'Mustang Custom Team 2025',ferrari296:'296GT3 Custom Team 2025',bmw_m4:'BMW GT3 Custom Team 2025',corvette:'Z06GT3R Custom Team 2025',aston_gt3:'Heart of Racing Team 2024',lexus:'Lexus Custom Team 2025',huracan:'Huracan Custom Team 2024'\n};\nfunction c300v25ProfileText(p){return c300v25Norm(JSON.stringify([p&&p.m,p&&p.i,p&&p.c]));}\nfunction c300v25FindRepresentative(arr,key){var needle=C300V25_REP[key];if(!needle||!arr)return null;needle=c300v25Norm(needle);for(var i=0;i<arr.length;i++){var p=arr[i];if(p.g==='LMU'&&c300v25ProfileText(p).indexOf(needle)>=0)return p;}return null;}\nvar c300v25BaseFindRpm=cp300v22FindExactRpmProfile;\nvar c300v25BaseFindRed=cp300v22FindExactRedlineProfile;\ncp300v22FindExactRpmProfile=function(){var key=c300v25LmuCanonical();if(key){var p=c300v25FindRepresentative(CP300V22_RPM_PROFILES,key);if(p)return p;}return c300v25BaseFindRpm();};\ncp300v22FindExactRedlineProfile=function(){var key=c300v25LmuCanonical();if(key){var p=c300v25FindRepresentative(CP300V22_REDLINE_PROFILES,key);if(p)return p;}return c300v25BaseFindRed();};\n\n// Restore exact matrix colours, segment widths and trigger RPM values from the\n// shared 290 GP database. Do not recolour exact car profiles with a generic ramp.\ncp300v22RenderExactRpm=function(count,profile){\n    var leds=c300v25Empty(count,null);if(!profile||!profile.seg)return leds;\n    var rpm=c300v25Rpm();if(rpm<=0)return leds;\n    var total=Number(profile.fw)||0;if(!total)for(var t=0;t<profile.seg.length;t++)total+=Math.max(1,Number(profile.seg[t][0])||1);\n    var offset=profile.sp?Math.max(0,Number(profile.sp)-1):0;if(offset+total>count)offset=Math.max(0,count-total);\n    var cursor=offset;\n    for(var s=0;s<profile.seg.length;s++){\n        var width=Math.max(1,Number(profile.seg[s][0])||1),threshold=Number(profile.seg[s][1])||0;\n        var colour;try{colour=cp300v22ExactColour(profile.seg[s][2]);}catch(e){colour=profile.seg[s][2];}\n        for(var w=0;w<width;w++){\n            if(cursor>=0&&cursor<count&&threshold>0&&rpm>=threshold&&colour&&colour!=='#FF000000'&&String(colour).toLowerCase()!=='transparent')leds[cursor]=colour;\n            cursor++;\n        }\n    }\n    return leds;\n};\n\n// ----- Final visible authorities -----\ncp300v22TopOverlay=function(){\n    c300v25UpdatePit();\n    if(c300v25ForceIdle())return cp300v4IdleTop(12);\n    try{var startup=cp300v6StartupTop();if(c300v25AnyLit(startup))return startup;}catch(e0){}\n    if(c300v25Game()&&!c300v25Engine())return c300v25Ignition()?c300v25IgnitionTop('#FFFFFF00'):c300v25IgnitionTop('#FFFF0000');\n    if(c300v25Game()&&c300v25Engine()&&c300v25Limiter())return c300v25PitTop();\n    if(typeof cp300v290CanShowLiveRedline==='function'&&cp300v290CanShowLiveRedline()&&cp300v290RedlineActive())return cp300v290TopRedlineLayer();\n    var out=cp300v290TopRpmLayer();\n    var age=C300V25.pitExitAt>0?Date.now()-C300V25.pitExitAt:999999;\n    if(age>=0&&age<1050)out=c300v25PitExitSweep(out,age);\n    return out;\n};\n\ncp300v1WheelOverlay=function(){\n    var leds;\n    if(c300v25ForceIdle())leds=cp300v4IdleWheel();\n    else{\n        var startup=null;try{startup=cp300v8StartupWheel();}catch(e0){}\n        if(c300v25AnyLit(startup))leds=startup;\n        else if(c300v25Game()&&!c300v25Engine())leds=c300v25Ignition()?c300v25IgnitionWheel('#FFFFFF00'):c300v25IgnitionWheel('#FFFF0000');\n        else if(c300v25Game()&&c300v25Engine()&&c300v25Limiter())leds=c300v25PitWheel();\n        else{\n            leds=cp300v14CoreWheelNoFlag();\n            try{var flag=cp300v13FlagColour();if(flag)leds=cp300v13PaintFlags(leds,flag);}catch(e1){}\n            leds=c300v25PitWarningRings(leds);\n        }\n    }\n    leds=c300v25ApplyButtons(leds);\n    leds=c300v25ApplyEncoders(leds);\n    return leds;\n};\ncp300v21WheelOverlay=function(){return cp300v1WheelOverlay();};\ncp300v20WheelOverlay=function(){return cp300v1WheelOverlay();};\ncp300v19WheelOverlay=function(){return cp300v1WheelOverlay();};\ncp300v18WheelOverlay=function(){return cp300v1WheelOverlay();};\ncp300v15WheelOverlay=function(){return cp300v1WheelOverlay();};\ncp300v14WheelOverlay=function(){return cp300v1WheelOverlay();};\ncp300v13WheelOverlay=function(){return cp300v1WheelOverlay();};\ncp300v12WheelOverlay=function(){return cp300v1WheelOverlay();};\ncp300v11WheelOverlay=function(){return cp300v1WheelOverlay();};\ncp300v9WheelOverlay=function(){return cp300v1WheelOverlay();};\n\n// ============================================================================\n// Changes only: ignition encoder-ring extension, pit-limiter encoder-ring\n// extension + pit-exit warning, exact right-side thumb ownership, and\n// car-specific redline colour authority. Existing RPM matrices, flags,\n// spotter, telemetry rings, idle, startup and button behaviour remain intact.\n// ============================================================================\n\nif (typeof C300V25 === 'object') {\n    if (C300V25.pitExitLimiterAt === undefined) C300V25.pitExitLimiterAt = 0;\n}\n\nfunction c300v26CircularDistance(a,b,n) {\n    var d=Math.abs(a-b); return Math.min(d,n-d);\n}\nfunction c300v26RingHead(baseColour, phase) {\n    var ring=c300v25Empty(12,baseColour);\n    var pos=((phase%1)+1)%1*12;\n    for(var j=0;j<12;j++) {\n        var d=c300v26CircularDistance(j,pos,12);\n        var whiteMix=0;\n        if(d<0.48) whiteMix=1.0-(d/0.48)*0.08;\n        else if(d<1.30) whiteMix=(1.30-d)/0.82*0.34;\n        else if(d<2.05) whiteMix=(2.05-d)/0.75*0.08;\n        if(whiteMix>0) ring[j]=c300v25Blend(baseColour,'#FFFFFFFF',c300v25Clamp(whiteMix,0,1));\n    }\n    return ring;\n}\nfunction c300v26PaintAllRings(out,baseColour,phase) {\n    var rings=cp300v4Rings();\n    var ring=c300v26RingHead(baseColour,phase);\n    for(var r=0;r<rings.length;r++) for(var j=0;j<12;j++) out[rings[r].start+j]=ring[j];\n    return out;\n}\n\n// master clock to all three encoder rings. Each ring is a solid ignition colour\n// with one smooth white circular head.\nfunction c300v25IgnitionWheel(baseColour) {\n    var out=c300v25Empty(44,null);\n    for(var b=0;b<8;b++) out[b]=baseColour;\n    var p=c300v25IgnitionProgress(),cursor=p*3;\n    c300v25PaintPath(out,[0,1,2,3],cursor,baseColour);\n    c300v25PaintPath(out,[4,5,6,7],cursor,baseColour);\n    var now=Date.now(), start=Number(C300V25.ignitionAt||now);\n    var phase=((now-start)%5600)/5600;\n    return c300v26PaintAllRings(out,baseColour,phase);\n}\n\n// Pit limiter: retain synchronized button and 0/12/0 RPM movement. All three\n// rings are solid cyan with one white circular head driven by the same 2640 ms\n// master period as the top bar and button banks.\nfunction c300v25PitWheel() {\n    var out=cp300v4StaticWheel(0.34), sync=c300v25PitSync(), cursor=sync.progress*3;\n    var left=[0,1,2,3],right=[4,5,6,7];\n    for(var i=0;i<4;i++) {\n        var c=c300v25PitColour(Math.abs(i-cursor)*1.35);\n        out[left[i]]=c; out[right[i]]=c;\n    }\n    return c300v26PaintAllRings(out,'#FF00FFE0',sync.u);\n}\n\n// Record a dedicated pit-exit alert only when the pit-lane edge is crossed\n// preserved separately through pitExitAt.\nfunction c300v25UpdatePit() {\n    var pit=c300v25InPit(), now=Date.now();\n    if(!C300V25.pitKnown) {\n        C300V25.pitKnown=true; C300V25.pitLast=pit;\n    } else if(!pit && C300V25.pitLast) {\n        C300V25.pitExitAt=now;\n        if(c300v25Limiter()) C300V25.pitExitLimiterAt=now;\n    }\n    C300V25.pitLast=pit;\n}\nfunction c300v26PitExitAlertAge() {\n    var at=Number(C300V25.pitExitLimiterAt||0);\n    if(at<=0) return -1;\n    var age=Date.now()-at;\n    return age>=0&&age<1250?age:-1;\n}\nfunction c300v26PitExitTop() {\n    var age=c300v26PitExitAlertAge(); if(age<0) return null;\n    var on=(Math.floor(age/105)%2)===0;\n    return c300v25Empty(12,on?'#FFFFFFFF':'#FF000000');\n}\nfunction c300v26PitExitWheel() {\n    var age=c300v26PitExitAlertAge(); if(age<0) return null;\n    var on=(Math.floor(age/105)%2)===0;\n    return c300v25Empty(44,on?'#FFFFFFFF':'#FF000000');\n}\n\n// newer smooth painter; keeping both active caused right-side encoder pulses to\n// illuminate left-side buttons underneath the final overlay.\nfunction cp300v14ApplyThumbEncoderButtons(leds) { return leds; }\nfunction cp300v12ApplyThumbEncoderButtons(leds) { return leds; }\nfunction cp300v16ApplyThumbEncoderButtons(leds) { return leds; }\nfunction cp300v17ApplyThumbEncoderButtons(leds) { return leds; }\nfunction cp300v18ApplyThumbEncoderButtons(leds) { return leds; }\n\n// Exact official 300 GT front encoder map converted to SimHub's zero-based HID\n// indices. No cross-side fallback IDs are used.\n// Diagram 13/14 -> IDs 12/13 (left top)\n// Diagram 15/16 -> IDs 14/15 (right top)\n// Diagram 17/18 -> IDs 16/17 (left middle)\n// Diagram 19/20 -> IDs 18/19 (right middle)\nfunction c300v25CaptureEncoders() {\n    if(c300v25AnyPulse([13],'tl_left'))  c300v25EncoderStart('left','top','down');\n    if(c300v25AnyPulse([12],'tl_right')) c300v25EncoderStart('left','top','up');\n    if(c300v25AnyPulse([14],'tr_left'))  c300v25EncoderStart('right','top','down');\n    if(c300v25AnyPulse([15],'tr_right')) c300v25EncoderStart('right','top','up');\n    if(c300v25AnyPulse([16],'ml_down'))  c300v25EncoderStart('left','middle','down');\n    if(c300v25AnyPulse([17],'ml_up'))    c300v25EncoderStart('left','middle','up');\n    if(c300v25AnyPulse([18],'mr_down'))  c300v25EncoderStart('right','middle','down');\n    if(c300v25AnyPulse([19],'mr_up'))    c300v25EncoderStart('right','middle','up');\n}\n\nfunction c300v26ColourToken(token) {\n    if(token===undefined||token===null) return null;\n    var s=String(token).trim().toLowerCase();\n    if(!s||s==='transparent'||s==='none'||s==='black'||s==='#000000'||s==='#ff000000') return null;\n    var named={\n        red:'#FFFF0000', green:'#FF00FF00', yellow:'#FFFFFF00', orange:'#FFFF7A00',\n        blue:'#FF006CFF', cyan:'#FF00FFFF', white:'#FFFFFFFF', purple:'#FF9A00FF',\n        violet:'#FF8A00FF', magenta:'#FFFF00FF'\n    };\n    if(named[s]) return named[s];\n    if(/^#[0-9a-f]{6}$/i.test(s)) return '#FF'+s.substring(1).toUpperCase();\n    if(/^#[0-9a-f]{8}$/i.test(s)) return s.toUpperCase();\n    try {\n        if(typeof cp300v22ExactColour==='function') {\n            var c=cp300v22ExactColour(token);\n            if(c&&String(c).charAt(0)==='#'&&String(c).toLowerCase()!=='#ff000000') return String(c).toUpperCase();\n        }\n    } catch(e) {}\n    return null;\n}\nfunction c300v26ProfileFinalColour(profile) {\n    if(!profile) return null;\n    var direct=c300v26ColourToken(profile.fc);\n    if(direct) return direct;\n    var seg=profile.seg||[], best=-1, colour=null;\n    for(var i=0;i<seg.length;i++) {\n        var threshold=Number(seg[i][1])||0;\n        var c=c300v26ColourToken(seg[i][2]);\n        if(c&&threshold>=best) { best=threshold; colour=c; }\n    }\n    return colour;\n}\nfunction c300v26RedlineCo