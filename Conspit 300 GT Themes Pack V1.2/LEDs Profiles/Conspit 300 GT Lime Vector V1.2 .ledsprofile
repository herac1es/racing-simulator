ng logic.\n// ============================================================================\n\nfunction cp300v9Bool(names) {\n    for (var i=0;i<names.length;i++) {\n        try {\n            var v = $prop(names[i]);\n            if (v === true || v === 'true' || v === 'True') return true;\n            var n = Number(v);\n            if (isFinite(n) && !isNaN(n) && n > 0.5) return true;\n        } catch(e) {}\n    }\n    return false;\n}\nfunction cp300v9SpotterLeft() {\n    return cp300v9Bool([\n        'SpotterCarLeft',\n        'DataCorePlugin.GameData.NewData.SpotterCarLeft',\n        'DataCorePlugin.GameData.SpotterCarLeft',\n        'GameRawData.Telemetry.SpotterCarLeft',\n        'GameRawData.Graphics.SpotterCarLeft',\n        'PersistantTrackerPlugin.CarLeft',\n        'CarLeft',\n        'IsCarLeft'\n    ]);\n}\nfunction cp300v9SpotterRight() {\n    return cp300v9Bool([\n        'SpotterCarRight',\n        'DataCorePlugin.GameData.NewData.SpotterCarRight',\n        'DataCorePlugin.GameData.SpotterCarRight',\n        'GameRawData.Telemetry.SpotterCarRight',\n        'GameRawData.Graphics.SpotterCarRight',\n        'PersistantTrackerPlugin.CarRight',\n        'CarRight',\n        'IsCarRight'\n    ]);\n}\nfunction cp300v9SpotterEnvelope() {\n    // Single shared envelope for buttons and encoder rings.\n    // First half: breathe ON in cyan-blue.\n    // Second half: breathe OFF from clean white to full black/off.\n    var cycle = 980;\n    var t = Date.now() % cycle;\n    var rise = 430;\n    var cyan = '#FF00D8FF';\n    var blue = '#FF006CFF';\n    var white = '#FFFFFFFF';\n    if (t < rise) {\n        var p = cp300v4EaseInOut(t / rise);\n        var col = cp300v4Blend(blue, cyan, 0.72);\n        return { colour: col, intensity: 0.10 + 0.90 * p, phase:'cyanOn' };\n    }\n    var q = cp300v4EaseInOut((t - rise) / (cycle - rise));\n    return { colour: white, intensity: 1.0 - q, phase:'whiteOff' };\n}\nfunction cp300v9PaintSpotterButton(leds, led, env) {\n    if (env.intensity <= 0.025) leds[led] = cp300v4Black();\n    else leds[led] = cp300v4Dim(env.colour, env.intensity);\n}\nfunction cp300v9PaintSpotterRing(leds, ringStart, env) {\n    for (var j=0;j<12;j++) {\n        if (env.intensity <= 0.025) leds[ringStart+j] = cp300v4Black();\n        else leds[ringStart+j] = cp300v4Dim(env.colour, env.intensity);\n    }\n}\nfunction cp300v9SpotterWheel() {\n    var left = cp300v9SpotterLeft();\n    var right = cp300v9SpotterRight();\n    if (!left && !right) return cp300v4Empty(44);\n\n    // Black baseline gives the spotter a clean cockpit-level alert without\n    // colour noise from the normal theme underneath.\n    var leds = cp300v4Empty(44);\n    for (var i=0;i<44;i++) leds[i] = cp300v4Black();\n\n    var env = cp300v9SpotterEnvelope();\n    var buttons = cp300v4ButtonMap();\n    for (var b=0;b<buttons.length;b++) {\n        var activeButton = (left && buttons[b].side === 'L') || (right && buttons[b].side === 'R') || (left && right);\n        leds[buttons[b].led] = activeButton ? cp300v4Black() : cp300v4Black();\n        if (activeButton) cp300v9PaintSpotterButton(leds, buttons[b].led, env);\n    }\n\n    var rings = cp300v4Rings();\n    // Left-only = left encoder ring. Right-only = right encoder ring.\n    // Both sides = all three encoder rings for a clear three-wide warning.\n    if (left && right) {\n        for (var rb=0;rb<rings.length;rb++) cp300v9PaintSpotterRing(leds, rings[rb].start, env);\n    } else if (left) {\n        cp300v9PaintSpotterRing(leds, rings[0].start, env);\n    } else if (right) {\n        cp300v9PaintSpotterRing(leds, rings[2].start, env);\n    }\n    return leds;\n}\nfunction cp300v9WheelOverlay() {\n    if (cp300v7RedlineState()) return cp300v8WheelRedline();\n    var start = cp300v8StartupWheel(); if (cp300v4AnyLit(start)) return start;\n    var ign = cp300v6IgnitionWheel(); if (cp300v4AnyLit(ign)) return ign;\n    if (cp300v6PitActive()) return cp300v4ApplyButtonPress(cp300v8PitWheel());\n    var flag = cp300v4FlagsWheel(); if (cp300v4AnyLit(flag)) return cp300v4ApplyButtonPress(flag);\n    var spot = cp300v9SpotterWheel(); if (cp300v4AnyLit(spot)) return cp300v4ApplyButtonPress(spot);\n    if (cp300v6IgnitionOnlyActive()) return cp300v4ApplyButtonPress(cp300v4IgnitionWheel());\n    if (cp300v6IdleActive()) return cp300v8IdleWheel();\n    return cp300v8DynamicWheel();\n}\nfunction cp300v9TopOverlay() { return cp300v8TopOverlay(); }\n\n\n// ============================================================================\n// CONSPIT 300 GT V10 BRAKE RING PHASE FIX\n// Fix: centre encoder brake fill physical phase. Previous centre ring map was\n// logically paired but one LED early on the left side of the physical 300 GT\n// ring. This version uses a right/left bottom-to-top pair ladder so the red\n// brake fill rises evenly on both sides.\n// ============================================================================\n\nfunction cp300v10PaintBrakeRing(leds, ringStart) {\n    var red = '#FFFF0000', white = '#FFFFFFFF';\n    var brake = 0;\n    try { brake = cp300v7PairBrakeLevel01 ? cp300v7PairBrakeLevel01() : 0; } catch(e) { brake = 0; }\n    brake = cp300v6Clamp(brake, 0, 1);\n\n    // Corrected physical centre-ring ladder for 300 GT:\n    // bottom pair -> lower pair -> mid pair -> upper pair -> shoulder pair -> top/last pair.\n    // This removes one early left-side LED compared with V9/V8.\n    var pairs = [[5,7],[4,8],[3,9],[2,10],[1,11],[0,6]];\n    var progress = brake * pairs.length;\n    var fullPairs = Math.floor(progress);\n    var partial = progress - fullPairs;\n    var warn = brake >= 0.90;\n    var flash = Math.floor(Date.now()/86)%2===0;\n\n    // 0% brake must be a full white 12/12 ring.\n    for (var j=0;j<12;j++) leds[ringStart+j] = cp300v4Dim(white, 0.95);\n\n    for (var p=0;p<pairs.length;p++) {\n        var lit = p < fullPairs ? 1 : (p === fullPairs ? partial : 0);\n        if (lit <= 0.01) continue;\n        var strength = 0.34 + 0.66 * cp300v6Clamp(lit, 0, 1);\n        if (warn) strength = flash ? 1.0 : 0.18;\n        leds[ringStart+pairs[p][0]] = cp300v4Dim(red, strength);\n        leds[ringStart+pairs[p][1]] = cp300v4Dim(red, strength);\n    }\n}\n\n// Override the V8/V9 centre brake painter while preserving ABS/TC ring logic.\nfunction cp300v8PaintBrakeRing(leds, ringStart) {\n    return cp300v10PaintBrakeRing(leds, ringStart);\n}\nfunction cp300v8ApplyRingTelemetry(leds) {\n    var rings = cp300v6Rings();\n    cp300v6PaintSettingRing(leds, rings[0].start, cp300v6AbsValue(), '#FFFFFF00', cp300v6AbsActive());\n    cp300v10PaintBrakeRing(leds, rings[1].start);\n    cp300v6PaintSettingRing(leds, rings[2].start, cp300v6TcValue(), '#FF006CFF', cp300v6TcActive());\n    return leds;\n}\n\n\n// ============================================================================\n// CONSPIT 300 GT V11 FLAGS BUTTON/RING PULSE SYSTEM\n// Adds a clean rapid-breath flags layer dedicated to the bottom four buttons\n// and the middle P-KNOB encoder ring only.\n// Physical 300 GT local wheel LEDs:\n//   buttons 0..7\n//   bottom flag buttons: 2,3 left + 6,7 right\n//   encoder rings: left 8..19, middle 20..31, right 32..43\n// ============================================================================\n\nfunction cp300v11FlagColour() {\n    var c = null;\n    try { c = cp300v4FlagColour(); } catch(e) { c = null; }\n    if (!c) return null;\n    // Black flag on LEDs is not visible if rendered pure black. Use a hard white\n    // strobe so the warning is still readable on the wheel.\n    if (String(c).toUpperCase() === '#FF050505' || String(c).toUpperCase() === '#FF000000') return '#FFFFFFFF';\n    return c;\n}\n\nfunction cp300v11FlagPulse01() {\n    // Rapid-ish breathing, not a harsh strobe: about 0.45s per wave.\n    var raw = 0.5 + 0.5 * Math.sin(Date.now() / 72);\n    try { return cp300v4Smooth(raw); } catch(e) { return raw; }\n}\n\nfunction cp300v11PaintFlagButtonRingLayer(leds, colour) {\n    var p = cp300v11FlagPulse01();\n    var strength = 0.04 + 0.96 * p;\n\n    // Bottom four buttons only: left middle + left bottom, right middle + right bottom.\n    var flagButtons = [2,3,6,7];\n    for (var i=0; i<flagButtons.length; i++) leds[flagButtons[i]] = cp300v4Dim(colour, strength);\n\n    // Middle encoder ring only, synchronized with the button breath.\n    var middleRingStart = 20;\n    for (var j=0; j<12; j++) leds[middleRingStart+j] = cp300v4Dim(colour, strength);\n    return leds;\n}\n\nfunction cp300v11FlagsWheel() {\n    var colour = cp300v11FlagColour();\n    if (!colour) return cp300v4Empty(44);\n\n    // Keep the normal live wheel language underneath, then punch the flag cue\n    // only into the requested four buttons and centre ring.\n    var leds;\n    try { leds = cp300v8DynamicWheel(); }\n    catch(e) { leds = cp300v4StaticWheel(0.86); }\n    return cp300v11PaintFlagButtonRingLayer(leds, colour);\n}\n\n// Override older full-wheel flag behaviour with the new targeted flag layer.\nfunction cp300v4FlagsWheel() { return cp300v11FlagsWheel(); }\n\nfunction cp300v11WheelOverlay() {\n    if (cp300v7RedlineState()) return cp300v8WheelRedline();\n    var start = cp300v8StartupWheel(); if (cp300v4AnyLit(start)) return start;\n    var ign = cp300v6IgnitionWheel(); if (cp300v4AnyLit(ign)) return ign;\n    if (cp300v6PitActive()) return cp300v4ApplyButtonPress(cp300v8PitWheel());\n    var flag = cp300v11FlagsWheel(); if (cp300v4AnyLit(flag)) return cp300v4ApplyButtonPress(flag);\n    var spot = cp300v9SpotterWheel(); if (cp300v4AnyLit(spot)) return cp300v4ApplyButtonPress(spot);\n    if (cp300v6IgnitionOnlyActive()) return cp300v4ApplyButtonPress(cp300v4IgnitionWheel());\n    if (cp300v6IdleActive()) return cp300v8IdleWheel();\n    return cp300v8DynamicWheel();\n}\n\n// Keep legacy formula compatibility.\nfunction cp300v9WheelOverlay() { return cp300v11WheelOverlay(); }\n\n\n// ============================================================================\n\n// Adds button-side animations for top/rear thumb encoders and middle P-ENC\n// thumb encoders. Designed to work both while driving and while idle.\n// Local wheel LEDs:\n//   buttons 0..7: L top outer, L top inner, L middle, L bottom,\n//                 R top outer, R top inner, R middle, R bottom\n//   rings 8..19 left knob, 20..31 centre knob, 32..43 right knob\n// Controller inputs used:\n//   top/rear thumb pulse known inputs: 8 left, 9 right\n//   optional top encoder fallback IDs: 10..13, used only if the wheel exposes them\n//   middle left thumb: 16 down, 17 up\n//   middle right thumb: 18 down, 19 up\n// ============================================================================\n\nfunction cp300v12Btn(id) {\n    try { return !!getcontrollerbuttonstate('0x3514,0x000E', id); }\n    catch(e) { return false; }\n}\n\nfunction cp300v12AnyBtn(ids) {\n    for (var i=0; i<ids.length; i++) if (cp300v12Btn(ids[i])) return true;\n    return false;\n}\n\nfunction cp300v12State() {\n    if (!globalThis.cp300v12ThumbState) globalThis.cp300v12ThumbState = {prev:{}, pulse:{}};\n    return globalThis.cp300v12ThumbState;\n}\n\nfunction cp300v12Edge(key, ids, side, family, dir) {\n    var st = cp300v12State();\n    var now = Date.now();\n    var down = cp300v12AnyBtn(ids);\n    var was = !!st.prev[key];\n    if (down && !was) st.pulse[key] = {at:now, side:side, family:family, dir:dir};\n    st.prev[key] = down;\n}\n\nfunction cp300v12CaptureThumbEncoders() {\n    // Top/rear thumb encoders. 8/9 are the known 300 GT rear thumb signals;\n    // 10..13 are harmless fallbacks for firmware that exposes split directions.\n    cp300v12Edge('topL_a', [8,10], 'L', 'top', -1);\n    cp300v12Edge('topL_b', [11],   'L', 'top',  1);\n    cp300v12Edge('topR_a', [9,13], 'R', 'top',  1);\n    cp300v12Edge('topR_b', [12],   'R', 'top', -1);\n\n    // Middle thumb encoders / P-ENC rollers.\n    cp300v12Edge('midL_down', [16], 'L', 'middle', -1);\n    cp300v12Edge('midL_up',   [17], 'L', 'middle',  1);\n    cp300v12Edge('midR_down', [18], 'R', 'middle', -1);\n    cp300v12Edge('midR_up',   [19], 'R', 'middle',  1);\n}\n\nfunction cp300v12WaveLevel(age, duration, idx, count) {\n    var t = cp300v4Clamp(age / duration, 0, 1);\n    var centre = (count <= 1) ? 0.5 : (idx / (count - 1));\n    var d = Math.abs(t - centre);\n    var spark = Math.exp(-(d*d) / 0.018);\n    var tail = 1 - cp300v4Smooth(t);\n    return cp300v4Clamp(0.15*tail + 0.95*spark, 0, 1);\n}\n\nfunction cp300v12ThemeAccentForLed(led, fallback) {\n    try { return cp300v4ButtonThemeAt(led); }\n    catch(e) { return fallback || '#FF00D7FF'; }\n}\n\nfunction cp300v12PaintButtonPulse(leds, led, level, accent) {\n    var base = leds[led] || cp300v12ThemeAccentForLed(led, '#FFFFFFFF');\n    // White core, accent halo. This keeps the cue readable on every theme.\n    var accentMix = cp300v4Blend(accent, '#FFFFFFFF', 0.42);\n    var punch = cp300v4Dim(accentMix, 0.18 + 0.82 * level);\n    leds[led] = cp300v4Blend(base, punch, 0.35 + 0.65 * level);\n}\n\nfunction cp300v12PaintTopThumb(leds, side, dir, age) {\n    var duration = 620;\n    if (age < 0 || age > duration) return false;\n    var order;\n    if (side === 'L') order = (dir < 0) ? [1,0] : [0,1];\n    else order = (dir < 0) ? [4,5] : [5,4];\n    var accent = side === 'L' ? '#FF00D7FF' : '#FFFF7A18';\n    for (var i=0; i<order.length; i++) {\n        var level = cp300v12WaveLevel(age, duration, i, order.length);\n        cp300v12PaintButtonPulse(leds, order[i], level, accent);\n    }\n    return true;\n}\n\nfunction cp300v12PaintMiddleThumb(leds, side, dir, age) {\n    var duration = 760;\n    if (age < 0 || age > duration) return false;\n    // Up = bottom-to-top wave. Down = top-to-bottom wave.\n    var order;\n    if (side === 'L') order = (dir > 0) ? [3,2,1,0] : [0,1,2,3];\n    else order = (dir > 0) ? [7,6,5,4] : [4,5,6,7];\n    var accent = side === 'L' ? '#FF00D7FF' : '#FFFF7A18';\n    for (var i=0; i<order.length; i++) {\n        var level = cp300v12WaveLevel(age, duration, i, order.length);\n        cp300v12PaintButtonPulse(leds, order[i], level, accent);\n    }\n    return true;\n}\n\nfunction cp300v12ApplyThumbEncoderButtons(leds) {\n    cp300v12CaptureThumbEncoders();\n    var st = cp300v12State();\n    var now = Date.now();\n    var active = false;\n    for (var key in st.pulse) {\n        if (!st.pulse.hasOwnProperty(key)) continue;\n        var p = st.pulse[key];\n        var age = now - p.at;\n        if (p.family === 'top') active = cp300v12PaintTopThumb(leds, p.side, p.dir, age) || active;\n        if (p.family === 'middle') active = cp300v12PaintMiddleThumb(leds, p.side, p.dir, age) || active;\n        if (age > 900) delete st.pulse[key];\n    }\n    return leds;\n}\n\nfunction cp300v12WheelOverlay() {\n    var base;\n    try { base = cp300v11WheelOverlay(); }\n    catch(e) {\n        try { base = cp300v8DynamicWheel(); }\n        catch(ee) { base = cp300v4StaticWheel(0.88); }\n    }\n    return cp300v12ApplyThumbEncoderButtons(base);\n}\n\n// Keep legacy formula compatibility: anything calling the previous overlay now\n\nfunction cp300v11WheelOverlay() {\n    if (cp300v7RedlineState()) return cp300v12ApplyThumbEncoderButtons(cp300v8WheelRedline());\n    var start = cp300v8StartupWheel(); if (cp300v4AnyLit(start)) return cp300v12ApplyThumbEncoderButtons(start);\n    var ign = cp300v6IgnitionWheel(); if (cp300v4AnyLit(ign)) return cp300v12ApplyThumbEncoderButtons(ign);\n    if (cp300v6PitActive()) return cp300v12ApplyThumbEncoderButtons(cp300v4ApplyButtonPress(cp300v8PitWheel()));\n    var flag = cp300v11FlagsWheel(); if (cp300v4AnyLit(flag)) return cp300v12ApplyThumbEncoderButtons(cp300v4ApplyButtonPress(flag));\n    var spot = cp300v9SpotterWheel(); if (cp300v4AnyLit(spot)) return cp300v12ApplyThumbEncoderButtons(cp300v4ApplyButtonPress(spot));\n    if (cp300v6IgnitionOnlyActive()) return cp300v12ApplyThumbEncoderButtons(cp300v4ApplyButtonPress(cp300v4IgnitionWheel()));\n    if (cp300v6IdleActive()) return cp300v12ApplyThumbEncoderButtons(cp300v8IdleWheel());\n    return cp300v12ApplyThumbEncoderButtons(cp300v8DynamicWheel());\n}\n\nfunction cp300v9WheelOverlay() { return cp300v11WheelOverlay(); }\n\n\n// ============================================================================\n\n// Fixes yellow/blue/red/white/black flag detection across Sims and forces the\n// requested flag cue onto the bottom four buttons + middle P-KNOB ring as the\n// final paint pass. This means brake/ABS/TC/base theme layers can no longer hide\n// the active track flag on those LEDs.\n// Local wheel LEDs:\n//   bottom flag buttons: 2,3,6,7\n//   middle P-KNOB ring: 20..31\n// ============================================================================\n\nfunction cp300v13Prop(name, fallback) {\n    try {\n        var v = $prop(name);\n        if (v === undefined || v === null || v === '' || v === '--') return fallback;\n        return v;\n    } catch(e) { return fallback; }\n}\n\nfunction cp300v13Truth(v) {\n    if (v === true) return true;\n    if (v === false || v === null || v === undefined) return false;\n    if (typeof v === 'number') return v !== 0;\n    var s = String(v).toLowerCase();\n    return s === '1' || s === 'true' || s === 'yes' || s === 'on';\n}\n\nfunction cp300v13Bool(name) { return cp300v13Truth(cp300v13Prop(name, false)); }\n\nfunction cp300v13Num(name, fallback) {\n    var v = cp300v13Prop(name, fallback);\n    var n = Number(v);\n    return isNaN(n) ? fallback : n;\n}\n\nfunction cp300v13EqAny(name, values) {\n    var v = cp300v13Prop(name, null);\n    if (v === null || v === undefined) return false;\n    for (var i=0; i<values.length; i++) {\n        if (String(v).toLowerCase() === String(values[i]).toLowerCase()) return true;\n        if (Number(v) === Number(values[i]) && !isNaN(Number(values[i]))) return true;\n    }\n    return false;\n}\n\nfunction cp300v13Game() {\n    return String(cp300v13Prop('DataCorePlugin.CurrentGame', '') || '');\n}\n\nfunction cp300v13AnyBool(names) {\n    for (var i=0; i<names.length; i++) if (cp300v13Bool(names[i])) return true;\n    return false;\n}\n\nfunction cp300v13AnyNumOne(names) {\n    for (var i=0; i<names.length; i++) if (cp300v13Num(names[i], 0) === 1) return true;\n    return false;\n}\n\nfunction cp300v13ACCYellow() {\n    for (var s=1; s<=3; s++) {\n        if (cp300v13Num('GameRawData.Graphics.globalYellow' + s, 0) === 1) return true;\n        if (cp300v13Num('GameRawData.Graphics.GlobalYellow' + s, 0) === 1) return true;\n    }\n    return cp300v13AnyNumOne([\n        'GameRawData.Graphics.globalYellow',\n        'GameRawData.Graphics.GlobalYellow',\n        'GameRawData.Graphics.yellowFlag',\n        'GameRawData.Graphics.YellowFlag'\n    ]);\n}\n\nfunction cp300v13LMURF2Yellow() {\n    for (var s=1; s<=3; s++) {\n        var ss = s < 10 ? '0' + s : String(s);\n        if (cp300v13Num('GameRawData.Data.mSectorFlag' + ss, 0) === 1) return true;\n        if (cp300v13Num('DataCorePlugin.GameRawData.mSectorFlag' + ss, 0) === 1) return true;\n        if (cp300v13Num('GameRawData.Data.mSectorFlag' + s, 0) === 1) return true;\n    }\n    return false;\n}\n\nfunction cp300v13IRacingFlag(name) {\n    return cp300v13AnyBool([\n        'GameRawData.Telemetry.SessionFlagsDetails.Is' + name,\n        'DataCorePlugin.GameRawData.Telemetry.SessionFlagsDetails.Is' + name,\n        'GameRawData.Telemetry.SessionFlagsDetails.is' + name,\n        'DataCorePlugin.GameRawData.Telemetry.SessionFlagsDetails.is' + name\n    ]);\n}\n\nfunction cp300v13YellowActive() {\n    if (cp300v13AnyBool(['Flag_Yellow','YellowFlag','Flag_YellowSector1','Flag_YellowSector2','Flag_YellowSector3','Flag_FullCourseYellow'])) return true;\n    if (cp300v13ACCYellow()) return true;\n    if (cp300v13LMURF2Yellow()) return true;\n    if (cp300v13IRacingFlag('yellow')) return true;\n    if (cp300v13AnyBool(['GameRawData.Telemetry.SessionFlagsDetails.Isyellow','GameRawData.Telemetry.SessionFlagsDetails.Iscaution','DataCorePlugin.GameRawData.Telemetry.SessionFlagsDetails.Isyellow'])) return true;\n    if (cp300v13Num('DataCorePlugin.GameRawData.mHighestFlagColour', 0) === 6) return true; // AMS2 yellow\n    if (cp300v13Num('GameRawData.mHighestFlagColour', 0) === 6) return true;\n    if (cp300v13EqAny('GameRawData.Graphics.Flag', ['Yellow','yellow','YELLOW',1])) return true;\n    return false;\n}\n\nfunction cp300v13BlueActive() {\n    if (cp300v13AnyBool(['Flag_Blue','BlueFlag'])) return true;\n    if (cp300v13IRacingFlag('blue')) return true;\n    if (cp300v13AnyBool(['GameRawData.Telemetry.SessionFlagsDetails.Isblue','DataCorePlugin.GameRawData.Telemetry.SessionFlagsDetails.Isblue'])) return true;\n    if (cp300v13EqAny('GameRawData.Graphics.Flag', ['Blue','blue','BLUE',2])) return true;\n    return false;\n}\n\nfunction cp300v13RedActive() {\n    if (cp300v13AnyBool(['Flag_Red','RedFlag','GameRawData.RedFlagShown','DataCorePlugin.GameRawData.RedFlagShown'])) return true;\n    if (cp300v13IRacingFlag('red')) return true;\n    if (cp300v13AnyBool(['GameRawData.Telemetry.SessionFlagsDetails.Isred','DataCorePlugin.GameRawData.Telemetry.SessionFlagsDetails.Isred'])) return true;\n    if (cp300v13Num('DataCorePlugin.GameRawData.mHighestFlagColour', 0) === 5) return true; // AMS2 red\n    if (cp300v13Num('GameRawData.mHighestFlagColour', 0) === 5) return true;\n    if (cp300v13EqAny('GameRawData.Graphics.Flag', ['Red','red','RED',5])) return true;\n    return false;\n}\n\nfunction cp300v13BlackActive() {\n    if (cp300v13AnyBool(['Flag_Black','BlackFlag'])) return true;\n    if (cp300v13IRacingFlag('black')) return true;\n    if (cp300v13AnyBool(['GameRawData.Telemetry.SessionFlagsDetails.Isblack','DataCorePlugin.GameRawData.Telemetry.SessionFlagsDetails.Isblack'])) return true;\n    return false;\n}\n\nfunction cp300v13WhiteActive() {\n    if (cp300v13AnyBool(['Flag_White','WhiteFlag'])) return true;\n    if (cp300v13IRacingFlag('white')) return true;\n    if (cp300v13AnyBool(['GameRawData.Telemetry.SessionFlagsDetails.Iswhite','DataCorePlugin.GameRawData.Telemetry.SessionFlagsDetails.Iswhite'])) return true;\n    if (cp300v13EqAny('GameRawData.Graphics.Flag', ['White','white','WHITE'])) return true;\n    return false;\n}\n\nfunction cp300v13GreenActive() {\n    if (cp300v13AnyBool(['Flag_Green','GreenFlag'])) return true;\n    if (cp300v13IRacingFlag('green')) return true;\n    if (cp300v13AnyBool(['GameRawData.Telemetry.SessionFlagsDetails.Isgreen','DataCorePlugin.GameRawData.Telemetry.SessionFlagsDetails.Isgreen'])) return true;\n    return false;\n}\n\nfunction cp300v13OrangeActive() {\n    if (cp300v13AnyBool(['Flag_Orange','OrangeFlag','Flag_Mechanical','MeatballFlag'])) return true;\n    return false;\n}\n\nfunction cp300v13FlagColour() {\n    // Priority order: red/black safety-critical first, then yellow/blue/white/green.\n    if (cp300v13RedActive()) return '#FFFF0000';\n    if (cp300v13BlackActive()) return '#FFFFFFFF'; // black flag stays visible on LEDs\n    if (cp300v13YellowActive()) return '#FFFFFF00';\n    if (cp300v13BlueActive()) return '#FF009DFF';\n    if (cp300v13OrangeActive()) return '#FFFF7A00';\n    if (cp300v13WhiteActive()) return '#FFFFFFFF';\n    if (cp300v13GreenActive()) return '#FF00FF00';\n    return null;\n}\n\nfunction cp300v13FlagPulse01() {\n    // Quick breathing, visible but not seizure-strobe. Peak about every 0.38s.\n    var raw = 0.5 + 0.5 * Math.sin(Date.now() / 60);\n    try { return cp300v4Smooth(raw); } catch(e) { return raw; }\n}\n\nfunction cp300v13PaintFlags(leds, colour) {\n    if (!leds || leds.length < 44) leds = cp300v4StaticWheel(0.82);\n    var p = cp300v13FlagPulse01();\n    var power = 0.02 + 0.98 * p;\n    var flagButtons = [2,3,6,7];\n    for (var i=0; i<flagButtons.length; i++) leds[flagButtons[i]] = cp300v4Dim(colour, power);\n    for (var j=0; j<12; j++) leds[20+j] = cp300v4Dim(colour, power);\n    return leds;\n}\n\nfunction cp300v13FlagsWheel() {\n    var c = cp300v13FlagColour();\n    if (!c) return cp300v4Empty(44);\n    return cp300v13PaintFlags(cp300v8DynamicWheel(), c);\n}\n\nfunction cp300v13CoreWheelNoFlag() {\n\n    if (cp300v7RedlineState()) return cp300v12ApplyThumbEncoderButtons(cp300v8WheelRedline());\n    var start = cp300v8StartupWheel(); if (cp300v4AnyLit(start)) return cp300v12ApplyThumbEncoderButtons(start);\n    var ign = cp300v6IgnitionWheel(); if (cp300v4AnyLit(ign)) return cp300v12ApplyThumbEncoderButtons(ign);\n    if (cp300v6PitActive()) return cp300v12ApplyThumbEncoderButtons(cp300v4ApplyButtonPress(cp300v8PitWheel()));\n    var spot = cp300v9SpotterWheel(); if (cp300v4AnyLit(spot)) return cp300v12ApplyThumbEncoderButtons(cp300v4ApplyButtonPress(spot));\n    if (cp300v6IgnitionOnlyActive()) return cp300v12ApplyThumbEncoderButtons(cp300v4ApplyButtonPress(cp300v4IgnitionWheel()));\n    if (cp300v6IdleActive()) return cp300v12ApplyThumbEncoderButtons(cp300v8IdleWheel());\n    return cp300v12ApplyThumbEncoderButtons(cp300v8DynamicWheel());\n}\n\nfunction cp300v13WheelOverlay() {\n    var leds = cp300v13CoreWheelNoFlag();\n    var colour = cp300v13FlagColour();\n    if (colour) return cp300v13PaintFlags(leds, colour);\n    return leds;\n}\n\n// Override all previous flag/overlay entry-points so the new flag authority is\n// used wherever SimHub evaluates the wheel layer.\nfunction cp300v11FlagColour() { return cp300v13FlagColour(); }\nfunction cp300v11FlagsWheel() { var c = cp300v13FlagColour(); return c ? cp300v13PaintFlags(cp300v8DynamicWheel(), c) : cp300v4Empty(44); }\nfunction cp300v4FlagsWheel() { return cp300v11FlagsWheel(); }\nfunction cp300v12WheelOverlay() { return cp300v13WheelOverlay(); }\nfunction cp300v11WheelOverlay() { return cp300v13WheelOverlay(); }\nfunction cp300v9WheelOverlay() { return cp300v13WheelOverlay(); }\n\n\n// ============================================================================\n\n// Purpose: make top and middle thumb encoder button cues bright enough to read\n// while driving, correct observed top-left/top-right routing, and keep the cue\n// active in both idle and live driving states.\n//\n// Local wheel LEDs:\n//   buttons 0..7: L top outer, L top inner, L middle, L bottom,\n//                 R top outer, R top inner, R middle, R bottom\n//   rings 8..19 left knob, 20..31 centre knob, 32..43 right knob\n//\n\n//   thumb signal groups and adds spare signal fallbacks for firmware variants.\n// ============================================================================\n\nfunction cp300v14Now() { return Date.now(); }\nfunction cp300v14Flash01(age, period) {\n    period = period || 92;\n    return (Math.floor(age / period) % 2) === 0 ? 1.0 : 0.18;\n}\nfunction cp300v14Tri(age, duration) {\n    var t = cp300v4Clamp(age / duration, 0, 1);\n    return 1 - Math.abs(2 * t - 1);\n}\nfunction cp300v14VisibleLevel(age, duration, index, count) {\n    var t = cp300v4Clamp(age / duration, 0, 1);\n    var centre = (count <= 1) ? 0.5 : index / (count - 1);\n    var d = Math.abs(t - centre);\n    var wave = Math.exp(-(d*d) / 0.028);\n    var hold = age < 170 ? 1.0 : 0.0;\n    var flick = cp300v14Flash01(age, 84);\n    return cp300v4Clamp(Math.max(hold, wave) * (0.72 + 0.28 * flick), 0, 1);\n}\nfunction cp300v14SideColour(side) {\n    return side === 'L' ? '#FF00E5FF' : '#FFFF8A00';\n}\nfunction cp300v14HotWhite(level) {\n    return cp300v4Dim('#FFFFFFFF', 0.22 + 0.78 * level);\n}\nfunction cp300v14PaintHard(leds, led, level, side, role) {\n    if (!leds || led < 0 || led >= leds.length) return;\n    level = cp300v4Clamp(level, 0, 1);\n    if (level <= 0.02) return;\n    var sideCol = cp300v14SideColour(side);\n    var themeCol;\n    try { themeCol = cp300v4ButtonThemeAt(led); } catch(e) { themeCol = sideCol; }\n    var base = leds[led] || cp300v4Dim(themeCol, 0.82);\n\n    // Big motorsport-style punch: full white leading edge, side colour body.\n    var body = cp300v4Blend(sideCol, themeCol, 0.18);\n    var whiteAmount = role === 'lead' ? 0.62 : 0.34;\n    var signal = cp300v4Blend(cp300v4Dim(body, 1.0), '#FFFFFFFF', whiteAmount);\n    var out = cp300v4Blend(base, signal, 0.48 + 0.52 * level);\n    // Force full visual brightness on the active peak, without touching global brightness.\n    if (level > 0.82) out = cp300v4Blend(out, '#FFFFFFFF', role === 'lead' ? 0.20 : 0.10);\n    leds[led] = out;\n}\n\nfunction cp300v12CaptureThumbEncoders() {\n    // Top/rear thumb encoders.\n\n    // These groups are intentionally swapped and widened with harmless spare IDs.\n    cp300v12Edge('topL_left',  [9,13],    'L', 'top', -1);\n    cp300v12Edge('topL_right', [12,15],   'L', 'top',  1);\n    cp300v12Edge('topR_left',  [8,10,14], 'R', 'top', -1);\n    cp300v12Edge('topR_right', [11,16],   'R', 'top',  1);\n\n    // Middle thumb encoders / P-ENC rollers. Keep original side logic, but give\n    // each side a brighter paint layer below. 16 is also used above as fallback,\n    // so the edge keys stay unique and the newest pulse wins visually.\n    cp300v12Edge('midL_down', [16], 'L', 'middle', -1);\n    cp300v12Edge('midL_up',   [17], 'L', 'middle',  1);\n    cp300v12Edge('midR_down', [18], 'R', 'middle', -1);\n    cp300v12Edge('midR_up',   [19], 'R', 'middle',  1);\n}\n\nfunction cp300v12PaintTopThumb(leds, side, dir, age) {\n    var duration = 520;\n    if (age < 0 || age > duration) return false;\n    var order;\n    if (side === 'L') order = (dir < 0) ? [0,1] : [1,0];\n    else order = (dir < 0) ? [4,5] : [5,4];\n\n    // Double-pop: visible even through peripheral vision.\n    var flash = cp300v14Flash01(age, 78);\n    var envelope = age < 360 ? 1.0 : (1 - cp300v4Smooth((age-360)/(duration-360)));\n    for (var i=0; i<order.length; i++) {\n        var stagger = Math.max(0, 1 - Math.abs((age - i*92) / 210));\n        var level = cp300v4Clamp(Math.max(0.70*envelope*flash, stagger), 0, 1);\n        cp300v14PaintHard(leds, order[i], level, side, i === 0 ? 'lead' : 'trail');\n    }\n    return true;\n}\n\n// Much brighter middle thumb cue. Full side ladder with directional motion.\nfunction cp300v12PaintMiddleThumb(leds, side, dir, age) {\n    var duration = 700;\n    if (age < 0 || age > duration) return false;\n    // Up = bottom-to-top. Down = top-to-bottom.\n    var order;\n    if (side === 'L') order = (dir > 0) ? [3,2,1,0] : [0,1,2,3];\n    else order = (dir > 0) ? [7,6,5,4] : [4,5,6,7];\n\n    // Start with all four side buttons clearly lit, then run a hard directional\n\n    var basePunch = age < 230 ? 0.96 : 0.34 * (1 - cp300v4Smooth((age-230)/(duration-230)));\n    for (var i=0; i<order.length; i++) {\n        var level = Math.max(basePunch, cp300v14VisibleLevel(age, duration, i, order.length));\n        cp300v14PaintHard(leds, order[i], level, side, i === 0 ? 'lead' : 'trail');\n    }\n    return true;\n}\n\nfunction cp300v14ApplyThumbEncoderButtons(leds) {\n    cp300v12CaptureThumbEncoders();\n    var st = cp300v12State();\n    var now = cp300v14Now();\n    for (var key in st.pulse) {\n        if (!st.pulse.hasOwnProperty(key)) continue;\n        var p = st.pulse[key];\n        var age = now - p.at;\n        if (p.family === 'top') cp300v12PaintTopThumb(leds, p.side, p.dir, age);\n        if (p.family === 'middle') cp300v12PaintMiddleThumb(leds, p.side, p.dir, age);\n        if (age > 960) delete st.pulse[key];\n    }\n    return leds;\n}\n\nfunction cp300v12ApplyThumbEncoderButtons(leds) { return cp300v14ApplyThumbEncoderButtons(leds); }\n\nfunction cp300v14CoreWheelNoFlag() {\n\n    if (cp300v7RedlineState()) return cp300v14ApplyThumbEncoderButtons(cp300v8WheelRedline());\n    var start = cp300v8StartupWheel(); if (cp300v4AnyLit(start)) return cp300v14ApplyThumbEncoderButtons(start);\n    var ign = cp300v6IgnitionWheel(); if (cp300v4AnyLit(ign)) return cp300v14ApplyThumbEncoderButtons(ign);\n    if (cp300v6PitActive()) return cp300v14ApplyThumbEncoderButtons(cp300v4ApplyButtonPress(cp300v8PitWheel()));\n    var spot = cp300v9SpotterWheel(); if (cp300v4AnyLit(spot)) r