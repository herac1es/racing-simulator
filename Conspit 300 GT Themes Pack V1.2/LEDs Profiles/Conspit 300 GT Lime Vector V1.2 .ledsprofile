                                              },
                                              "LedContainers": [
                                                {
                                                  "TriggerFormula": {
                                                    "JSExt": 0,
                                                    "Interpreter": 1,
                                                    "Expression": "//const Carid = [\"AF Corse\", \"Algarve Pro Racing\", \"Alpine Elf Team\", \"Cool Racing\", \"DKR Engineering\", \"Duqueine Team\", \"Graff Racing\", \"IDEC Sport\", \"Inter Europol Competition\", \"JOTA\", \"Nielsen Racing\", \"Panis Racing\", \"Prema Racing\", \"Racing Team Turkey\", \"Team WRT\", \"Tower Motorsports\", \"United Autosports\", \"Vector Sport\",\r\n//\"AO by TF 2024\", \"AF Corse 2024\", \"Algarve Pro Racing 2024\", \"Cool Racing 2024\", \"Crowdstrike Racing by APR 2024\", \"DKR Engineering 2024\", \"Duqueine Team 2024\", \"IDEC Sport 2024\", \"Inter Europol Competition 2024\", \"Nielsen Racing 2024\", \"Panis Racing 2024\", \"Proton Competition 2024\", \"United Autosports 2024\", \"United Autosports USA 2024\", \"Vector Sport 2024\", \"Oreca 07 ELMS Custom Team 2025\"];\r\n//return Carid.includes($prop('CarModel'));\r\nreturn true;"
                                                  },
                                                  "LedContainers": [
                                                    {
                                                      "ContentFormula": {
                                                        "JSExt": 4,
                                                        "Interpreter": 1,
                                                        "Expression": "const rpmsLedColours = csp300_TDM_Colour_Hex('main');\r\nconst redlineLedColours = csp300_TDM_Colour_Hex('alt');\r\n\r\nconst currentRPM = $prop('Rpms');\r\nconst RedlineReached = csp300_RedlineState();\r\nconst csp300_RpmsGrid = Array(csp300_ledLength);\r\n\r\nconst csp300_RPMValuesPerGear = csp300_RPMValues.find(g => g.gear == $prop('Gear'))?.values;\r\n\r\nfor (let i = 0; i < csp300_ledLength; i++) {\r\n\tconst RedlineColourOveride = RedlineColourOverideIndice.includes(i);\r\n\t\r\n\tif (csp300_RPMValuesPerGear[i] == null) {\r\n\t\tcsp300_RpmsGrid[i] = null;\r\n\t\tcontinue;\r\n\t}\r\n\tcsp300_RpmsGrid[i] = currentRPM >= csp300_RPMValuesPerGear[i]\r\n\t\t? (RedlineReached || RedlineColourOveride\r\n\t\t\t? redlineLedColours\r\n\t\t\t: rpmsLedColours)\r\n\t\t: null;\r\n}\r\n\r\nreturn RedlineReached && RedlineFlash\r\n\t? Math.floor(Date.now() / RedlineFlashFrequency) % 2\r\n\t\t? csp300_RpmsGrid\r\n\t\t: Array(csp300_ledLength).fill(null)\r\n\t: csp300_RpmsGrid;",
                                                        "PreExpression": "const csp300_ledLength = 10;\r\nconst csp300_RPMValues = [\r\n\t{ gear: 'R', values: [6800, 6999, 7198, 7397, 7596, 7794, 7993, 8192, 8391, 8590] },\r\n\t{ gear: 'N', values: [6800, 6999, 7198, 7397, 7596, 7794, 7993, 8192, 8391, 8590] },\r\n\t{ gear: '1', values: [6800, 6999, 7198, 7397, 7596, 7794, 7993, 8192, 8391, 8590] },\r\n\t{ gear: '2', values: [6800, 7000, 7200, 7400, 7600, 7800, 8000, 8200, 8400, 8600] },\r\n\t{ gear: '3', values: [6800, 7002, 7203, 7405, 7607, 7808, 8010, 8212, 8413, 8615] },\r\n\t{ gear: '4', values: [6800, 7003, 7207, 7410, 7613, 7817, 8020, 8223, 8427, 8630] },\r\n\t{ gear: '5', values: [6800, 7007, 7213, 7420, 7627, 7833, 8040, 8247, 8453, 8660] },\r\n\t{ gear: '6', values: [6800, 7010, 7220, 7430, 7640, 7850, 8060, 8270, 8480, 8690] }\r\n]\r\nconst RedlineFlash = false;\r\nconst RedlineFlashFrequency = 0;\r\nconst RedlineColourOverideIndice = [8, 9];"
                                                      },
                                                      "LedCount": 10,
                                                      "StartPosition": 2,
                                                      "ContainerType": "ScriptedContent",
                                                      "Description": "Rpms MultiGear TDM"
