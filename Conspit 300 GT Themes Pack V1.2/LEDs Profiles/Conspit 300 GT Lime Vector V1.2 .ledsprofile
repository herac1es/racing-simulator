or (var i = list.length - 1; i \u003e= 0; i--) {\n            if (isG87RpmProfile(list[i])) list.splice(i, 1);\n        }\n        list.push(rpmProfile);\n    }\n    function replaceRedlineProfile(list) {\n        if (!Array.isArray(list)) return;\n        for (var i = list.length - 1; i \u003e= 0; i--) {\n            var entry = list[i];\n            if (!entry || entry.g !== \u0027IRacing\u0027) continue;\n            var id = String(entry.i || \u0027\u0027).toLowerCase();\n            var model = String(entry.m || \u0027\u0027).toLowerCase();\n            if (id === \u0027bmwm2g87\u0027 || model.indexOf(\u0027m2 racing (g87)\u0027) \u003e= 0) list.splice(i, 1);\n        }\n        list.push(redlineProfile);\n    }\n\n    if (typeof CP300V8_EXACT_RPM_PROFILES !== \u0027undefined\u0027) replaceRpmProfile(CP300V8_EXACT_RPM_PROFILES);\n    if (typeof CP300V22_RPM_PROFILES !== \u0027undefined\u0027) replaceRpmProfile(CP300V22_RPM_PROFILES);\n    if (typeof CP300V22_REDLINE_PROFILES !== \u0027undefined\u0027) replaceRedlineProfile(CP300V22_REDLINE_PROFILES);\n\n    // Keep the original fallback database aware of the car as well.\n    if (typeof csp300_iRacingRedlines !== \u0027undefined\u0027 \u0026\u0026 Array.isArray(csp300_iRacingRedlines)) {\n        for (var r = csp300_iRacingRedlines.length - 1; r \u003e= 0; r--) {\n            if (String(csp300_iRacingRedlines[r].name || \u0027\u0027).toLowerCase().indexOf(\u0027m2 racing (g87)\u0027) \u003e= 0) {\n                csp300_iRacingRedlines.splice(r, 1);\n            }\n        }\n        csp300_iRacingRedlines.push({ name: \u0027BMW M2 Racing (G87)\u0027, redline: { ALL: 7000 } });\n    }\n\n    // Clear profile caches in case a profile is reloaded while iRacing is open.\n    try { if (globalThis.CP300V8_CACHE) globalThis.CP300V8_CACHE = {}; } catch (e0) {}\n    try {\n        if (typeof CP300V22_STATE === \u0027object\u0027) {\n            CP300V22_STATE.rpmKey = \u0027\u0027;\n            CP300V22_STATE.rpmCached = null;\n            CP300V22_STATE.redKey = \u0027\u0027;\n            CP300V22_STATE.redCached = null;\n        }\n    } catch (e1) {}\n})();\n// END LOCAL CAR PROFILE: iRacing BMW M2 Racing (G87)\n",
