urn TDMState == false; //All other games\n}\nreturn true;\n};\n\n\nfunction csp300_TDM_State(csp300_DeviceType) {\n\n//if (f1Games.includes($prop('DataCorePlugin.CurrentGame'))) return false;\n\n// Linked LD Behaviour\nif ($prop('ConspitLEDs.TDMDisplayDashboardBehaviour') ?? true) {\n\t\tif ($prop('DisplayPlugin.ld_TrueDarkModeEnabled') == true) TDM_LD_Behaviour = true;\n\t\tif ($prop('DisplayPlugin.ld_TrueDarkModeEnabled') == false) return false;\n}\nif ($prop('ConspitLEDs.TDMDisplayDashboardBehaviour') == false) TDM_LD_Behaviour = false;\n\n// Fallback to own behavior when there is no LD connection\nTDM_CSP_Behaviour = csp300_DeviceType;\n\nif (TDM_LD_Behaviour || TDM_CSP_Behaviour) {\n\nTDMState = TDM_LD_Behaviour\n\t? $prop('DisplayPlugin.ld_TrueDarkModeState') ?? false\n\t: $prop('ConspitLEDs.TDMState') ?? false;\n\n\tif ($prop('DataCorePlugin.CurrentGame') == 'AssettoCorsaCompetizione') {\n\t\tif ((TDM_LD_Behaviour && $prop('DisplayPlugin.ld_TrueDarkModeNative') == true) ||\n\t\t   (!TDM_LD_Behaviour && ($prop('ConspitLEDs.TDMNative') ?? true))) {\n\t\t\t\treturn TDMState == true || $prop('GameRawData.Graphics.LightsStage') == 2;\n\t\t}\n\t}\n\n\tif ($prop('DataCorePlugin.CurrentGame') == 'AssettoCorsaEVO') {\n\t\tif ((TDM_LD_Behaviour && $prop('DisplayPlugin.ld_TrueDarkModeNative') == true) ||\n\t\t   (!TDM_LD_Behaviour && ($prop('ConspitLEDs.TDMNative') ?? true))) {\n\t\t\t\treturn TDMState == true || $prop('GameRawData.Graphics.instrumentation.main_light_stage') == 2;\n\t\t}\n\t}\n\n\tif ($prop('DataCorePlugin.CurrentGame') == 'Automobilista2') {\n\t\tif ((TDM_LD_Behaviour && $prop('DisplayPlugin.ld_TrueDarkModeNative') == true) ||\n\t\t   (!TDM_LD_Behaviour && ($prop('ConspitLEDs.TDMNative') ?? true))) {\n\t\t\t\treturn TDMState == true || ($prop('DataCorePlugin.GameRawData.mCarFlags') & (1 << 0)) != 0;\n\t\t}\n\t}\n\n\tif ($prop('DataCorePlugin.CurrentGame') == 'RRRE') {\n\t\tif (!TDM_LD_Behaviour && ($prop('ConspitLEDs.TDMNative') ?? true)) {\n\t\t\tretu