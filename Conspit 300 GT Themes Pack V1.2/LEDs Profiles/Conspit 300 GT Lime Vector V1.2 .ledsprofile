, fallback) {\n    var v = cp300v15Prop(name, fallback);\n    var n = Number(v);\n    return isFinite(n) && !isNaN(n) ? n : fallback;\n}\nfunction cp300v15Bool(name) {\n    var v = cp300v15Prop(name, false);\n    if (v === true || v === 1) return true;\n    var s = String(v).toLowerCase();\n    return s === '1' || s === 'true' || s === 'yes' || s === 'on';\n}\nfunction cp300v15Text(name) {\n    var v = cp300v15Prop(name, '');\n    var s = String(v || '').trim();\n    if (!s || s === '--') return '';\n    var l = s.toLowerCase();\n    if (l === 'nan' || l === 'none' || l === 'null' || l === 'undefined' || l === 'unknown') return '';\n    return s;\n}\nfunction cp300v15FirstText(names) {\n    for (var i=0;i<names.length;i++) {\n        var s = cp300v15Text(names[i]);\n        if (s) return s;\n    }\n    return '';\n}\nfunction cp300v15FirstNumber(names, fallback) {\n    for (var i=0;i<names.length;i++) {\n        var v = cp300v15Prop(names[i], null);\n        if (v === null) continue;\n        var n = Number(v);\n        if (isFinite(n) && !isNaN(n)) return n;\n    }\n    return fallback;\n}\nfunction cp300v15GameConnected() {\n    var gr = cp300v15Bool('DataCorePlugin.GameRunning') || cp300v15Bool('GameRunning');\n    var game = cp300v15Text('DataCorePlugin.CurrentGame');\n    if (!gr) return false;\n    if (!game) return false;\n    var g = game.toLowerCase();\n    if (g === 'none' || g === 'no game' || g === 'desktop' || g === 'launcher') return false;\n    return true;\n}\nfunction cp300v15SessionText() {\n    return cp300v15FirstText([\n        'SessionTypeName',\n        'DataCorePlugin.GameData.NewData.SessionTypeName',\n        'DataCorePlugin.GameData.SessionTypeName',\n        'DataCorePlugin.GameData.NewData.SessionType',\n        'DataCorePlugin.GameData.SessionType',\n        'GameRawData.SessionTypeName',\n        'GameRawData.SessionData.SessionTypeName',\n        'GameRawData.PacketSessionData.m_sessionType'\n    ]);\n}\nfunction cp300v15TrackText() {\n    return cp300v15FirstText([\n        'TrackName','TrackCode','TrackId',\n        'DataCorePlugin.GameData.NewData.TrackName',\n        'DataCorePlugin.GameData.NewData.TrackCode',\n        'DataCorePlugin.GameData.TrackName',\n        'GameRawData.TrackName',\n        'GameRawData.SessionData.WeekendInfo.TrackName'\n    ]);\n}\nfunction cp300v15CarText() {\n    return cp300v15FirstText([\n        'CarModel','CarId','CarClass',\n        'DataCorePlugin.GameData.NewData.CarModel',\n        'DataCorePlugin.GameData.NewData.CarName',\n        'DataCorePlugin.GameData.NewData.CarId',\n        'GameRawData.CarModel',\n        'GameRawData.StaticInfo.CarModel'\n    ]);\n}\nfunction cp300v15SessionClock() {\n    return cp300v15FirstNumber([\n        'SessionTime','SessionTimeLeft','SessionTimeRemaining','SessionTimeElapsed',\n        'DataCorePlugin.GameData.NewData.SessionTime',\n        'DataCorePlugin.GameData.NewData.SessionTimeLeft',\n        'DataCorePlugin.GameData.NewData.SessionTimeRemaining',\n        'DataCorePlugin.GameData.NewData.SessionTimeElapsed',\n        'CurrentLapTime','LapCurrentLapTime',\n        'DataCorePlugin.GameData.NewData.CurrentLapTime',\n        'GameRawData.Graphics.iCurrentTime',\n        'GameRawData.Graphics.currentTime',\n        'GameRawData.Telemetry.SessionTime',\n        'GameRawData.CurrentPlayerTelemetry.mCurrentLapTime',\n        'GameRawData.PlayerLapData.m_currentLapTimeInMS'\n    ], -1);\n}\nfunction cp300v15SignalSignature() {\n    var rpm = 0, speed = 0;\n    try { rpm = cp300v6Rpm ? cp300v6Rpm() : cp300v15Num('Rpms', 0); } catch(e) { rpm = cp300v15Num('Rpms', 0); }\n    try { speed = cp300v6Speed ? cp300v6Speed() : cp300v15Num('SpeedKmh', 0); } catch(e) { speed = cp300v15Num('SpeedKmh', 0); }\n    var gear = cp300v15FirstText(['Gear','DataCorePlugin.GameData.NewData.Gear','GameRawData.TruckValues.CurrentValues.DashboardValues.GearDashboards']);\n    var lap = cp300v15FirstNumber(['CurrentLap','Lap','DataCorePlugin.GameData.NewData.CurrentLap','DataCorePlugin.GameData.NewData.Lap','GameRawData.PlayerLapData.m_currentLapNum'], -1);\n    var pos = cp300v15FirstNumber(['Position','DataCorePlugin.GameData.NewData.Position','GameRawData.PlayerLapData.m_carPosition'], -1);\n    var clock = cp300v15SessionClock();\n    var pit = (cp300v15Bool('PitLimiterOn') || cp300v15Bool('IsInPitLane') || cp300v15Bool('IsInPit') || cp300v15Bool('DataCorePlugin.GameData.IsInPitLane')) ? 1 : 0;\n    var flag = cp300v15FirstText(['Flag','Flags','GameRawData.Graphics.Flags','DataCorePlugin.GameRawData.mHighestFlagColour']);\n    // Quantise noisy values. We only need to know whether the stream is alive.\n    return [\n        cp300v15Text('DataCorePlugin.CurrentGame'),\n        cp300v15SessionText(), cp300v15TrackText(), cp300v15CarText(),\n        Math.round(rpm / 20), Math.round(speed * 2), gear,\n        Math.round(clock * 2), lap, pos, pit, flag\n    ].join('|');\n}\nfunction cp300v15StrongSessionMarker() {\n    // Broad cross-sim marker set. A car/track/session combo alone is enough to\n    // keep a loaded garage/session alive, but stale cached telemetry is still\n    // caught by the freshness gate below.\n    var session = cp300v15SessionText();\n    var track = cp300v15TrackText();\n    var car = cp300v15CarText();\n    var game = cp300v15Text('DataCorePlugin.CurrentGame');\n    var hasIdentity = !!(game && (session || track || car));\n    var clock = cp300v15SessionClock();\n    var hasClock = isFinite(clock) && clock >= 0;\n    return hasIdentity || hasClock;\n}\nfunction cp300v15LiveInputMarker() {\n    var brake = cp300v15FirstNumber(['Brake','BrakeRaw','GameRawData.Physics.Brake','GameRawData.Physics.brake','GameRawData.CurrentPlayerTelemetry.mUnfilteredBrake'], 0);\n    var throttle = cp300v15FirstNumber(['Throttle','ThrottleRaw','GameRawData.Physics.Gas','GameRawData.Physics.Throttle','GameRawData.CurrentPlayerTelemetry.mUnfilteredThrottle'], 0);\n    return Math.abs(brake) > 0.015 || Math.abs(throttle) > 0.015;\n}\nfunction cp300v15LiveMotionMarker() {\n    var rpm = 0, speed = 0;\n    try { rpm = cp300v6Rpm ? cp300v6Rpm() : cp300v15Num('Rpms',0); } catch(e) { rpm = cp300v15Num('Rpms',0); }\n    try { speed = cp300v6Speed ? cp300v6Speed() : cp300v15Num('SpeedKmh',0); } catch(e) { speed = cp300v15Num('SpeedKmh',0); }\n    var pit = false; try { pit = cp300v6PitActive ? cp300v6PitActive() : false; } catch(e) {}\n    var ign = false; try { ign = cp300v6IgnitionOn ? cp300v6IgnitionOn() : false; } catch(e) {}\n    var started = false; try { started = cp300v6EngineStarted ? cp300v6EngineStarted() : false; } catch(e) {}\n    return rpm > 180 || speed > 1.0 || pit || ign || started || cp300v15LiveInputMarker();\n}\nfunction cp300v15State() {\n    if (!globalThis.cp300v15SessionGate) {\n        globalThis.cp300v15SessionGate = {\n            sig:null,\n            changedAt:0,\n            liveAt:0,\n            lockedIdle:true,\n            lastGame:false\n        };\n    }\n    return globalThis.cp300v15SessionGate;\n}\nfunction cp300v15UpdateSessionGate() {\n    var now = cp300v15Now();\n    var st = cp300v15State();\n    var connected = cp300v15GameConnected();\n    if (!connected) {\n        st.sig = null;\n        st.changedAt = now;\n        st.liveAt = 0;\n        st.lockedIdle = true;\n        st.lastGame = false;\n        return st;\n    }\n\n    var sig = cp300v15SignalSignature();\n    var changed = (sig !== st.sig);\n    if (changed) {\n        st.sig = sig;\n        st.changedAt = now;\n        // Any meaningful signature movement means SimHub is receiving a fresh\n        // stream again, so unlock from desktop/menu idle.\n        if (cp300v15StrongSessionMarker() || cp300v15LiveMotionMarker()) st.lockedIdle = false;\n    }\n    if (cp300v15LiveMotionMarker()) {\n        st.liveAt = now;\n        st.lockedIdle = false;\n    }\n\n    // If the sim is open but session data has disappeared, treat that as menu.\n    if (!cp300v15StrongSessionMarker() && !cp300v15LiveMotionMarker()) {\n        if (now - st.changedAt > 900) st.lockedIdle = true;\n    }\n\n    // Frozen/cached telemetry trap: after leaving a session, some sims keep the\n    // last RPM, pit, flag, or button state around. If nothing has changed for a\n    // few seconds and no new live input/motion has been seen, force idle.\n    var staleMs = now - st.changedAt;\n    var liveAge = st.liveAt ? (now - st.liveAt) : 999999;\n    if (staleMs > 6200 && liveAge > 6200) st.lockedIdle = true;\n\n    st.lastGame = true;\n    return st;\n}\nfunction cp300v15ShouldForceIdle() {\n    var st = cp300v15UpdateSessionGate();\n    return !!st.lockedIdle;\n}\nfunction cp300v15IdleWheel() {\n    var leds = cp300v4IdleWheel();\n    try { leds = cp300v4ApplyButtonPress(leds); } catch(e) {}\n    try { leds = cp300v14ApplyThumbEncoderButtons(leds); } catch(e) {}\n    return leds;\n}\nfunction cp300v15IdleTop() { return cp300v4IdleTop(12); }\nfunction cp300v15WheelOverlay() {\n    if (cp300v15ShouldForceIdle()) return cp300v15IdleWheel();\n    return cp300v14WheelOverlay();\n}\nfunction cp300v15TopOverlay() {\n    if (cp300v15ShouldForceIdle()) return cp300v15IdleTop();\n    return cp300v9TopOverlay();\n}\n\n// Final entry-point overrides for any older container formula still pointing at\n\nfunction cp300v14WheelOverlay() {\n    if (cp300v15ShouldForceIdle()) return cp300v15IdleWheel();\n    var leds = cp300v14CoreWheelNoFlag();\n    var colour = cp300v13FlagColour();\n    if (colour) leds = cp300v13PaintFlags(leds, colour);\n    return cp300v14ApplyThumbEncoderButtons(leds);\n}\nfunction cp300v13WheelOverlay() { return cp300v15WheelOverlay(); }\nfunction cp300v12WheelOverlay() { return cp300v15WheelOverlay(); }\nfunction cp300v11WheelOverlay() { return cp300v15WheelOverlay(); }\nfunction cp300v9WheelOverlay() { return cp300v15WheelOverlay(); }\nfunction cp300v9TopOverlayV15Passthrough() { return cp300v8TopOverlay(); }\n\n\n// ============================================================================\n\n// direction-following breath sequence. The animation travels button-by-button in\n// the same direction as the thumb input and repeats twice. It works in idle and\n//\n// Local wheel LEDs:\n//   0..3 left buttons  top outer, top inner, middle, bottom\n//   4..7 right buttons top outer, top inner, middle, bottom\n//   8..19 left ring | 20..31 middle ring | 32..43 right ring\n// ============================================================================\n\nfunction cp300v16Now() { return Date.now(); }\nfunction cp300v16Clamp(v,a,b) { try { return cp300v4Clamp(v,a,b); } catch(e) { return Math.max(a, Math.min(b, v)); } }\nfunction cp300v16Smooth01(t) {\n    t = cp300v16Clamp(t, 0, 1);\n    return t * t * (3 - 2 * t);\n}\nfunction cp300v16SideAccent(side) {\n    // Strong enough to read in peripheral vision, still matching the Gulf/Conspit language.\n    return side === 'L' ? '#FF00D7FF' : '#FFFF8A00';\n}\nfunction cp300v16ThemeAt(led, fallback) {\n    try { return cp300v4ButtonThemeAt(led); } catch(e) { return fallback || '#FFFFFFFF'; }\n}\nfunction cp300v16Blend(a,b,t) {\n    try { return cp300v4Blend(a,b,t); } catch(e) { return b; }\n}\nfunction cp300v16Dim(c,l) {\n    try { return cp300v4Dim(c,l); } catch(e) { return c; }\n}\nfunction cp300v16PaintBreathButton(leds, led, level, side, lead) {\n    if (!leds || led < 0 || led >= leds.length) return;\n    level = cp300v16Clamp(level, 0, 1);\n    if (level <= 0.01) return;\n\n    var theme = cp300v16ThemeAt(led, cp300v16SideAccent(side));\n    var base = leds[led] || cp300v16Dim(theme, 0.76);\n    var accent = cp300v16SideAccent(side);\n\n    // Breath-on: colour body with a white core. Breath-off: returns to the existing base/theme.\n    // Keep high peak brightness because this cue is meant to be seen while driving.\n    var body = cp300v16Blend(accent, theme, 0.18);\n    var signal = cp300v16Blend(body, '#FFFFFFFF', lead ? 0.55 : 0.38);\n    signal = cp300v16Dim(signal, 0.30 + 0.70 * level);\n    var mix = 0.20 + 0.80 * level;\n    var out = cp300v16Blend(base, signal, mix);\n    if (level > 0.88) out = cp300v16Blend(out, '#FFFFFFFF', lead ? 0.22 : 0.12);\n    leds[led] = out;\n}\nfunction cp300v16StepBreathLevel(age, index, count, passMs, repeats) {\n    if (age < 0 || age > passMs * repeats) return 0;\n    var local = age % passMs;\n    var stepMs = passMs / count;\n    var start = index * stepMs;\n    var end = start + stepMs * 1.18; // slight overlap so the sweep feels connected, not stuttery\n    if (local < start || local > end) return 0;\n    var u = (local - start) / (end - start);\n    // Sin-like breath without Math.sin dependency weirdness in some SimHub builds.\n    var upDown = 1 - Math.abs(2*u - 1);\n    var breath = cp300v16Smooth01(upDown);\n    // Keep the second lap just as visible as the first.\n    return cp300v16Clamp(0.10 + 0.90 * breath, 0, 1);\n}\n\n// Capture override. The top-right clockwise/right pulse now has extra firmware fallbacks.\n// If Conspit firmware exposes only the 8/9 rear-thumb pair, this catches the missing\n// right-side pulse too. Middle P-ENC IDs remain the proven 16/17 and 18/19 set.\nfunction cp300v12CaptureThumbEncoders() {\n    // Left side: outward/inward pair. Right side: mirrored pair plus broader right-direction fallback.\n    cp300v12Edge('v16_topL_left',  [13, 9],       'L', 'top', -1);\n    cp300v12Edge('v16_topL_right', [12, 15],      'L', 'top',  1);\n    cp300v12Edge('v16_topR_left',  [8, 10],       'R', 'top', -1);\n    cp300v12Edge('v16_topR_right', [11, 14, 9],   'R', 'top',  1);\n\n    // Middle thumb encoders, vertical direction.\n    cp300v12Edge('v16_midL_down', [16], 'L', 'middle', -1);\n    cp300v12Edge('v16_midL_up',   [17], 'L', 'middle',  1);\n    cp300v12Edge('v16_midR_down', [18], 'R', 'middle', -1);\n    cp300v12Edge('v16_midR_up',   [19], 'R', 'middle',  1);\n}\n\nfunction cp300v12PaintTopThumb(leds, side, dir, age) {\n    // Two buttons, two passes. Direction follows the input.\n    var passMs = 360;\n    var repeats = 2;\n    if (age < 0 || age > passMs * repeats) return false;\n\n    var order;\n    if (side === 'L') {\n        // Left input travels outer -> inner, right input inner -> outer.\n        order = (dir < 0) ? [0,1] : [1,0];\n    } else {\n        // Mirrored right side: left input inner -> outer, right input outer -> inner.\n        order = (dir < 0) ? [5,4] : [4,5];\n    }\n\n    for (var i=0; i<order.length; i++) {\n        var level = cp300v16StepBreathLevel(age, i, order.length, passMs, repeats);\n        cp300v16PaintBreathButton(leds, order[i], level, side, i === 0);\n    }\n    return true;\n}\n\nfunction cp300v12PaintMiddleThumb(leds, side, dir, age) {\n    // Four buttons, two passes. Up = bottom-to-top. Down = top-to-bottom.\n    var passMs = 620;\n    var repeats = 2;\n    if (age < 0 || age > passMs * repeats) return false;\n\n    var order;\n    if (side === 'L') order = (dir > 0) ? [3,2,1,0] : [0,1,2,3];\n    else order = (dir > 0) ? [7,6,5,4] : [4,5,6,7];\n\n    for (var i=0; i<order.length; i++) {\n        var level = cp300v16StepBreathLevel(age, i, order.length, passMs, repeats);\n        cp300v16PaintBreathButton(leds, order[i], level, side, i === 0);\n    }\n    return true;\n}\n\nfunction cp300v14ApplyThumbEncoderButtons(leds) {\n    cp300v12CaptureThumbEncoders();\n    var st = cp300v12State();\n    var now = cp300v16Now();\n    for (var key in st.pulse) {\n        if (!st.pulse.hasOwnProperty(key)) continue;\n        var p = st.pulse[key];\n        var age = now - p.at;\n        if (p.family === 'top') cp300v12PaintTopThumb(leds, p.side, p.dir, age);\n        if (p.family === 'middle') cp300v12PaintMiddleThumb(leds, p.side, p.dir, age);\n        if (age > 1350) delete st.pulse[key];\n    }\n    return leds;\n}\nfunction cp300v12ApplyThumbEncoderButtons(leds) { return cp300v14ApplyThumbEncoderButtons(leds); }\nfunction cp300v16ApplyThumbEncoderButtons(leds) { return cp300v14ApplyThumbEncoderButtons(leds); }\n\n\n// ============================================================================\n\n\n// corrects the physical left/right travel order across the top button pairs.\n//\n// Local wheel buttons:\n//   0 L top outer | 1 L top inner | 2 L middle | 3 L bottom\n//   4 R top outer | 5 R top inner | 6 R middle | 7 R bottom\n// ============================================================================\n\nfunction cp300v17Now() { return Date.now(); }\n\nfunction cp300v17Edge(key, ids, side, family, dir) {\n\n    // contaminated by old duplicate key groups appended in earlier builds.\n    var st = cp300v12State();\n    var now = cp300v17Now();\n    var down = cp300v12AnyBtn(ids);\n    var was = !!st.prev[key];\n    if (down && !was) {\n        st.pulse[key] = {at:now, side:side, family:family, dir:dir, v17:true};\n    }\n    st.prev[key] = down;\n}\n\nfunction cp300v12CaptureThumbEncoders() {\n    // - Right top encoder right direction is owned by input 9 on this firmware.\n    // - Input 9 must NOT also trigger the left side, otherwise the wrong buttons\n    //   can react or the cue looks crossed.\n    // - Keep spare IDs as side-local fallbacks only.\n    cp300v17Edge('v17_topL_left',  [13],        'L', 'top', -1);\n    cp300v17Edge('v17_topL_right', [12, 15],    'L', 'top',  1);\n\n    cp300v17Edge('v17_topR_left',  [8, 10],     'R', 'top', -1);\n    cp300v17Edge('v17_topR_right', [9, 11, 14], 'R', 'top',  1);\n\n\n    cp300v17Edge('v17_midL_down', [16], 'L', 'middle', -1);\n    cp300v17Edge('v17_midL_up',   [17], 'L', 'middle',  1);\n    cp300v17Edge('v17_midR_down', [18], 'R', 'middle', -1);\n    cp300v17Edge('v17_midR_up',   [19], 'R', 'middle',  1);\n}\n\nfunction cp300v12PaintTopThumb(leds, side, dir, age) {\n    // Two buttons, two passes. Direction now follows physical button direction.\n    // L pair: 0 is outer-left, 1 is inner-right.\n    // R pair: 5 is inner-left, 4 is outer-right.\n    var passMs = 360;\n    var repeats = 2;\n    if (age < 0 || age > passMs * repeats) return false;\n\n    var order;\n    if (side === 'L') {\n        // Left input travels leftwards: inner -> outer. Right input travels rightwards: outer -> inner.\n        order = (dir < 0) ? [1, 0] : [0, 1];\n    } else {\n        // Left input travels leftwards: outer -> inner. Right input travels rightwards: inner -> outer.\n        order = (dir < 0) ? [4, 5] : [5, 4];\n    }\n\n    for (var i=0; i<order.length; i++) {\n        var level = cp300v16StepBreathLevel(age, i, order.length, passMs, repeats);\n        cp300v16PaintBreathButton(leds, order[i], level, side, i === 0);\n    }\n    return true;\n}\n\nfunction cp300v17ApplyThumbEncoderButtons(leds) {\n    cp300v12CaptureThumbEncoders();\n    var st = cp300v12State();\n    var now = cp300v17Now();\n    for (var key in st.pulse) {\n        if (!st.pulse.hasOwnProperty(key)) continue;\n        var p = st.pulse[key];\n        var age = now - p.at;\n        if (p.family === 'top') cp300v12PaintTopThumb(leds, p.side, p.dir, age);\n        if (p.family === 'middle') cp300v12PaintMiddleThumb(leds, p.side, p.dir, age);\n        if (age > 1350) delete st.pulse[key];\n    }\n    return leds;\n}\n\nfunction cp300v14ApplyThumbEncoderButtons(leds) { return cp300v17ApplyThumbEncoderButtons(leds); }\nfunction cp300v12ApplyThumbEncoderButtons(leds) { return cp300v17ApplyThumbEncoderButtons(leds); }\nfunction cp300v16ApplyThumbEncoderButtons(leds) { return cp300v17ApplyThumbEncoderButtons(leds); }\n\n\n// ============================================================================\n\n// Purpose:\n//     for both physical directions, using pulse-window detection so short\n//     encoder blips are not missed.\n//  2) Keep normal button press effects and top/middle thumb animations visible\n//     as the final wheel overlay in live driving and idle/menu mode.\n//\n// Local wheel LEDs:\n//   0 L top outer | 1 L top inner | 2 L middle | 3 L bottom\n//   4 R top outer | 5 R top inner | 6 R middle | 7 R bottom\n//   8..19 left ring | 20..31 middle ring | 32..43 right ring\n// ============================================================================\n\nfunction cp300v18Now() { return Date.now(); }\nfunction cp300v18Clamp(v,a,b) { try { return cp300v4Clamp(v,a,b); } catch(e) { return Math.max(a, Math.min(b, v)); } }\nfunction cp300v18Smooth01(t) { t = cp300v18Clamp(t,0,1); return t*t*(3-2*t); }\nfunction cp300v18Btn(id) {\n    try { return !!getcontrollerbuttonstate('0x3514,0x000E', id); }\n    catch(e) { return false; }\n}\nfunction cp300v18Pulse(id) {\n    // Encoder turns can be very short button pulses. Reading only the current\n    // state can miss them, especially while the sim is loaded and SimHub is busy.\n    try { if (isincreasing(520, getcontrollerbuttonstate('0x3514,0x000E', id))) return true; } catch(e) {}\n    try { if (cp300v18Btn(id)) return true; } catch(e) {}\n    return false;\n}\nfunction cp300v18AnyPulse(ids) {\n    for (var i=0; i<ids.length; i++) if (cp300v18Pulse(ids[i])) return true;\n    return false;\n}\nfunction cp300v18State() {\n    if (!globalThis.cp300v18ThumbState) globalThis.cp300v18ThumbState = {prev:{}, pulse:{}};\n    return globalThis.cp300v18ThumbState;\n}\nfunction cp300v18Purge(side, family) {\n    var s18 = cp300v18State();\n    for (var k in s18.pulse) {\n        if (!s18.pulse.hasOwnProperty(k)) continue;\n        var p = s18.pulse[k];\n        if ((!side || p.side === side) && (!family || p.family === family)) delete s18.pulse[k];\n    }\n\n    // the shared state object after profile reload/import.\n    try {\n        var old = cp300v12State();\n        for (var ok in old.pulse) {\n            if (!old.pulse.hasOwnProperty(ok)) continue;\n            var op = old.pulse[ok];\n            if ((!side || op.side === side) && (!family || op.family === family)) delete old.pulse[ok];\n        }\n    } catch(e) {}\n}\nfunction cp300v18Arm(key, active, side, family, dir) {\n    var st = cp300v18State();\n    var was = !!st.prev[key];\n    if (active && !was) st.pulse[key] = {at:cp300v18Now(), side:side, family:family, dir:dir, v18:true};\n    st.prev[key] = !!active;\n}\n\nfunction cp300v18CaptureThumbEncoders() {\n    // Final tested mapping strategy:\n    //   are painted on LEDs 4/5 only. This prevents the old crossed-left reaction.\n    // - Uses short-pulse detection rather than current-state only.\n    // - Left top remains on the side-local IDs that were already working.\n    var topRLeft  = cp300v18AnyPulse([8, 10]);\n    var topRRight = cp300v18AnyPulse([9, 11, 14]);\n\n    if (topRLeft || topRRight) {\n        // Right side wins over any stale/old top-left cue. This is the critical\n        // fix for the top-right encoder lighting the wrong side.\n        cp300v18Purge('L', 'top');\n        cp300v18Arm('v18_topR_left',  topRLeft,  'R', 'top', -1);\n        cp300v18Arm('v18_topR_right', topRRight, 'R', 'top',  1);\n    } else {\n        cp300v18Arm('v18_topL_left',  cp300v18AnyPulse([13]),     'L', 'top', -1);\n        cp300v18Arm('v18_topL_right', cp300v18AnyPulse([12, 15]), 'L', 'top',  1);\n    }\n\n    // Middle P-ENC rollers: keep proven IDs, but use pulse-window detection so\n    // the animation does not disappear while driving.\n    cp300v18Arm('v18_midL_down', cp300v18AnyPulse([16]), 'L', 'middle', -1);\n    cp300v18Arm('v18_midL_up',   cp300v18AnyPulse([17]), 'L', 'middle',  1);\n    cp300v18Arm('v18_midR_down', cp300v18AnyPulse([18]), 'R', 'middle', -1);\n    cp300v18Arm('v18_midR_up',   cp300v18AnyPulse([19]), 'R', 'middle',  1);\n}\n\nfunction cp300v18ThemeAt(led, fallback) {\n    try { return cp300v4ButtonThemeAt(led); } catch(e) { return fallback || '#FFFFFFFF'; }\n}\nfunction cp300v18Blend(a,b,t) { try { return cp300v4Blend(a,b,t); } catch(e) { return b; } }\nfunction cp300v18Dim(c,l) { try { return cp300v4Dim(c,l); } catch(e) { return c; } }\nfunction cp300v18Accent(side) { return side === 'L' ? '#FF00E5FF' : '#FFFF8A00'; }\nfunction cp300v18BreathLevel(age, index, count, passMs, repeats) {\n    if (age < 0 || age > passMs * repeats) return 0;\n    var local = age % passMs;\n    var stepMs = passMs / count;\n    var start = index * stepMs;\n    var end = start + stepMs * 1.12;\n    if (local < start || local > end) return 0;\n    var u = (local - start) / (end - start);\n    var tri = 1 - Math.abs(2*u - 1);\n    return cp300v18Clamp(0.16 + 0.84 * cp300v18Smooth01(tri), 0, 1);\n}\nfunction cp300v18PaintButton(leds, led, level, side, lead) {\n    if (!leds || led < 0 || led >= leds.length || level <= 0.01) return;\n    var base = leds[led] || cp300v18ThemeAt(led, '#FF202020');\n    var accent = cp300v18Accent(side);\n    // Full race-visibility punch: coloured body, white core at peak.\n    var body = cp300v18Blend(accent, '#FFFFFFFF', lead ? 0.34 : 0.22);\n    var signal = cp300v18Dim(body, 0.38 + 0.62 * level);\n    var out = cp300v18Blend(base, signal, 0.40 + 0.60 * level);\n    if (level > 0.86) out = cp300v18Blend(out, '#FFFFFFFF', lead ? 0.24 : 0.14);\n    leds[led] = out;\n}\nfunction cp300v18PaintTopThumb(leds, side, dir, age) {\n    var passMs = 340, repeats = 2;\n    if (age < 0 || age > passMs * repeats) return false;\n    var order;\n    if (side === 'L') {\n        order = (dir < 0) ? [1,0] : [0,1];\n    } else {\n        // Left/right input only changes the travel order, never the side.\n        order = (dir < 0) ? [5,4] : [4,5];\n    }\n    for (var i=0; i<order.length; i++) {\n        cp300v18PaintButton(leds, order[i], cp300v18BreathLevel(age, i, order.length, passMs, repeats), side, i===0);\n    }\n    return true;\n}\nfunction cp300v18PaintMiddleThumb(leds, side, dir, age) {\n    var passMs = 560, repeats = 2;\n    if (age < 0 || age > passMs * repeats) return false;\n    var order;\n    if (side === 'L') order = (dir > 0) ? [3,2,1,0] : [0,1,2,3];\n    else order = (dir > 0) ? [7,6,5,4] : [4,5,6,7];\n    for (var i=0; i<order.length; i++) {\n        cp300v18PaintButton(leds, order[i], cp300v18BreathLevel(age, i, order.length, passMs, repeats), side, i===0);\n    }\n    return true;\n}\nfunction cp300v18ApplyThumbEncoderButtons(leds) {\n    cp300v18CaptureThumbEncoders();\n    var st = cp300v18State();\n    var now = cp300v18Now();\n    for (var key in st.pulse) {\n        if (!st.pulse.hasOwnProperty(key)) continue;\n        var p = st.pulse[key];\n        var age = now - p.at;\n        if (p.family === 'top') cp300v18PaintTopThumb(leds, p.side, p.dir, age);\n        if (p.family === 'middle') cp300v18PaintMiddleThumb(leds, p.side, p.dir, age);\n        if (age > 1400) delete st.pulse[key];\n    }\n    return leds;\n}\n\nfunction cp300v18WheelOverlay() {\n    var leds;\n    if (cp300v15ShouldForceIdle()) {\n        leds = cp300v4IdleWheel();\n    } else {\n        leds = cp300v14CoreWheelNoFlag();\n        var colour = cp300v13FlagColour();\n        if (colour) leds = cp300v13PaintFlags(leds, colour);\n    }\n    // Final authority layer: button press effects plus thumb encoder animations\n    // are visible in idle, in-menu forced idle, and live driving.\n    try { leds = cp300v4ApplyButtonPress(leds); } catch(e) {}\n    try { leds = cp300v18ApplyThumbEncoderButtons(leds); } catch(e) {}\n    return leds;\n}\n\n// Override all previous thumb and wheel entry points so older containers cannot\nfunction cp300v12CaptureThumbEncoders() { return cp300v18CaptureThumbEncoders(); }\nfunction cp300v12ApplyThumbEncoderButtons(leds) { return cp300v18ApplyThumbEncoderButtons(leds); }\nfunction cp300v14ApplyThumbEncoderButtons(leds) { return cp300v18ApplyThumbEncoderButtons(leds); }\nfunction cp300v16ApplyThumbEncoderButtons(leds) { return cp300v18ApplyThumbEncoderButtons(leds); }\nfunction cp300v17ApplyThumbEncoderButtons(leds) { return cp300v18ApplyThumbEncoderButtons(leds); }\nfunction cp300v15WheelOverlay() { return cp300v18WheelOverlay(); }\nfunction cp300v14WheelOverlay() { return cp300v18WheelOverlay(); }\nfunction cp300v13WheelOverlay() { return cp300v18WheelOverlay(); }\