                    "JSExt": 4,
                    "Interpreter": 1,
                    "Expression": "let csp300_DeviceType = $prop('ConspitLEDs.NM') ?? true;\r\n\r\nlet csp300_DeviceTypeBrightness = isnull($prop('ConspitLEDs.WheelBrightness'), 100) * isnull($prop('ConspitLEDs.GlobalBrightness'), 100) / 100;\r\n\r\nlet csp300_BrightnessOutput = Math.ceil(csp300_DeviceTypeBrightness);\r\nlet csp300_NightModeBrightnessOutput = Math.ceil(csp300_DeviceTypeBrightness * isnull($prop('ConspitLEDs.NightModeBrightness'), 25) / 100);\r\n\r\n\r\nif (f1Games.includes($prop('DataCorePlugin.CurrentGame'))) return csp300_BrightnessOutput;\r\n\r\n// Linked LD Behaviour\r\nif ($prop('ConspitLEDs.TDMDisplayDashboardBehaviour') ?? true) {\r\n\t\tif ($prop('DisplayPlugin.ld_NightMode') == true) NM_LD_Behaviour = true;\r\n\t\tif ($prop('DisplayPlugin.ld_NightMode') == false) return csp300_BrightnessOutput;\r\n}\r\nif ($prop('ConspitLEDs.TDMDisplayDashboardBehaviour') == false) NM_LD_Behaviour = false;\r\n\r\n// Fallback to own behavior when there is no LD connection\r\nNM_CSP_Behaviour = csp300_DeviceType;\r\n\r\nif (NM_LD_Behaviour || NM_CSP_Behaviour) {\r\n\r\nTDMState = NM_LD_Behaviour\r\n\t? $prop('DisplayPlugin.ld_TrueDarkModeState') ?? false\r\n\t: $prop('ConspitLEDs.TDMState') ?? false;\r\n\r\n\tif ($prop('DataCorePlugin.CurrentGame') == 'AssettoCorsaCompetizione') {\r\n\t\tif ($prop('DisplayPlugin.Version') == null ||\r\n\r\n\t\t\t$prop('DisplayPlugin.ld_TrueDarkModeNative') == true) { \r\n\t\t\t\tif (TDMState == true ||\r\n\t\t\t\t\t$prop('GameRawData.Graphics.LightsStage') != 0) {\r\n\t\t\t\t\t\treturn csp300_NightModeBrightnessOutput;\r\n\t\t\t\t}\r\n\t\t}\r\n\t}\r\n\r\n\tif ($prop('DataCorePlugin.CurrentGame') == 'Automobilista2') {\r\n\t\tif ($prop('DisplayPlugin.Version') == null ||\r\n\r\n\t\t\t$prop('DisplayPlugin.ld_TrueDarkModeNative') == true) {\r\n\t\t\t\tif (TDMState == true ||\r\n\t\t\t\t\t($prop('DataCorePlugin.GameRawData.mCarFlags') & (1 << 0)) != 0) {\r\n\t\t\t\t\t\treturn csp300_NightModeBrightnessOutput;\r\n\t\t\t\t}\r\n\t\t}\r\n\t}\r\n\t\r\n\treturn TDMState == false\r\n\t\t? csp300_BrightnessOutput\r\n\t\t: csp300_NightModeBrightnessOutput; //All other games\r\n}\r\nreturn csp300_BrightnessOutput;"
                  },
                  "LedContainers": [
                    {
                      "TriggerFormula": {
                        "JSExt": 0,
                        "Interpreter": 1,
                        "Expression": "if ($prop('DataCorePlugin.CurrentGame') == 'IRacing') {\r\n\treturn $prop('GameRawData.Telemetry.IsReplayPlaying')\r\n\t\t? false\r\n\t\t: $prop('EngineIgnitionOn') == 0;\r\n}\r\nreturn $prop('EngineIgnitionOn') == 0;"
