                                              "ContainerType": "Groups.CustomConditionalGroup",
                                              "Description": "LMP3"
                                            }
                                          ],
                                          "ContainerType": "Base.Group",
                                          "Description": "Le Mans Ultimate Car Specific RPMs TDM"
                                        }
                                      ],
                                      "ContainerType": "Groups.CurrentGameGroup",
                                      "Description": "Le Mans Ultimate"
                                    }
                                  ],
                                  "ContainerType": "Groups.CustomConditionalGroup",
                                  "Description": "Specific Rpms"
                                },
                                {
                                  "TriggerFormula": {
                                    "JSExt": 4,
                                    "Interpreter": 1,
                                    "Expression": "return enableGenericRpms();"
                                  },
                                  "LedContainers": [
                                    {
                                      "ContentFormula": {
                                        "JSExt": 4,
                                        "Interpreter": 1,
                                        "Expression": "//TDM Colours\r\nconst rpmsLedColours = csp300_TDM_Colour_Hex('main');\r\nconst redlineLedColours = csp300_TDM_Colour_Hex('alt');\r\n\r\nconst halfLength = Math.ceil(csp300_ledLength / 2);\r\n\r\n// Initialize LED Grid\r\nconst csp300_RpmsGrid = Array(csp300_ledLength).fill(null);\r\n\r\nconst currentRPM = $prop('Rpms');\r\nconst redlineRPM = csp300_RedlineValue();\r\nconst startRPM = csp300_RpmStartValue();\r\n\r\n//Treshold Values (%)\r\nconst startThreshold = startRPM != null  // Applies to Left to Right & Meet in the Middle\r\n\t? startRPM / redlineRPM\r\n\t: ($prop('ConspitLEDs.RpmsStartThreshold') ?? 85) / 100;\r\nconst F1_SECOND_SEGMENT_START = 0.9;\r\nconst F1_SECOND_SEGMENT_END = 0.96;\r\nconst F1_THIRD_SEGMENT_START = 1;\r\n\r\nconst isLastGear = $prop('Gear') == $prop('CarSettings_MaxGears');\r\nconst lastGearRedline = !((($prop('ConspitLEDs.LastGearRedline') ?? true) == false) && isLastGear);\r\nconst RedlineReached = lastGearRedline && currentRPM >= redlineRPM;\r\n\r\nif (currentRPM <= 0) return [null]; // Skip if no RPM\r\n\r\n// Left to Right\r\nif ($prop('ConspitLEDs.GenericRpmsStyle') == 1 || $prop('ConspitLEDs.GenericRpmsStyle') == null) {\r\n\r\n\tconst rpmStepSize = (1 - startThreshold) / csp300_ledLength;\r\n\r\n\tfor (let i = 0; i < csp300_ledLength; i++) {\r\n\t\tconst rpmThreshold = redlineRPM * (startThreshold + i * rpmStepSize);\r\n\t\t\r\n\t\tcsp300_RpmsGrid[i] = (currentRPM >= rpmThreshold)\r\n\t\t\t? RedlineReached\r\n\t\t\t\t? redlineLedColours\r\n\t\t\t\t: rpmsLedColours\r\n\t\t\t: null;\r\n\t}\r\n}\r\n\r\n// Meet in the Middle\r\nelse if ($prop('ConspitLEDs.GenericRpmsStyle') == 2) {\r\n\r\n\tconst rpmStepSize = (1 - startThreshold) / halfLength;\r\n\r\n\tfor (let i = 0; i < halfLength; i++) {\r\n\t\tconst rpmThreshold = redlineRPM * (startThreshold + i * rpmStepSize);\r\n\t\tconst oppositeIndex = csp300_ledLength - 1 - i;\r\n\r\n\t\t// If RPM is below the threshold, break early\r\n\t\tif (currentRPM < rpmThreshold) break;\r\n\r\n\t\tcsp300_RpmsGrid[i] = csp300_RpmsGrid[oppositeIndex] = (RedlineReached\r\n\t\t\t? redlineLedColours\r\n\t\t\t: rpmsLedColours);\r\n\t}\r\n\r\n\t// Handle the middle LED if the length is odd\r\n\tif (csp300_ledLength % 2 !== 0) {\r\n\t\tconst middleIndex = Math.floor(csp300_ledLength / 2);\r\n\t\tconst middleThreshold = redlineRPM * (startThreshold + (halfLength - 1) * rpmStepSize);\r\n\r\n\t\tcsp300_RpmsGrid[middleIndex] = currentRPM >= middleThreshold\r\n\t\t\t? RedlineReached\r\n\t\t\t\t? redlineLedColours\r\n\t\t\t\t: rpmsLedColours\r\n\t\t\t: null;\r\n\t}\r\n}\r\n\r\n// F1 style\r\nelse if ($prop('ConspitLEDs.GenericRpmsStyle') == 3) {\r\n\r\n\t//First Segment\r\n\tconst unusedLeds = Math.floor(csp300_ledLength / 3);\r\n\r\n\t//Second Segment\r\n\tconst secondSegmentSize = Math.ceil((csp300_ledLength - unusedLeds) / 2);\r\n\tconst secondSegmentStart = redlineRPM * F1_SECOND_SEGMENT_START;\r\n\tconst secondSegmentEnd = redlineRPM * F1_SECOND_SEGMENT_END;\r\n\tconst rpmStepSize = (secondSegmentEnd - secondSegmentStart) / (secondSegmentSize - 1);\r\n\r\n\t// Third Segment\r\n\tconst thirdSegmentStart = redlineRPM * F1_THIRD_SEGMENT_START;\r\n\r\n\tfor (let i = 0; i < csp300_ledLength; i++) {\r\n\r\n\t\t// First segment LEDs\r\n\t\tif (i < unusedLeds) {\r\n\t\t\tcsp300_RpmsGrid[i] = null;\r\n\t\t}\r\n\r\n\t\t// Second segment LEDs\r\n\t\telse if (i < unusedLeds + secondSegmentSize) {\r\n\t\t\tconst secondSegmentIndex = i - unusedLeds;\r\n\t\t\tconst rpmThreshold = secondSegmentStart + secondSegmentIndex * rpmStepSize;\r\n\r\n\t\t\tcsp300_RpmsGrid[i] = currentRPM >= rpmThreshold\r\n\t\t\t\t? rpmsLedColours\r\n\t\t\t\t: null;\r\n\t\t}\r\n\r\n\t\t// Third segment LEDs\r\n\t\telse {\r\n\t\t\tcsp300_RpmsGrid[i] = currentRPM >= thirdSegmentStart\r\n\t\t\t\t? redlineLedColours\r\n\t\t\t\t: null;\r\n\t\t}\r\n\t}\r\n};\r\n\r\nreturn RedlineReached && $prop('ConspitLEDs.GenericRpmsStyle') != 3\r\n\t? ($prop('ConspitLEDs.GenericRpmsRedlineBehaviour') == 2 ||\r\n\t   $prop('ConspitLEDs.GenericRpmsRedlineBehaviour') == null)\r\n\t\t? Math.floor(Date.now() / 125) % 2\r\n\t\t\t? csp300_RpmsGrid\r\n\t\t\t: Array(csp300_ledLength).fill(null)\r\n\t\t: csp300_RpmsGrid\r\n\t: csp300_RpmsGrid;",
                                        "PreExpression": "const csp300_ledLength = 12;"
                                      },
                                      "LedCount": 12,
                                      "ContainerType": "ScriptedContent",
                                      "Description": "Generic Rpms TDM"
                                    },
                                    {
                                      "LedContainers": [
                                        {
                                          "TriggerFormula": {
                                            "JSExt": 0,
                                            "Interpreter": 1,
                                            "Expression": "return $prop('ConspitLEDs.GenericRpmsStyle') == 3;"
                                          },
                                          "LedContainers": [
                                            {
                                              "TriggerFormula": {
                                                "JSExt": 4,
                                                "Interpreter": 1,
                                                "Expression": "if (isnull($prop('ConspitLEDs.DRSDetectionPoint'))) {\r\n\treturn csp300_DRS_detection();\r\n}\r\nreturn false;"
                                              },
                                              "LedContainers": [
                                                {
                                                  "IdleBlinkingColor": "Transparent",
                                                  "EnableIdleBlinking": false,
                                                  "LedCount": 1,
                                                  "Color": "Yellow",
                                                  "BlinkingColor": "Transparent",
