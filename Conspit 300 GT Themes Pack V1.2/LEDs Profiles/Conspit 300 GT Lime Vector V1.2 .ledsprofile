0_Toggle_Blink, csp300_Toggle_BlinkFrequency) {\n\tconst effectName = WheelEffectName(csp300_WheelsButtonEffect);\n\tconst executor = new EffectExecutor(true, csp300_ledLength, csp300_buttonState, null, csp300_Press_Delay, null, csp300_Toggle_Blink, csp300_Toggle_BlinkFrequency);\n\treturn executor.execute(effectName);\n};\n\n\nfunction csp300_WheelRotaryEffectList(isTDM, csp300_ledLength, csp300_allButtonStates, csp300_WheelsRotaryEffect) {\n\n\tlet globalColours = {};\n\tif (!isTDM) {\n\t\tUpdateGlobalColours.update();\n\t\tglobalColours = UpdateGlobalColours;\n\t}\n\tconst TDM_colour = csp300_TDM_Colour_Hex('alt');\n\tconst csp300_TCcolour = !isTDM ? globalColours.csp300_TCcolour_Hex : TDM_colour;\n\tconst csp300_ABScolour = !isTDM ? globalColours.csp300_ABScolour_Hex : TDM_colour;\n\tconst csp300_MAPcolour = !isTDM ? globalColours.csp300_MAPcolour_Hex : TDM_colour;\n\tconst csp300_BBcolour = !isTDM ? globalColours.csp300_BBcolour_Hex : TDM_colour;\n \n\tswitch (csp300_WheelsRotaryEffect) {\n\t\t// No effect (Buttonstate)\n\t\t//case null:\n\t\t//case 0:\n\t\t//\tif (($prop('ConspitLEDs.WheelInputEffects') ?? true) && csp300_allButtonStates.some((state) => csp300_changed_maxTime(300, state))) {\n\t\t//\t\treturn Array(csp300_ledLength).fill((Date.now() / 100 | 0) % 2 ? '#FF000000' : null);\n\t\t//\t}\n\t\t//\treturn [null];\n\t\t// TC (Static)\n\t\tcase 1:\n\t\t\treturn Array(csp300_ledLength).fill(csp300_TCcolour);\n\t\t// TC (Blinking when Active)\n\t\tcase 2:\n\t\t\treturn ($prop('TCActive') == 1 || $prop('DataCorePlugin.GameData.NewData.TCActive') == 1)\n\t\t\t\t? Array(csp300_ledLength).fill('#FF000000')\n\t\t\t\t: Array(csp300_ledLength).fill(csp300_TCcolour);\n\t\t// ABS (Static)\n\t\tcase 3:\n\t\t\treturn Array(csp300_ledLength).fill(csp300_ABScolour);\n\t\t// ABS (Blinking when Active)\n\t\tcase 4:\n\t\t\treturn csp300_ABSActive()\n\t\t\t\t? Array(csp300_ledLength).fill('#FF000000')\n\t\t\t\t: Array(csp300_ledLength).fill(csp300_ABScolour);\n\t\t// Engine Map\n\t\tcase 5:\n\t\t\treturn Array(csp300_ledLength).fill(csp300_MAPcolour);\n\t\t// Brake Balance\n\t\tcase 6:\n\t\t\treturn Array(csp300_ledLength).fill(csp300_BBcolour);\n\t\t//ERS Mode\n\t\tcase 7:\n\t\t\treturn Array(csp300_ledLength).fill(csp300_ERS_Colour_Hex());\n\t\t// TC Cut (Static)\n\t\tcase 8:\n\t\t\treturn Array(csp300_ledLength).fill(csp300_TCcolour);\n\t\t// TC Cut (Blinking when Active)\n\t\tcase 9:\n\t\t\treturn ($prop('TCActive') == 1 || $prop('DataCorePlugin.GameData.NewData.TCActive') == 1)\n\t\t\t\t? Array(csp300_ledLength).fill('#FF000000')\n\t\t\t\t: Array(csp300_ledLength).fill(csp300_TCcolour);\n\t\tdefault: return [null];\n\t}\n};\n\n\nfunction csp300_WheelRotaryEffectprocedure(csp300_ledLength, csp300_allButtonStates, csp300_WheelsRotaryEffect) {\n    //isTDM false\n    return csp300_WheelRotaryEffectList(false, csp300_ledLength, csp300_allButtonStates, csp300_WheelsRotaryEffect);\n};\n\nfunction csp300_WheelRotaryEffectprocedureTDM(csp300_ledLength, csp300_allButtonStates, csp300_WheelsRotaryEffect) {\n    //isTDM true\n    return csp300_WheelRotaryEffectList(true, csp300_ledLength, csp300_allButtonStates, csp300_WheelsRotaryEffect);\n};\n\n\n// Conspit 300 GT V1 idle and colour authority\nvar CP300V1_THEME_NAME = 'Lime Vector';\nvar CP300V1_BTN1 = '#FF00D7C8';\nvar CP300V1_BTN2 = '#FF66FF00';\nvar CP300V1_BTN3 = '#FF00D7C8';\nvar CP300V1_BTN4 = '#FF66FF00';\nvar CP300V1_ACCENT = '#FF00D7C8';\nvar CP300V1_RING1 = '#FF66FF00';\nvar CP300V1_RING2 = '#FF00D7C8';\nvar CP300V1_RING3 = '#FF66FF00';\nvar CP300V1_PIT_A = '#FF00EFFF';\nvar CP300V1_PIT_B = '#FFFF6A00';\n\nfunction cp300v1GameActive() {\n    try {\n        return Number($prop('DataCorePlugin.GameRunning')) === 1 && Number($prop('Rpms') || 0) > 100;\n    } catch(e) {\n        return false;\n    }\n}\n\nfunction cp300v1DimHex(col, f) {\n    try { return cpDim(col, f); } catch(e) { return col; }\n}\n\nfunction cp300v1BlendHex(a,b,t) {\n    try { return cpBlend(a,b,t); } catch(e) { return b || a; }\n}\n\nfunction cp300v1IdleTop() {\n    if (cp300v1GameActive()) return [null];\n\n    var leds = [];\n    var t = (Date.now() % 2600) / 2600;\n    for (var i = 0; i < 12; i++) {\n        var wave = Math.sin((t * Math.PI * 2) - Math.abs(i - 5.5) * 0.32);\n        var glow = Math.max(0.06, 0.16 + Math.max(0, wave) * 0.54);\n        var base = i < 3 || i > 8 ? CP300V1_RING1 : (i < 5 || i > 6 ? CP300V1_RING3 : CP300V1_RING2);\n        leds.push(cp300v1DimHex(base, glow));\n    }\n    return leds;\n}\n\nfunction cp300v1IdleWheel() {\n    if (cp300v1GameActive()) return [null];\n\n    var leds = new Array(44).fill(null);\n    var t = Date.now() / 900;\n\n    var buttonMap = [\n        [0, CP300V1_BTN1], [2, CP300V1_BTN2], [3, CP300V1_BTN3], [4, CP300V1_BTN4],\n        [5, CP300V1_BTN1], [10, CP300V1_BTN2], [9, CP300V1_BTN3], [8, CP300V1_BTN4]\n    ];\n\n    for (var b = 0; b < buttonMap.length; b++) {\n        var strength = 0.56 + 0.22 * Math.sin(t + b * 0.52);\n        leds[buttonMap[b][0]] = cp300v1DimHex(buttonMap[b][1], strength);\n    }\n\n    var rings = [\n        [9, CP300V1_RING1],\n        [21, CP300V1_RING2],\n        [33, CP300V1_RING3]\n    ];\n\n    for (var r = 0; r < rings.length; r++) {\n        var start = rings[r][0];\n        var colour = rings[r][1];\n        var cursor = Math.floor((Date.now() / 120 + r * 4) % 12);\n        for (var j = 0; j < 12; j++) {\n            var d = Math.min(Math.abs(j - cursor), 12 - Math.abs(j - cursor));\n            var strength = d === 0 ? 0.95 : (d === 1 ? 0.55 : 0.18);\n            leds[start + j] = cp300v1DimHex(colour, strength);\n        }\n    }\n\n    return leds;\n}\n\n// Override colour authority while keeping the original 300 GT function structure.\nGlobalColours.prototype.update = function() {\n    this.csp300_TCcolour_Hex = '#FF006CFF';\n    this.csp300_ABScolour_Hex = '#FFFFFF00';\n    this.csp300_BBcolour_Hex = '#FFFF2020';\n    this.csp300_MAPcolour_Hex = '#FF00FF00';\n    this.csp300_IgnitionOn_Hex = '#FFFFFFFF';\n    this.csp300_EngineOff_Hex = '#FFFF0018';\n    this.csp300_EngineOn_Hex = '#FF00FF00';\n    this.csp300_EngineStart_Hex = '#FFFF0018';\n    this.csp300_Clutch_Hex = '#FFFFFFFF';\n    this.csp300_Brake_Hex = '#FFFF2020';\n    this.csp300_Flasher_Hex = '#FFFFFFFF';\n    this.csp300_Spotter_Hex = '#FFFFFFFF';\n    this.csp300_PitLimiter_Hex1 = CP300V1_PIT_A;\n    this.csp300_PitLimiter_Hex2 = CP300V1_PIT_B;\n    this.csp300_Lowfuel_Hex = '#FFFF2020';\n    this.csp300_LiftAndCoast_Hex = '#FFFFFFFF';\n};\n\nfunction csp300_FC_State(csp300_DeviceType) {\n    return true;\n}\n\nfunction csp300_TDM_State(csp300_DeviceType) {\n    return false;\n}\n\nfunction csp300_TDM_Colour_Hex(TDMvariant) {\n    return TDMvariant === 'main' ? CP300V3_BTN1 : CP300V3_ACCENT;\n}\n\n\n\n\n// Conspit 300 GT V1 lifecycle, pit and control layer.\n// Conspit 300 GT V1 theme and physical colour authority.\nvar CP300V3_THEME_NAME = 'Lime Vector';\nvar CP300V3_BTN1 = '#FF00D7C8';\nvar CP300V3_BTN2 = '#FF66FF00';\nvar CP300V3_BTN3 = '#FF00D7C8';\nvar CP300V3_BTN4 = '#FF66FF00';\nvar CP300V3_RING1 = '#FF66FF00';\nvar CP300V3_RING2 = '#FF00D7C8';\nvar CP300V3_RING3 = '#FF66FF00';\nvar CP300V3_ACCENT = '#FF00D7C8';\nvar CP300V3_PIT_A = '#FF00EFFF';\nvar CP300V3_PIT_B = '#FFFF6A00';\nvar CP300V3_REDLINE = '#FFFF0000';\n\nfunction cp300v3Num(v, fallback) { var n = Number(v); return isNaN(n) ? (fallback || 0) : n; }\nfunction cp300v3Clamp(v, a, b) { return Math.max(a, Math.min(b, v)); }\nfunction cp300v3Ease(t) { t = cp300v3Clamp(t, 0, 1); return t * t * (3 - 2 * t); }\nfunction cp300v3Empty(n) { return Array(n).fill(null); }\nfunction cp300v3Black() { return '#FF000000'; }\nfunction cp300v3Transparent() { return '#00000000'; }\nfunction cp300v3Dim(hex, factor) {\n    if (!hex || typeof hex !== 'string') return hex;\n    factor = cp300v3Clamp(factor, 0, 1);\n    try {\n        var raw = hex.charAt(0) === '#' ? hex.substring(1) : hex;\n        if (raw.length === 6) raw = 'FF' + raw;\n        var a = parseInt(raw.substring(0,2), 16);\n        var r = Math.round(parseInt(raw.substring(2,4), 16) * factor);\n        var g = Math.round(parseInt(raw.substring(4,6), 16) * factor);\n        var b = Math.round(parseInt(raw.substring(6,8), 16) * factor);\n        function h(x) { return Math.max(0, Math.min(255, x)).toString(16).padStart(2, '0'); }\n        return ('#' + h(a) + h(r) + h(g) + h(b)).toUpperCase();\n    } catch(e) { return hex; }\n}\nfunction cp300v3Blend(a, b, t) {\n    if (!a) return b;\n    if (!b) return a;\n    t = cp300v3Clamp(t, 0, 1);\n    try {\n        var ra = (a.charAt(0) === '#' ? a.substring(1) : a); if (ra.length === 6) ra = 'FF' + ra;\n        var rb = (b.charAt(0) === '#' ? b.substring(1) : b); if (rb.length === 6) rb = 'FF' + rb;\n        function part(s, i) { return parseInt(s.substring(i, i+2), 16); }\n        function h(x) { return Math.round(cp300v3Clamp(x,0,255)).toString(16).padStart(2,'0'); }\n        return ('#' + h(part(ra,0)+(part(rb,0)-part(ra,0))*t) + h(part(ra,2)+(part(rb,2)-part(ra,2))*t) + h(part(ra,4)+(part(rb,4)-part(ra,4))*t) + h(part(ra,6)+(part(rb,6)-part(ra,6))*t)).toUpperCase();\n    } catch(e) { return b; }\n}\nfunction cp300v3ButtonMap() {\n    // True 300 GT symmetry: left 0/2/3/4 mirrored to right 5/6/7/8.\n    return [\n        {led:0, inputs:[0], colour:CP300V3_BTN1, pair:0, side:'L'},\n        {led:2, inputs:[1], colour:CP300V3_BTN2, pair:1, side:'L'},\n        {led:3, inputs:[2], colour:CP300V3_BTN3, pair:2, side:'L'},\n        {led:4, inputs:[3], colour:CP300V3_BTN4, pair:3, side:'L'},\n        {led:5, inputs:[4], colour:CP300V3_BTN1, pair:0, side:'R'},\n        {led:6, inputs:[5], colour:CP300V3_BTN2, pair:1, side:'R'},\n        {led:7, inputs:[6], colour:CP300V3_BTN3, pair:2, side:'R'},\n        {led:8, inputs:[7], colour:CP300V3_BTN4, pair:3, side:'R'}\n    ];\n}\nfunction cp300v3Rings() { return [{start:9, colour:CP300V3_RING1}, {start:21, colour:CP300V3_RING2}, {start:33, colour:CP300V3_RING3}]; }\nfunction cp300v3GameRunning() { return cp300v3Num($prop('DataCorePlugin.GameRunning'), 0) === 1 || cp300v3Num($prop('GameRunning'), 0) === 1; }\nfunction cp300v3IgnitionOn() { return cp300v3Num($prop('EngineIgnitionOn'), 0) === 1 || cp300v3Num($prop('EngineIgnition'), 0) === 1; }\nfunction cp300v3EngineStarted() { return cp300v3Num($prop('EngineStarted'), 0) === 1 || cp300v3Num($prop('CarStarted'), 0) === 1 || cp300v3Num($prop('EngineRunning'), 0) === 1; }\nfunction cp300v3Rpm() { return cp300v3Num($prop('Rpms'), cp300v3Num($prop('RPMS'), 0)); }\nfunction cp300v3Speed() { return Math.abs(cp300v3Num($prop('SpeedKmh'), 0)); }\nfunction cp300v3InPitLane() { return cp300v3Num($prop('IsInPitLane'),0) === 1 || cp300v3Num($prop('IsInPit'),0) === 1; }\nfunction cp300v3PitLimiter() { return cp300v3Num($prop('PitLimiterOn'),0) === 1; }\nfunction cp300v3DrivingActive() {\n    if (!cp300v3GameRunning()) return false;\n    if (cp300v3EngineStarted()) return true;\n    if (cp300v3Rpm() > 450) return true;\n    if (cp300v3Speed() > 2) return true;\n    if (cp300v3InPitLane() || cp300v3PitLimiter()) return true;\n    return false;\n}\nfunction cp300v3IgnitionOffActive() { return cp300v3GameRunning() && !cp300v3IgnitionOn() && !cp300v3EngineStarted() && cp300v3Rpm() < 450; }\nfunction cp300v3FlagColour() {\n    if (cp300v3Num($prop('RedFlag'),0) === 1) return '#FFFF0000';\n    if (cp300v3Num($prop('YellowFlag'),0) === 1) return '#FFFFFF00';\n    if (cp300v3Num($prop('BlueFlag'),0) === 1) return '#FF006CFF';\n    if (cp300v3Num($prop('WhiteFlag'),0) === 1) return '#FFFFFFFF';\n    if (cp300v3Num($prop('BlackFlag'),0) === 1) return '#FF050505';\n    return null;\n}\nfunction cp300v3RedlineState() {\n    try { if (typeof csp300_RedlineState === 'function' && csp300_RedlineState()) return true; } catch(e) {}\n    if (cp300v3Num($prop('RPMRedlineReached'),0) === 1) return true;\n    var rpm = cp300v3Rpm();\n    var red = cp300v3Num($prop('CarSettings_RedLineRPM'), 0);\n    if (red <= 0) red = cp300v3Num($prop('CarSettings_CurrentGearRedLineRPM'), 0);\n    if (red <= 0) red = cp300v3Num($prop('MaxRpm'), cp300v3Num($prop('RPMSMax'), 0));\n    return red > 1000 && rpm >= red * 0.985;\n}\nfunction cp300v3ReadButton(inputs) {\n    for (var i = 0; i < inputs.length; i++) {\n        try { if (getcontrollerbuttonstate('0x3514,0x000E', inputs[i])) return true; } catch(e) {}\n    }\n    return false;\n}\nfunction cp300v3ApplyButtons(leds, strength, overrideColour) {\n    var buttons = cp300v3ButtonMap();\n    for (var i = 0; i < buttons.length; i++) leds[buttons[i].led] = cp300v3Dim(overrideColour || buttons[i].colour, strength);\n}\nfunction cp300v3ThemeWheelStatic(strength) {\n    var leds = cp300v3Empty(45);\n    strength = strength === undefined ? 0.88 : strength;\n    cp300v3ApplyButtons(leds, strength, null);\n    var rings = cp300v3Rings();\n    for (var r = 0; r < rings.length; r++) {\n        for (var j = 0; j < 12; j++) leds[rings[r].start + j] = cp300v3Dim(rings[r].colour, strength * 0.76);\n    }\n    return leds;\n}\nfunction cp300v3TopThemeStatic(strength) {\n    var leds = cp300v3Empty(12); strength = strength === undefined ? 0.72 : strength;\n    for (var i = 0; i < 12; i++) {\n        var col = (i < 2 || i > 9) ? CP300V3_BTN1 : ((i < 4 || i > 7) ? CP300V3_BTN2 : CP300V3_BTN3);\n        leds[i] = cp300v3Dim(col, strength);\n    }\n    return leds;\n}\nfunction cp300v3IdlePhase(cycleMs) { return (Date.now() % cycleMs) / cycleMs; }\nfunction cp300v3IdleTop() {\n    if (cp300v3GameRunning()) return cp300v3Empty(12);\n    var leds = cp300v3Empty(12);\n    var p = cp300v3IdlePhase(6800);\n    var breath = 0.20 + 0.62 * (0.5 + 0.5 * Math.sin(2 * Math.PI * p - Math.PI / 2));\n    var head = Math.floor(p * 24);\n    for (var i = 0; i < 12; i++) {\n        var mirrorDist = Math.min(Math.abs(i - head), Math.abs(i - (23 - head)), 12 - Math.abs(i - (head % 12)));\n        var col = (i < 2 || i > 9) ? CP300V3_BTN1 : ((i < 4 || i > 7) ? CP300V3_BTN2 : CP300V3_BTN3);\n        var tick = mirrorDist <= 0 ? 0.22 : (mirrorDist === 1 ? 0.10 : 0);\n        leds[i] = cp300v3Dim(col, cp300v3Clamp(breath + tick, 0, 0.92));\n    }\n    return leds;\n}\nfunction cp300v3IdleWheel() {\n    if (cp300v3GameRunning()) return cp300v3Empty(45);\n    var leds = cp300v3Empty(45);\n    var p = cp300v3IdlePhase(7200);\n    var wave = 0.18 + 0.62 * (0.5 + 0.5 * Math.sin(2 * Math.PI * p - Math.PI / 2));\n    var buttons = cp300v3ButtonMap();\n    // Mirrored pair breathing, centre-out then outside-in. No side desync.\n    var pairOrder = [3,2,1,0,0,1,2,3];\n    for (var b = 0; b < buttons.length; b++) {\n        var delay = buttons[b].pair * 0.09;\n        var local = 0.22 + 0.62 * (0.5 + 0.5 * Math.sin(2 * Math.PI * ((p - delay + 1) % 1) - Math.PI / 2));\n        leds[buttons[b].led] = cp300v3Dim(buttons[b].colour, cp300v3Clamp(local, 0.08, 0.86));\n    }\n    // Professional standby rings: low halo plus a calm index glow, not a carnival chase.\n    var rings = cp300v3Rings();\n    var ringBreath = 0.16 + 0.38 * (0.5 + 0.5 * Math.sin(2 * Math.PI * p - Math.PI / 2));\n    for (var r = 0; r < rings.length; r++) {\n        for (var j = 0; j < 12; j++) {\n            var indexGlow = (j === 0 || j === 11 || j === 1) ? 0.18 : 0;\n            var lowerCalm = (j === 5 || j === 6 || j === 7) ? -0.06 : 0;\n            leds[rings[r].start + j] = cp300v3Dim(rings[r].colour, cp300v3Clamp(ringBreath + indexGlow + lowerCalm, 0.08, 0.66));\n        }\n    }\n    return leds;\n}\nfunction cp300v3IgnitionOnWheel() {\n    var leds = cp300v3Empty(45);\n    if (!cp300v3GameRunning() || !cp300v3IgnitionOn() || cp300v3EngineStarted() || cp300v3Rpm() > 650) return leds;\n    var p = (Date.now() % 2600) / 2600;\n    var pulse = 0.28 + 0.48 * (0.5 + 0.5 * Math.sin(2 * Math.PI * p - Math.PI / 2));\n    cp300v3ApplyButtons(leds, pulse, null);\n    var rings = cp300v3Rings();\n    var fill = Math.floor(cp300v3Ease(p) * 12);\n    for (var r = 0; r <