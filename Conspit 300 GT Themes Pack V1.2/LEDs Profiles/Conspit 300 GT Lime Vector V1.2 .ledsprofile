                                              ],
                                              "ContainerType": "Groups.CustomConditionalGroup",
                                              "Description": "LMP2 ELMS"
                                            },
                                            {
                                              "TriggerFormula": {
                                                "JSExt": 0,
                                                "Interpreter": 1,
                                                "Expression": "return $prop('CarClass') == 'LMP3';"
                                              },
                                              "LedContainers": [
                                                {
                                                  "TriggerFormula": {
                                                    "JSExt": 0,
                                                    "Interpreter": 1,
                                                    "Expression": "const Carid = [\r\n//Duqueine D09 P3\r\n\"WTM by Rinaldi Racing 2025\", \"Duqueine D09 P3 Custom Team 2025\",\r\n//Ligier JS P325\r\n\"Team Virage\", \"EuroInternational\", \"RLR MSport\", \"CLX Motorsport\", \"Racing Spirit of Léman\", \"Ultimate\", \"M Racing\", \"Inter Europol Competition\", \"Ligier JS P325 Custom Team 2025\",\r\n//Ginetta G61-LT-P325 EVO\r\n\"DKR Engineering\", \"Ginetta G61-LT-P3 Custom Team\"];\r\nreturn Carid.includes($prop('CarModel'));"
                                                  },
                                                  "LedContainers": [
                                                    {
                                                      "ContentFormula": {
                                                        "JSExt": 4,
                                                        "Interpreter": 1,
                                                        "Expression": "const rpmsLedColours = csp300_TDM_Colour_Hex('main');\r\nconst redlineLedColours = csp300_TDM_Colour_Hex('main');\r\n\r\nconst currentRPM = $prop('Rpms');\r\nconst RedlineReached = csp300_RedlineState();\r\nconst csp300_RpmsGrid = Array(csp300_ledLength);\r\n\r\nfor (let i = 0; i < csp300_ledLength; i++) {\r\n\tconst RedlineColourOveride = RedlineColourOverideIndice.includes(i);\r\n\t\r\n\tif (csp300_RPMValues[i] == null) {\r\n        csp300_RpmsGrid[i] = null;\r\n        continue;\r\n    }\r\n\tcsp300_RpmsGrid[i] = currentRPM >= csp300_RPMValues[i]\r\n\t\t? (RedlineReached || RedlineColourOveride\r\n\t\t\t? redlineLedColours\r\n\t\t\t: rpmsLedColours)\r\n\t\t: null;\r\n}\r\n\r\nreturn RedlineReached && RedlineFlash\r\n\t? Math.floor(Date.now() / RedlineFlashFrequency) % 2\r\n\t\t? csp300_RpmsGrid\r\n\t\t: Array(csp300_ledLength).fill(null)\r\n\t: csp300_RpmsGrid;",
                                                        "PreExpression": "const csp300_ledLength = 10;\r\nconst csp300_RPMValues = [6060, 6060, 6180, 6300, 6420, 6420, 6300, 6180, 6060, 6060];\r\nconst RedlineFlash = true;\r\nconst RedlineFlashFrequency = 100;\r\nconst RedlineColourOverideIndice = [];"
                                                      },
                                                      "LedCount": 10,
                                                      "StartPosition": 2,
                                                      "ContainerType": "ScriptedContent",
                                                      "Description": "Rpms TDM"
