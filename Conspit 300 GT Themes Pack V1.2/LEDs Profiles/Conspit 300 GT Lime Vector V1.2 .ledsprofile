                                                        "2;6060;#00FF00;0;",
                                                        "1;6180;#FFFF00;0;",
                                                        "1;6300;#FFFF00;0;",
                                                        "2;6420;#0000FF;0;",
                                                        "1;6300;#FFFF00;0;",
                                                        "1;6180;#FFFF00;0;",
                                                        "2;6060;#00FF00;0;"
                                                      ],
                                                      "SegmentsCount": 7,
                                                      "BlinkEnabled": false,
                                                      "RpmMode": 2,
                                                      "RelativeToRedline": false,
                                                      "BlinkOnLastGear": true,
                                                      "StartPosition": 2,
                                                      "ContainerType": "RPMSegments",
                                                      "Description": "Show leds solid effect segments based on car RPMs copy"
                                                    },
                                                    {
                                                      "TriggerFormula": {
                                                        "JSExt": 4,
                                                        "Interpreter": 1,
                                                        "Expression": "return csp300_RedlineState();"
                                                      },
                                                      "LedContainers": [
                                                        {
                                                          "IdleBlinkingColor": "Transparent",
                                                          "EnableIdleBlinking": false,
                                                          "LedCount": 10,
                                                          "Color": "Black",
                                                          "BlinkingColor": "Transparent",
                                                          "BlinkEnabled": true,
                                                          "BlinkDelay": 100,
                                                          "StartPosition": 2,
