                                                        "PreExpression": "const csp300_ledLength = 10;\r\nconst csp300_RPMValues = [6560, 6691, 6822, 6953, 7084, 7216, 7347, 7478, 7609, 7740];\r\nconst RedlineFlash = false;\r\nconst RedlineFlashFrequency = 0;\r\nconst RedlineColourOverideIndice = [8, 9];"
                                                      },
