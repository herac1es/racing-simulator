                  ],
                  "ContainerType": "Groups.CustomConditionalGroup",
                  "Description": "Le Mans Ultimate Car Specific RPMs",
                  "TriggerFormula": {
                    "JSExt": 6,
                    "Interpreter": 1,
                    "Expression": "return !C300_OPTIONS.darkMode;"
                  }
                },
                {
                  "LedContainers": [
                    {
                      "TriggerFormula": {
                        "JSExt": 0,
                        "Interpreter": 1,
                        "Expression": "return $prop('CarClass') == 'Hyper';"
                      },
                      "LedContainers": [
                        {
                          "TriggerFormula": {
                            "JSExt": 0,
                            "Interpreter": 1,
                            "Expression": "const Carid = [\"Alpine Endurance Team 2024\", \"Alpine Endurance Team 2025\", \"Alpine Endurance Team 2026\", \"Alpine Custom Team 2024\", \"Alpine Custom Team 2025\", \"Alpine Custom Team 2026\"];\r\nreturn Carid.includes($prop('CarModel'));"
                          },
                          "LedContainers": [
                            {
                              "ContentFormula": {
                                "JSExt": 6,
                                "Interpreter": 1,
                                "Expression": "const rpmsLedColours = c300_TDM_Colour_Hex('main');\r\nconst redlineLedColours = c300_TDM_Colour_Hex('alt');\r\n\r\nconst currentRPM = $prop('Rpms');\r\nconst RedlineReached = c300_RedlineState();\r\nconst dnr_RpmsGrid = Array(dnr_ledLength);\r\n\r\nfor (let i = 0; i < dnr_ledLength; i++) {\r\n\tconst RedlineColourOveride = RedlineColourOverideIndice.includes(i);\r\n\r\n\tif (dnr_RPMValues[i] == null) {\r\n\t\tdnr_RpmsGrid[i] = null;\r\n\t\tcontinue;\r\n\t}\r\n\tdnr_RpmsGrid[i] = currentRPM >= dnr_RPMValues[i]\r\n\t\t? (RedlineReached || RedlineColourOveride\r\n\t\t\t? redlineLedColours\r\n\t\t\t: rpmsLedColours)\r\n\t\t: null;\r\n}\r\n\r\nreturn RedlineReached && RedlineFlash\r\n\t? Math.floor(Date.now() / RedlineFlashFrequency) % 2\r\n\t\t? dnr_RpmsGrid\r\n\t\t: Array(dnr_ledLength).fill(null)\r\n\t: dnr_RpmsGrid;",
                                "PreExpression": "const dnr_ledLength = 10;\r\nconst dnr_RPMValues = [7100, 7265, 7430, 7595, 7760, 7925, 8090, 8255, 8420, null];\r\nconst RedlineFlash = false;\r\nconst RedlineFlashFrequency = 0;\r\nconst RedlineColourOverideIndice = [5, 6, 7, 8];"
                              },
                              "LedCount": 10,
                              "StartPosition": 2,
                              "ContainerType": "ScriptedContent",
                              "Description": "Rpms TDM"
                            }
                          ],
                          "ContainerType": "Groups.CustomConditionalGroup",
                          "Description": "Alpine"
                        },
                        {
                          "TriggerFormula": {
                            "JSExt": 0,
                            "Interpreter": 1,
                            "Expression": "const Carid = [\"Aston Martin THOR Team 2025\", \"Aston Martin THOR Team 2026\", \"AM Valkyrie Custom Team 2025\", \"AM Valkyrie Custom Team 2026\"];\r\nreturn Carid.includes($prop('CarModel'));"
                          },
                          "LedContainers": [
                            {
                              "ContentFormula": {
                                "JSExt": 6,
                                "Interpreter": 1,
                                "Expression": "const rpmsLedColours = c300_TDM_Colour_Hex('main');\r\nconst redlineLedColours = c300_TDM_Colour_Hex('alt');\r\n\r\nconst currentRPM = $prop('Rpms');\r\nconst RedlineReached = c300_RedlineState();\r\nconst dnr_RpmsGrid = Array(dnr_ledLength);\r\n\r\nfor (let i = 0; i < dnr_ledLength; i++) {\r\n\tconst RedlineColourOveride = RedlineColourOverideIndice.includes(i);\r\n\r\n\tif (dnr_RPMValues[i] == null) {\r\n\t\tdnr_RpmsGrid[i] = null;\r\n\t\tcontinue;\r\n\t}\r\n\tdnr_RpmsGrid[i] = currentRPM >= dnr_RPMValues[i]\r\n\t\t? (RedlineReached || RedlineColourOveride\r\n\t\t\t? redlineLedColours\r\n\t\t\t: rpmsLedColours)\r\n\t\t: null;\r\n}\r\n\r\nreturn RedlineReached && RedlineFlash\r\n\t? Math.floor(Date.now() / RedlineFlashFrequency) % 2\r\n\t\t? dnr_RpmsGrid\r\n\t\t: Array(dnr_ledLength).fill(null)\r\n\t: dnr_RpmsGrid;",
                                "PreExpression": "const dnr_ledLength = 10;\r\nconst dnr_RPMValues = [7440, 7440, 7600, 7600, 7760, 7760, 7920, 7920, 8080, 8080];\r\nconst RedlineFlash = false;\r\nconst RedlineFlashFrequency = 0;\r\nconst RedlineColourOverideIndice = [];"
                              },
                              "LedCount": 10,
                              "StartPosition": 2,
                              "ContainerType": "ScriptedContent",
                              "Description": "Rpms TDM"
                            }
                          ],
                          "ContainerType": "Groups.CustomConditionalGroup",
                          "Description": "Aston Martin Valkyrie LMH"
                        },
                        {
                          "TriggerFormula": {
                            "JSExt": 0,
                            "Interpreter": 1,
                            "Expression": "const Carid = [\"BMW M Team WRT 2024\", \"BMW M Team WRT 2025\", \"BMW M Team WRT 2026\", \"BMWMH Custom Team 2024\", \"BMWMH Custom Team 2025\", \"BMWMH Custom Team 2026\"];\r\nreturn Carid.includes($prop('CarModel'));"
                          },
                          "LedContainers": [
                            {
                              "ContentFormula": {
                                "JSExt": 6,
                                "Interpreter": 1,
                                "Expression": "const rpmsLedColours = c300_TDM_Colour_Hex('main');\r\nconst redlineLedColours = c300_TDM_Colour_Hex('alt');\r\n\r\nconst currentRPM = $prop('Rpms');\r\nconst RedlineReached = c300_RedlineState();\r\nconst dnr_RpmsGrid = Array(dnr_ledLength);\r\n\r\nfor (let i = 0; i < dnr_ledLength; i++) {\r\n\tconst RedlineColourOveride = RedlineColourOverideIndice.includes(i);\r\n\t\r\n\tif (dnr_RPMValues[i] == null) {\r\n\t\tdnr_RpmsGrid[i] = null;\r\n\t\tcontinue;\r\n\t}\r\n\tdnr_RpmsGrid[i] = currentRPM >= dnr_RPMValues[i]\r\n\t\t? (RedlineReached || RedlineColourOveride\r\n\t\t\t? redlineLedColours\r\n\t\t\t: rpmsLedColours)\r\n\t\t: null;\r\n\t// First and last LEDs go black from 7015\r\n\tif ((i == 0 || i == dnr_ledLength - 1) && currentRPM >= 7015 && currentRPM < 7640) {\r\n\t\tdnr_RpmsGrid[i] = '#FF000000';\r\n\t\tcontinue;\r\n\t}\r\n\t// Second and second-to-last LEDs go black from 7220\r\n\tif ((i == 1 || i == dnr_ledLength - 2) && currentRPM >= 7220 && currentRPM < 7640) {\r\n\t\tdnr_RpmsGrid[i] = '#FF000000';\r\n\t\tcontinue;\r\n\t}\r\n}\r\n\r\nreturn RedlineReached && RedlineFlash\r\n\t? Math.floor(Date.now() / RedlineFlashFrequency) % 2\r\n\t\t? dnr_RpmsGrid\r\n\t\t: Array(dnr_ledLength).fill(null)\r\n\t: dnr_RpmsGrid;",
                                "PreExpression": "const dnr_ledLength = 12;\r\nconst dnr_RPMValues = [6605, 6605, 6810, 6810, 7220, 7430, 7430, 7220, 6810, 6810, 6605, 6605];\r\nconst RedlineFlash = false;\r\nconst RedlineFlashFrequency = 0;\r\nconst RedlineColourOverideIndice = [];"
                              },
                              "LedCount": 12,
                              "ContainerType": "ScriptedContent",
                              "Description": "Rpms TDM"
                            }
                          ],
                          "ContainerType": "Groups.CustomConditionalGroup",
                          "Description": "BMW M Hybrid V8"
                        },
                        {
                          "TriggerFormula": {
                            "JSExt": 0,
                            "Interpreter": 1,
                            "Expression": "const Carid = [\"Action Express Racing\", \"Cadillac Racing\", \"Cadillac Racing 2024\", \"Whelen Cadillac Racing 2024\", \"Cadillac Hertz Team Jota 2025\", \"Cadillac WTR 2025\", \"Cadillac Whelen 2025\", \"Cadillac Hertz Team Jota 2026\", \"Cadillac WTR 2026\", \"VLMDH Custom Team 2023\", \"VLMDH Custom Team 2024\", \"VLMDH Custom Team 2025\", \"VLMDH Custom Team 2026\"];\r\nreturn Carid.includes($prop('CarModel'));"
                          },
                          "LedContainers": [
                            {
                              "ContentFormula": {
