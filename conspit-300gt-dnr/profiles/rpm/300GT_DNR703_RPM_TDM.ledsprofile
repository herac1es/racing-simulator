                                    "JSExt": 6,
                                    "Interpreter": 1,
                                    "Expression": "const rpmsLedColours = c300_TDM_Colour_Hex('main');\r\nconst redlineLedColours = c300_TDM_Colour_Hex('alt');\r\n\r\nconst currentRPM = $prop('Rpms');\r\nconst RedlineReached = c300_RedlineState();\r\nconst dnr_RpmsGrid = Array(dnr_ledLength);\r\n\r\nfor (let i = 0; i < dnr_ledLength; i++) {\r\n\tconst RedlineColourOveride = RedlineColourOverideIndice.includes(i);\r\n\r\n\tif (dnr_RPMValues[i] == null) {\r\n\t\tdnr_RpmsGrid[i] = null;\r\n\t\tcontinue;\r\n\t}\r\n\tdnr_RpmsGrid[i] = currentRPM >= dnr_RPMValues[i]\r\n\t\t? (RedlineReached || RedlineColourOveride\r\n\t\t\t? redlineLedColours\r\n\t\t\t: rpmsLedColours)\r\n\t\t: null;\r\n}\r\n\r\nreturn RedlineReached && RedlineFlash\r\n\t? Math.floor(Date.now() / RedlineFlashFrequency) % 2\r\n\t\t? dnr_RpmsGrid\r\n\t\t: Array(dnr_ledLength).fill(null)\r\n\t: dnr_RpmsGrid;",
                                    "PreExpression": "const dnr_ledLength = 10;\r\nconst dnr_RPMValues = [10180, 10560, 10940, 11320, 11700, 11700, 11320, 10940, 10560, 10180];\r\nconst RedlineFlash = false;\r\nconst RedlineFlashFrequency = 0;\r\nconst RedlineColourOverideIndice = [];"
