                              "ContentFormula": {
                                "JSExt": 0,
                                "Interpreter": 1,
                                "Expression": "let ledOutput = [];\r\n\r\nfunction dnr_getRevLightColor(index) {\r\n\tif ($prop('GameRawData.PlayerCarTelemetryData.m_revLightsBitValue') & (1 << index)) {\r\n\r\n\t\tif (index < 5) return '#FF00FF00';\r\n\t\tif (index < 10) return '#FFFF0000';\r\n\t\treturn '#FF0000FF';\r\n\t}\r\n\treturn null;\r\n}\r\n\r\nledOutput = ledIndices.map(dnr_getRevLightColor);\r\nreturn ledOutput;",
                                "PreExpression": "//0-4 Green 5-9 Red 10-14 Blue\r\nconst ledIndices = [1, 2, 3, 4, 6, 7, 8, 9, 11, 12, 13, 14];"
