                                        },
                                        {
                                          "TriggerFormula": {
                                            "JSExt": 3,
                                            "Interpreter": 1,
                                            "Expression": "if(root[\"p2pAvailable\"]==null){\r\n   root[\"p2pAvailable\"] = 0;\r\n}\r\nif(root[\"p2pActive\"]==null){\r\n   root[\"p2pActive\"] = 0;\r\n}\r\n\r\nif($prop('GameRawData.SessionData.WeekendInfo.TrackType')=='road course'){ \r\nif($prop('SessionTypeName')=='Practice' || $prop('SessionTypeName')=='Offline Testing'){\r\n\r\n\tif($prop('DataCorePlugin.GameData.SpeedKmh') > 0.1 && $prop('GameRawData.Telemetry.ThrottleRaw') > 0.8) { \r\n\t\r\n\t\troot[\"p2pAvailable\"] = 1;\r\n\t\t\r\n\t\r\n\t}\t\r\n\r\n\tif(root[\"p2pAvailable\"] == 1 && $prop('GameRawData.Telemetry.dcPushToPass') == 1) {\r\n\t\r\n\t\t\troot[\"p2pActive\"] = 1;\r\n\t\t\r\n\t}\r\n\r\n\tif(root[\"p2pActive\"]==1){\r\n\t\r\n\t\tif($prop('GameRawData.Telemetry.ThrottleRaw') < 0.5 || $prop('Brake') > 10) { \r\n\t\r\n\t\t\troot[\"p2pActive\"] = 0;\r\n\t\t\r\n\t\t}\r\n\t}\r\n}\r\n}\r\n\r\nreturn !root[\"p2pActive\"];"
                                          },
                                          "LedContainers": [
                                            {
                                              "TriggerFormula": {
                                                "Expression": "if([MaxRpm]='5500',0,\r\n\r\nif([Rpms]<'11650',1,0))"
